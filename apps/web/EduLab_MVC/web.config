<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Raise URL and Query String limits because external JWT exceeds IIS default of 2048 -->
      <security>
        <requestFiltering>
          <requestLimits maxUrl="16384" maxQueryString="16384" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
