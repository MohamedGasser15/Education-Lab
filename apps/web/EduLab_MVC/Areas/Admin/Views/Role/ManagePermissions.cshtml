            ViewSiteSettings: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Claim_ViewSiteSettings"].Value))',
            EditSiteSettings: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Claim_EditSiteSettings"].Value))',
            HandleReports: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Claim_HandleReports"].Value))',
            ViewSupport: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Claim_ViewSupport"].Value))',
            HandleSupport: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Claim_HandleSupport"].Value))'
        }
    };

    function showAppAlert(type, title, message) {
        const configs = {
            info: ['bg-blue-500/10 text-blue-500', 'fa-info-circle'],
            warning: ['bg-amber-500/10 text-amber-500', 'fa-exclamation-triangle'],
            error: ['bg-rose-500/10 text-rose-500', 'fa-times-circle'],
            success: ['bg-emerald-500/10 text-emerald-500', 'fa-check-circle']
        };
        const [bg, fa] = configs[type] || configs.info;
        document.getElementById('appAlertIcon').className = 'w-20 h-20 rounded-3xl mx-auto flex items-center justify-center text-3xl mb-6 ' + bg;
        document.getElementById('appAlertIconFa').className = 'fas ' + fa;
        document.getElementById('appAlertTitle').textContent = title;
        document.getElementById('appAlertMessage').textContent = message;
        document.getElementById('appAlertModal').classList.remove('hidden');
    }

    function closeModal(modalId) {
        document.getElementById(modalId)?.classList.add('hidden');
    }

    $(document).ready(function() {
        const roleId = '@ViewBag.RoleId';
        
        function loadPermissions() {
            $.ajax({
                url: `/Admin/Role/GetClaimsJson?id=${roleId}`,
                type: 'GET',
                success: function(data) {
                    if (data) {
                        renderPermissions(data);
                    } else {
                        $('#permissionsContainer').html(`<div class="col-span-full py-20 text-center font-black text-gray-400">${L.noData}</div>`);
                    }
                },
                error: function() {
                    $('#permissionsContainer').html(`<div class="col-span-full py-20 text-center font-black text-rose-500">${L.errorLoading}</div>`);
                }
            });
        }

        function renderPermissions(model) {
            let html = '';
            const groups = [
                { name: 'Dashboard', list: model.dashboardClaimList, title: L.groupTitles.Dashboard, icon: 'fa-tachometer-alt', color: 'primary' },
                { name: 'Categories', list: model.categoryClaimList, title: L.groupTitles.Categories, icon: 'fa-tags', color: 'emerald' },
                { name: 'Courses', list: model.courseClaimList, title: L.groupTitles.Courses, icon: 'fa-graduation-cap', color: 'amber' },
                { name: 'Instructors', list: model.instructorClaimList, title: L.groupTitles.Instructors, icon: 'fa-chalkboard-teacher', color: 'rose' },
                { name: 'Users', list: model.userClaimList, title: L.groupTitles.Users, icon: 'fa-users', color: 'indigo' },
                { name: 'Roles', list: model.roleClaimList, title: L.groupTitles.Roles, icon: 'fa-user-shield', color: 'purple' },
                { name: 'History', list: model.historyClaimList, title: L.groupTitles.History, icon: 'fa-history', color: 'gray' },
                { name: 'Payments', list: model.paymentClaimList, title: L.groupTitles.Payments, icon: 'fa-credit-card', color: 'teal' },
                { name: 'Refunds', list: model.refundClaimList, title: L.groupTitles.Refunds, icon: 'fa-undo-alt', color: 'rose' },
                { name: 'Notifications', list: model.notificationClaimList, title: L.groupTitles.Notifications, icon: 'fa-bell', color: 'orange' },
                { name: 'Students', list: model.studentClaimList, title: L.groupTitles.Students, icon: 'fa-user-graduate', color: 'cyan' },
                { name: 'SiteSettings', list: model.siteSettingClaimList, title: L.groupTitles.SiteSettings, icon: 'fa-cog', color: 'slate' },
                { name: 'Reports', list: model.reportClaimList, title: L.groupTitles.Reports, icon: 'fa-flag', color: 'red' },
                { name: 'Support', list: model.supportClaimList, title: L.groupTitles.Support, icon: 'fa-headset', color: 'blue' }
            ];

            groups.forEach((group, index) => {
                if (!group.list || group.list.length === 0) return;

                const selectedCount = group.list.filter(c => c.isSelected).length;
                const totalCount = group.list.length;
                const percentage = (selectedCount / totalCount) * 100;
                const isAllSelected = selectedCount === totalCount;

                html += `
                    <div class="permission-card glass-card rounded-[2rem] overflow-hidden border border-white/5 hover:border-primary-600/20 transition-all group relative" style="animation-delay: ${index * 50}ms">
                        <div class="group-indicator" style="width: ${percentage}%"></div>
                        
                        <div class="p-6 border-b border-white/5 bg-gray-50/50 dark:bg-white/5 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-primary-600/10 text-primary-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas ${group.icon} text-lg"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-black text-gray-900 dark:text-white">${group.title}</h3>
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest selected-meta">${selectedCount}/${totalCount} ${L.selected}</span>
                                </div>
                            </div>
                            <label class="permission-switch">
                                <input type="checkbox" class="group-all" data-group="${group.name}" ${isAllSelected ? 'checked' : ''}>
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="p-4 max-h-[300px] overflow-y-auto custom-scrollbar space-y-1">
                            ${group.list.map(claim => `
                                <div class="permission-row flex items-center justify-between gap-2 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-white/5 transition-all group/row">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-2 h-2 rounded-full flex-shrink-0 ${claim.isSelected ? 'bg-primary-600' : 'bg-gray-300 dark:bg-white/10'} transition-colors"></div>
                                        <span class="text-xs font-bold text-gray-600 dark:text-gray-400 group-hover/row:text-primary-600 transition-colors truncate">${L.claimLabels[claim.claimType] || claim.label}</span>
                                    </div>
                                    <label class="permission-switch scale-75 origin-right flex-shrink-0">
                                        <input type="checkbox" class="permission-checkbox" 
                                               data-group="${group.name}" data-type="${claim.claimType}" 
                                               ${claim.isSelected ? 'checked' : ''}>
                                        <span class="switch-slider"></span>
                                    </label>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            });

            $('#permissionsContainer').html(html);
            bindEvents();
        }

        function bindEvents() {
            // Group Check All
            $('.group-all').on('change', function() {
                const group = $(this).data('group');
                const isChecked = $(this).is(':checked');
                $(`.permission-checkbox[data-group="${group}"]`).prop('checked', isChecked).trigger('change');
            });

            // Individual Permission
            $('.permission-checkbox').on('change', function() {
                const groupName = $(this).data('group');
                const card = $(this).closest('.permission-card');
                const row = $(this).closest('.permission-row');
                const isChecked = $(this).is(':checked');

                // Update Row Visual
                row.find('.w-2').toggleClass('bg-primary-600', isChecked).toggleClass('bg-gray-300 dark:bg-white/10', !isChecked);

                // Update Card Header Meta
                const total = card.find('.permission-checkbox').length;
                const selected = card.find('.permission-checkbox:checked').length;
                card.find('.selected-meta').text(`${selected}/${total} ${L.selected}`);
                card.find('.group-indicator').css('width', `${(selected/total) * 100}%`);
                
                // Update Group Switch
                card.find('.group-all').prop('checked', selected === total);
            });

            // Global Actions
            $('#check-all-global').click(() => {
                $('.permission-checkbox, .group-all').prop('checked', true).trigger('change');
            });

            $('#uncheck-all-global').click(() => {
                $('.permission-checkbox, .group-all').prop('checked', false).trigger('change');
            });

            // Search
            $('#search-permissions').on('input', function() {
                const term = $(this).val().toLowerCase();
                $('.permission-card').each(function() {
                    let hasMatch = false;
                    const card = $(this);
                    card.find('.permission-row').each(function() {
                        const label = $(this).find('span').text().toLowerCase();
                        if (label.includes(term)) {
                            $(this).show();
                            hasMatch = true;
                        } else {
                            $(this).hide();
                        }
                    });
                    
                    if (card.find('h3').text().toLowerCase().includes(term) || hasMatch) {
                        card.show();
                    } else {
                        card.hide();
                    }
                });
            });
        }

        $('#savePermissions').click(function() {
            const model = {
                roleId: roleId,
                dashboardClaimList: [],
                categoryClaimList: [],
                courseClaimList: [],
                instructorClaimList: [],
                userClaimList: [],
                roleClaimList: [],
                historyClaimList: [],
                paymentClaimList: [],
                refundClaimList: [],
                notificationClaimList: [],
                studentClaimList: [],
                siteSettingClaimList: [],
                supportClaimList: []
            };

            const map = {
                'Dashboard': model.dashboardClaimList,
                'Categories': model.categoryClaimList,
                'Courses': model.courseClaimList,
                'Instructors': model.instructorClaimList,
                'Users': model.userClaimList,
                'Roles': model.roleClaimList,
                'History': model.historyClaimList,
                'Payments': model.paymentClaimList,
                'Refunds': model.refundClaimList,
                'Notifications': model.notificationClaimList,
                'Students': model.studentClaimList,
                'SiteSettings': model.siteSettingClaimList,
                'Support': model.supportClaimList
            };

            $('.permission-checkbox').each(function() {
                const group = $(this).data('group');
                const type = $(this).data('type');
                const isSelected = $(this).is(':checked');
                const label = $(this).closest('.permission-row').find('span').text();

                if (map[group]) {
                    map[group].push({
                        claimType: type,
                        label: label,
                        isSelected: isSelected
                    });
                }
            });

            const btn = $(this);
            btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin ms-2"></i> ${L.saving}`);

            $.ajax({
                url: '/Admin/Role/UpdateClaims',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function(res) {
                    // Check for success in both camelCase and PascalCase
                    const isSuccess = res.success || res.Success || res === true;
                    
                    if (isSuccess) {
                        window.location.href = '/Admin/Role/Index';
                    } else {
                        const errorMsg = res.message || res.Message || (res.errors ? res.errors[0] : L.saveFailed);
                        if (typeof Swal !== 'undefined') {
                            showAppAlert('error', L.error, errorMsg);
                        } else {
                            alert(errorMsg);
                        }
                        btn.prop('disabled', false).html(`<i class="fas fa-save ms-2"></i> ${L.saveChanges}`);
                    }
                },
                error: function(xhr) {
                    let errorMsg = L.serverError;
                    if (xhr.responseJSON && (xhr.responseJSON.errors || xhr.responseJSON.Errors)) {
                        const errors = xhr.responseJSON.errors || xhr.responseJSON.Errors;
                        errorMsg = errors[0];
                    }
                    
                    if (typeof Swal !== 'undefined') {
                        showAppAlert('error', L.error, errorMsg);
                    } else {
                        alert(errorMsg);
                    }
                    btn.prop('disabled', false).html(`<i class="fas fa-save ms-2"></i> ${L.saveChanges}`);
                }
            });
        });

        loadPermissions();
    });

    document.addEventListener('click', function (event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.classList.add('hidden');
        }
    });
</script>
