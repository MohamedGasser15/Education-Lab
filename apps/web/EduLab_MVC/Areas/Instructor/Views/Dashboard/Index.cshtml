@using System.Globalization
@using EduLab_MVC.Common
@model EduLab_MVC.Models.DTOs.Dashboard.InstructorDashboardDto
@{
    ViewData["Title"] = Localizer["InstructorDashboard"].Value;
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    .chart-container {
        position: relative;
        height: 200px;
        width: 100%;
    }

    .chart-container-lg {
        position: relative;
        height: 220px;
        width: 100%;
    }
</style>

<!-- Premium Dashboard Container -->
<div class="space-y-8 animate-in fade-in duration-1000">
    
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-2">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">@Localizer["OverviewLabel"] <i class="fas fa-chart-line text-primary-600/50 ms-2"></i></h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1 font-medium">@Localizer["DashboardSubtitle"]</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Instructor/Course/Create" class="flex items-center gap-2 px-5 py-3 rounded-2xl bg-primary-600 text-white font-bold text-sm shadow-lg shadow-primary-600/30 hover:bg-primary-700 hover:scale-105 transition-all">
                <i class="fas fa-plus"></i>
                <span>@Localizer["AddNewCourse"]</span>
            </a>
        </div>
    </div>

    <!-- Statistics Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 md:gap-6 mb-8">
        <div class="glass-card p-4 md:p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all duration-500">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary-600/10 rounded-full blur-2xl"></div>
            <div class="flex items-start justify-between relative z-10">
                <div>
                    <p class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-1">@Localizer["CoursesCount"]</p>
                    <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tabular-nums">@Model.CoursesCount</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-primary-600 flex items-center justify-center shadow-lg shadow-primary-600/30 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-book text-white text-xl"></i>
                </div>
            </div>
        </div>

        <div class="glass-card p-4 md:p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all duration-500">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-emerald-600/10 rounded-full blur-2xl"></div>
            <div class="flex items-start justify-between relative z-10">
                <div>
                    <p class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-1">@Localizer["EnrolledStudentsLabel"]</p>
                    <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tabular-nums">@Model.StudentsCount.ToString("N0")</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500 flex items-center justify-center shadow-lg shadow-emerald-500/30 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-users text-white text-xl"></i>
                </div>
            </div>
        </div>

        <div class="glass-card p-4 md:p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all duration-500">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-purple-600/10 rounded-full blur-2xl"></div>
            <div class="flex items-start justify-between relative z-10">
                <div>
                    <p class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-1">@Localizer["TotalEarningsLabel"]</p>
                    <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tabular-nums" dir="ltr">@Model.TotalEarnings.ToString("N0") @Localizer["EGP"]</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-purple-600 flex items-center justify-center shadow-lg shadow-purple-600/30 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-dollar-sign text-white text-xl"></i>
                </div>
            </div>
        </div>

        <div class="glass-card p-4 md:p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all duration-500">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-amber-500/10 rounded-full blur-2xl"></div>
            <div class="flex items-start justify-between relative z-10">
                <div>
                    <p class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-1">@Localizer["CompletionRateLabel"]</p>
                    <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tabular-nums">@Model.CompletionRate.ToString("0.#")%</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-lg shadow-amber-500/30 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-tasks text-white text-xl"></i>
                </div>
            </div>
        </div>

        <div class="glass-card p-4 md:p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all duration-500">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-rose-600/10 rounded-full blur-2xl"></div>
            <div class="flex items-start justify-between relative z-10">
                <div>
                    <p class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-1">@Localizer["AverageRatingLabel"]</p>
                    <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tabular-nums">@Model.AverageRating.ToString("0.#")</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-rose-500 flex items-center justify-center shadow-lg shadow-rose-500/30 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-star text-white text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="glass-card rounded-3xl p-6 group hover:scale-[1.01] transition-all duration-500">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Localizer["MonthlyRegistrationsLabel"]</h3>
                <div class="w-10 h-10 rounded-xl bg-primary-600/10 text-primary-600 flex items-center justify-center">
                    <i class="fas fa-chart-area"></i>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="registrationsChart"></canvas>
            </div>
        </div>

        <div class="glass-card rounded-3xl p-6 group hover:scale-[1.01] transition-all duration-500">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Localizer["MonthlyRevenueLabel"]</h3>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                    <i class="fas fa-chart-bar"></i>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <div class="glass-card rounded-3xl p-6 lg:col-span-2 group hover:scale-[1.01] transition-all duration-500">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Localizer["CoursesPerformanceLabel"]</h3>
                <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center">
                    <i class="fas fa-chart-pie"></i>
                </div>
            </div>
            <div class="chart-container-lg">
                <canvas id="coursesPerformanceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Activities & Notifications Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Recent activities card -->
        <div class="glass-card rounded-3xl overflow-hidden shadow-2xl">
            <div class="px-4 md:px-8 py-5 md:py-6 bg-gradient-to-r from-gray-50/50 to-transparent dark:from-white/5 border-b border-gray-100 dark:border-white/5 flex items-center justify-between">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Localizer["RecentActivitiesLabel"]</h3>
                <a href="/Instructor/History/Index" class="text-sm font-bold text-primary-600 hover:text-primary-700 transition-colors">@Localizer["ViewAll"]</a>
            </div>

            <div class="p-4 space-y-2 max-h-96 overflow-y-auto custom-scrollbar">
                @if (!Model.RecentActivities.Any())
                {
                    <p class="text-sm text-gray-400 font-medium py-6 text-center">@Localizer["NoData"]</p>
                }
                @foreach (var activity in Model.RecentActivities)
                {
                    <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5 transition-all group cursor-pointer">
                        @if (activity.Type == "CourseAdded")
                        {
                            <div class="w-12 h-12 rounded-xl bg-primary-600/10 text-primary-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                <i class="fas fa-book"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-900 dark:text-white">@Localizer["NewCourseAddedActivity"]</p>
                                <p class="text-xs text-gray-500 mt-1">@string.Format(Localizer["ActivityNewCourseOnlyDesc"].Value, activity.CourseTitle)</p>
                                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest mt-1">@TimeAgoHelper.GetTimeAgo(activity.CreatedAt)</p>
                            </div>
                        }
                        else if (activity.Type == "Rating")
                        {
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                <i class="fas fa-star"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-900 dark:text-white">@Localizer["ActivityNewRatingTitle"]</p>
                                <p class="text-xs text-gray-500 mt-1">@string.Format(Localizer["ActivityNewRatingDesc"].Value, activity.ActorName, activity.CourseTitle, activity.RatingValue ?? 0)</p>
                                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest mt-1">@TimeAgoHelper.GetTimeAgo(activity.CreatedAt)</p>
                            </div>
                        }
                        else
                        {
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-900 dark:text-white">@Localizer["NewStudentEnrolledActivity"]</p>
                                <p class="text-xs text-gray-500 mt-1">@string.Format(Localizer["ActivityNewEnrollmentDesc"].Value, activity.ActorName, activity.CourseTitle)</p>
                                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest mt-1">@TimeAgoHelper.GetTimeAgo(activity.CreatedAt)</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Notifications card -->
        <div class="glass-card rounded-3xl overflow-hidden shadow-2xl">
            <div class="px-4 md:px-8 py-5 md:py-6 bg-gradient-to-r from-gray-50/50 to-transparent dark:from-white/5 border-b border-gray-100 dark:border-white/5 flex items-center justify-between">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Localizer["NotificationsAlertsLabel"]</h3>
                <a asp-area="Learner" asp-controller="Notifications" asp-action="Index" class="text-sm font-bold text-primary-600 hover:text-primary-700 transition-colors">@Localizer["ViewAll"]</a>
            </div>

            <div class="p-4 space-y-2 max-h-96 overflow-y-auto custom-scrollbar">
                @if (!Model.Notifications.Any())
                {
                    <p class="text-sm text-gray-400 font-medium py-6 text-center">@Localizer["NoNotifications"]</p>
                }
                @foreach (var notification in Model.Notifications)
                {
                    <div class="flex items-start gap-4 p-4 rounded-2xl @(notification.IsRead ? "bg-gray-50/50 dark:bg-white/5" : "bg-blue-50/50 dark:bg-blue-900/10 border-r-4 border-blue-500") hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all cursor-pointer">
                        <div class="w-10 h-10 rounded-full @(notification.IsRead ? "bg-gray-100 text-gray-400 dark:bg-white/10" : "bg-blue-100 text-blue-600 dark:bg-blue-900/30") flex items-center justify-center shrink-0">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900 dark:text-white">@notification.Title</p>
                            <p class="text-xs text-gray-500 mt-1">@notification.Message</p>
                            <p class="text-[10px] text-gray-400 font-medium mt-1">@TimeAgoHelper.GetTimeAgo(notification.CreatedAt)</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            if (document.fonts) {
                try { await document.fonts.load('500 14px Tajawal'); await document.fonts.load('700 14px Tajawal'); } catch(e) {}
            }
            const isDark = document.documentElement.classList.contains('dark');
            Chart.defaults.font.family = 'Tajawal, sans-serif';
            Chart.defaults.color = isDark ? '#94a3b8' : '#64748b';
            const monthNames = [@for (int m = 1; m <= 12; m++) { <text>'@Html.Raw(DateTimeFormatInfo.CurrentInfo.GetMonthName(m))', </text> }];
            const registrationsCountLabel = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["RegistrationsCountLabel"].Value))';
            const monthlyIncomeLabel = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["MonthlyIncomeLabel"].Value))';
            const studentsCountLabel = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StudentsCountChartLabel"].Value))';
            const revenueLabel = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["RevenueChartLabel"].Value))';
            const courseLabels = [@foreach (var c in Model.CoursePerformance) { <text>'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.CourseTitle))', </text> }];
            const courseStudents = [@foreach (var c in Model.CoursePerformance) { <text>@c.Students, </text> }];
            const courseRevenue = [@foreach (var c in Model.CoursePerformance) { <text>@c.Revenue.ToString(CultureInfo.InvariantCulture), </text> }];

            // Line chart of monthly registrations
            const registrationsCtx = document.getElementById('registrationsChart').getContext('2d');
            const registrationsChart = new Chart(registrationsCtx, {
                type: 'line',
                data: {
                    labels: monthNames,
                    datasets: [{
                        label: registrationsCountLabel,
                        data: [@(string.Join(",", Model.MonthlyRegistrations))],
                        backgroundColor: 'rgba(37, 99, 235, 0.1)',
                        borderColor: 'rgba(37, 99, 235, 1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: 'rgba(37, 99, 235, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(37, 99, 235, 1)',
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            titleFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 },
                            bodyFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(156, 163, 175, 0.1)', drawBorder: false }
                        },
                        x: {
                            grid: { display: false, drawBorder: false }
                        }
                    }
                }
            });

            // Bar chart of monthly income
            const revenueCtx = document.getElementById('revenueChart').getContext('2d');
            const revenueChart = new Chart(revenueCtx, {
                type: 'bar',
                data: {
                    labels: monthNames,
                    datasets: [{
                        label: monthlyIncomeLabel,
                        data: [@(string.Join(",", Model.MonthlyRevenue.Select(v => v.ToString(CultureInfo.InvariantCulture))))],
                        backgroundColor: 'rgba(16, 185, 129, 0.8)',
                        borderRadius: 6,
                        borderSkipped: false,
                        barThickness: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            titleFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 },
                            bodyFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(156, 163, 175, 0.1)', drawBorder: false }
                        },
                        x: {
                            grid: { display: false, drawBorder: false }
                        }
                    }
                }
            });

            // Bar chart of course performance
            const coursesPerformanceCtx = document.getElementById('coursesPerformanceChart').getContext('2d');
            const coursesPerformanceChart = new Chart(coursesPerformanceCtx, {
                type: 'bar',
                data: {
                    labels: courseLabels,
                    datasets: [
                        {
                            label: studentsCountLabel,
                            data: courseStudents,
                            backgroundColor: 'rgba(37, 99, 235, 0.8)',
                            borderRadius: 6,
                            barThickness: 12
                        },
                        {
                            label: revenueLabel,
                            data: courseRevenue,
                            backgroundColor: 'rgba(139, 92, 246, 0.8)',
                            borderRadius: 6,
                            barThickness: 12
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(156, 163, 175, 0.1)', drawBorder: false }
                        },
                        x: {
                            grid: { display: false, drawBorder: false }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            rtl: true,
                            labels: { usePointStyle: true, padding: 20 }
                        },
                        tooltip: {
                            titleFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 },
                            bodyFont: { family: 'Tajawal, sans-serif', weight: 'bold', size: 13 }
                        }
                    }
                }
            });
        });
    </script>
}
