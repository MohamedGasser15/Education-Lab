@functions {
    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return "?";

        var names = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        else if (names.Length == 1)
            return names[0][0].ToString().ToUpper();
        else
            return "?";
    }
}

@section Scripts {
    <script>
        let allNotificationStudents = [];
        let selectedStudentIds = [];
        let currentNotificationType = 'bulk';
        let currentIndividualStudent = null;

        function showModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        function showBulkNotificationModal() {
            currentNotificationType = 'bulk';
            selectedStudentIds = [];
            loadStudentsForNotification();
            updateNotificationUI();
            showModal('bulkNotificationModal');
        }

        function showIndividualNotificationModal(studentId, studentName) {
            currentNotificationType = 'individual';
            currentIndividualStudent = { id: studentId, name: studentName };
            selectedStudentIds = [studentId];
            loadStudentsForNotification();
            updateNotificationUI();
            showModal('bulkNotificationModal');
        }

        async function loadStudentsForNotification() {
            try {
                showLoading('studentsList', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["LoadingStudentsList"].Value))');

                const queryString = selectedStudentIds.length > 0 ?
                    `?selectedStudentIds=${selectedStudentIds.join('&selectedStudentIds=')}` : '';

                const response = await fetch(`/Instructor/Students/get-students-for-notification${queryString}`);
                const result = await response.json();

                if (result.success) {
                    allNotificationStudents = result.data;
                    renderStudentsList();
                    updateStudentsCount();
                } else {
                    showAlert('', '');
                }
            } catch (error) {
                console.error('Error loading students:', error);
                showAlert('', '');
            }
        }

        function renderStudentsList() {
            const container = document.getElementById('studentsList');

            if (allNotificationStudents.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4 text-gray-500 dark:text-gray-400">
                        <i class="fas fa-users text-2xl mb-2"></i>
                        <p>@Localizer["NoStudentsTitle"]</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = allNotificationStudents.map(student => `
                <div class="student-item flex items-center justify-between p-3 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center space-x-3 space-x-reverse">
                        <div class="flex-shrink-0">
                            <div class="relative">
                                <img class="h-10 w-10 rounded-full object-cover"
                                     src="${student.profileImageUrl || '/images/default-avatar.png'}"
                                     alt="${student.fullName}"
                                     onerror="this.src='/images/default-avatar.png'">
                                ${student.isSelected ? `
                                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white dark:border-gray-800"></div>
                                ` : ''}
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate">
                                ${student.fullName}
                            </p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">
                                ${student.email}
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center">
                        <input type="checkbox"
                               class="student-checkbox custom-checkbox"
                               value="${student.studentId}"
                               ${student.isSelected ? 'checked' : ''}
                               onchange="toggleStudentSelection('${student.studentId}', this.checked)"
                               ${currentNotificationType === 'individual' ? 'disabled' : ''}>
                    </div>
                </div>
            `).join('');
        }

        function toggleStudentSelection(studentId, isSelected) {
            if (isSelected) {
                if (!selectedStudentIds.includes(studentId)) {
                    selectedStudentIds.push(studentId);
                }
            } else {
                selectedStudentIds = selectedStudentIds.filter(id => id !== studentId);
            }

            updateStudentsCount();
            updateRecipientsCount();
        }

        function updateStudentsCount() {
            document.getElementById('totalStudentsCountModal').textContent = allNotificationStudents.length;
            document.getElementById('selectedStudentsCount').textContent = selectedStudentIds.length;
        }

        function updateRecipientsCount() {
            const count = currentNotificationType === 'individual' ?
                selectedStudentIds.length :
                (selectedStudentIds.length > 0 ? selectedStudentIds.length : allNotificationStudents.length);

            document.getElementById('recipientsCount').textContent = count;
        }

        function updateNotificationUI() {
            const title = document.getElementById('notificationTitle');
            const subtitle = document.getElementById('notificationSubtitle');
            const studentsColumn = document.getElementById('studentsColumn');
            const formColumn = document.getElementById('formColumn');

            if (currentNotificationType === 'individual') {
                title.textContent = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SendIndividualNotification"].Value))';
                subtitle.textContent = `@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SendNotificationToName"].Value))`.replace('{0}', currentIndividualStudent.name);
                if (studentsColumn) studentsColumn.classList.add('hidden');
                if (formColumn) {
                    formColumn.classList.remove('lg:col-span-2');
                    formColumn.classList.add('lg:col-span-3');
                }
            } else {
                title.textContent = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SendBulkNotification"].Value))';
                subtitle.textContent = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SendNotificationToStudentsShort"].Value))';
                if (studentsColumn) studentsColumn.classList.remove('hidden');
                if (formColumn) {
                    formColumn.classList.remove('lg:col-span-3');
                    formColumn.classList.add('lg:col-span-2');
                }
            }

            updateRecipientsCount();
        }

        function showConfirmationModal() {
            const subject = document.getElementById('bulkNotificationSubject').value;
            const content = document.getElementById('bulkNotificationContent').value;

            if (!subject || !content) {
                showAlert('', '');
                return;
            }

            if (subject.length > 200) {
                showAlert('', '');
                return;
            }

            if (content.length > 2000) {
                showAlert('', '');
                return;
            }

            const recipientsCount = document.getElementById('recipientsCount').textContent;
            const studentText = recipientsCount === '1' ? '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StudentUnit"].Value))' : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StudentUnit"].Value))';
            document.getElementById('confirmationMessage').textContent =
                `@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ConfirmNotificationRecipients"].Value))`.replace('{0}', recipientsCount);

            showModal('confirmationModal');
        }

        async function sendNotification() {
            const confirmBtn = document.getElementById('confirmSendBtn');
            if (confirmBtn && confirmBtn.disabled) return;

            const subject = document.getElementById('bulkNotificationSubject').value;
            const content = document.getElementById('bulkNotificationContent').value;
            const type = parseInt(document.getElementById('bulkNotificationType').value);
            const sendNotification = document.getElementById('sendNotification').checked;
            const sendEmail = document.getElementById('sendEmail').checked;

            const request = {
                Title: subject,
                Message: content,
                Type: type,
                StudentIds: currentNotificationType === 'individual' ? selectedStudentIds :
                           (selectedStudentIds.length > 0 ? selectedStudentIds : []),
                SendNotification: sendNotification,
                SendEmail: sendEmail
            };

            try {
                showLoadingInModal('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SendingNotification"].Value))');

                const response = await fetch('/Instructor/Students/send-notification', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(request)
                });

                const result = await response.json();

                if (result.success) {
                    showAlert('', '');

                    document.getElementById('bulkNotificationForm').reset();
                    selectedStudentIds = [];

                    closeModal('confirmationModal');
                    closeModal('bulkNotificationModal');

                } else {
                    showAlert('error', result.message || 'فشل في @Localizer["SendNotification"]');
                    if (result.errors) {
                        console.error('Notification errors:', result.errors);
                    }
                }
            } catch (error) {
                console.error('Error sending notification:', error);
                showAlert('', '');
            } finally {
                resetLoadingInModal();
            }
        }



        // ========== Other modal functions ==========
        function showStudentDetails(studentId) {
            showModal('studentDetailsModal');
            loadStudentDetails(studentId);
        }

        function showMessageModal(studentId, fullName, email) {
            document.getElementById('messageTo').value = fullName + ' <' + email + '>';
            showModal('sendMessageModal');
        }

        function sendMessage() {
            const subject = document.getElementById('messageSubject').value;
            const content = document.getElementById('messageContent').value;

            if (!subject || !content) {
                showAlert('', '');
                return;
            }

            showAlert('', '');
            closeModal('sendMessageModal');
            document.getElementById('messageForm').reset();
        }

        // ========== Helper functions ==========
        function showLoading(elementId, message = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Loading"].Value))') {
            const element = document.getElementById(elementId);
            if (element) {
                element.innerHTML = `
                    <div class="flex justify-center items-center py-8">
                        <div class="loading-spinner"></div>
                        <span class="mr-2 text-gray-500">${message}</span>
                    </div>
                `;
            }
        }

        function showLoadingInModal(message = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Loading"].Value))') {
            const sendBtn = document.getElementById('sendBulkNotificationBtn');
            const confirmBtn = document.getElementById('confirmSendBtn');

            if (sendBtn) {
                sendBtn.innerHTML = `<div class="loading-spinner"></div> ${message}`;
                sendBtn.disabled = true;
            }
            if (confirmBtn) {
                confirmBtn.innerHTML = `<div class="loading-spinner"></div> ${message}`;
                confirmBtn.disabled = true;
            }
        }

        function resetLoadingInModal() {
            const sendBtn = document.getElementById('sendBulkNotificationBtn');
            const confirmBtn = document.getElementById('confirmSendBtn');

            if (sendBtn) {
                sendBtn.innerHTML = `<i class="fas fa-paper-plane ms-2"></i> @Localizer["SendNotification"]`;
                sendBtn.disabled = false;
            }
            if (confirmBtn) {
                confirmBtn.innerHTML = `<i class="fas fa-check ms-2"></i> @Localizer["ConfirmSendTitle"]`;
                confirmBtn.disabled = false;
            }
        }



        async function loadStudentDetails(studentId) {
            try {
                const response = await fetch(`/Instructor/Students/details/${studentId}`);
                const result = await response.json();

                if (result.success && result.data) {
                    const studentDetails = result.data;
                    displayStudentDetails(studentDetails);
                } else {
                    document.getElementById('studentDetailsContent').innerHTML = `
                        <div class="text-center py-8 text-red-500">
                            <i class="fas fa-exclamation-triangle text-3xl mb-2"></i>
                            <p>${result.message || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ErrorLoadingData"].Value))'}</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('studentDetailsContent').innerHTML = `
                    <div class="text-center py-8 text-red-500">
                        <i class="fas fa-exclamation-triangle text-3xl mb-2"></i>
                        <p>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ErrorLoadingData"].Value))</p>
                    </div>
                `;
            }
        }

        function displayStudentDetails(studentDetails) {
            const content = document.getElementById('studentDetailsContent');

            if (!studentDetails || !studentDetails.student) {
                content.innerHTML = `
                    <div class="text-center py-8 text-red-500">
                        <i class="fas fa-exclamation-triangle text-3xl mb-2"></i>
                        <p>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StudentDataUnavailable"].Value))</p>
                    </div>
                `;
                return;
            }

            const student = studentDetails.student;
            const enrollments = studentDetails.enrollments || [];
            const statistics = studentDetails.statistics || {};
            const recentActivities = studentDetails.recentActivities || [];

            content.innerHTML = `
                <div class="space-y-6">
                    <!-- modal -->
                    <div class="student-details-grid">
                        <div class="detail-card">
                            <div class="detail-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["FullNameLabel"].Value))</div>
                            <div class="detail-value">${student.fullName || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotAvailable"].Value))'}</div>
                        </div>
                        <div class="detail-card">
                            <div class="detail-label">@Localizer["EmailHeader"]</div>
                            <div class="detail-value">${student.email || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotAvailable"].Value))'}</div>
                        </div>
                        <div class="detail-card">
                            <div class="detail-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["PhoneLabel"].Value))</div>
                            <div class="detail-value">${student.phoneNumber || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotAvailable"].Value))'}</div>
                        </div>
                        <div class="detail-card">
                            <div class="detail-label">@Localizer["RegistrationDateHeader"]</div>
                            <div class="detail-value">${student.createdAt ? new Date(student.createdAt).toLocaleDateString(document.documentElement.lang) : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotAvailable"].Value))'}</div>
                        </div>
                        <div class="detail-card">
                            <div class="detail-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["LastLoginLabel"].Value))</div>
                            <div class="detail-value">${student.lastLogin ? new Date(student.lastLogin).toLocaleDateString(document.documentElement.lang) : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotAvailable"].Value))'}</div>
                        </div>
                        <div class="detail-card">
                            <div class="detail-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StatusHeader"].Value))</div>
                            <div class="detail-value">
                                <span class="px-2 py-1 text-xs rounded-full ${student.isActive ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}">
                                    ${student.isActive ? '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ActiveStatus"].Value))' : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["InactiveStatus"].Value))'}
                                </span>
                            </div>
                        </div>
                    </div>

<!-- Statistics -->
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-value total">${statistics.totalEnrollments || 0}</div>
                            <div class="stat-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["TotalEnrollmentsLabel"].Value))</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value completed">${statistics.completedCourses || 0}</div>
                            <div class="stat-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CompletedCoursesStat"].Value))</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value progress">${(statistics.averageProgress || 0).toFixed(1)}%</div>
                            <div class="stat-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AverageProgressLabel"].Value))</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value grade">${statistics.averageGrade || 0}</div>
                            <div class="stat-label">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AverageGradeLabel"].Value))</div>
                        </div>
                    </div>

                    <!-- @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["EnrolledCoursesSection"].Value)) -->
                    <div>
                        <h3 class="section-title">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["EnrolledCoursesSection"].Value))</h3>
                        <div class="space-y-4">
                            ${enrollments.length > 0 ?
                                enrollments.map(enrollment => `
                                    <div class="course-item">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center space-x-4 space-x-reverse">
                                                ${enrollment.courseThumbnailUrl ?
                                                    `<img class="h-12 w-16 object-cover rounded" src="${enrollment.courseThumbnailUrl}" alt="${enrollment.courseTitle || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NotifTypeCourse"].Value))'}">` :
                                                    `<div class="h-12 w-16 bg-gray-200 dark:bg-gray-700 rounded flex items-center justify-center">
                                                        <i class="fas fa-book text-gray-400"></i>
                                                    </div>`
                                                }
                                                <div>
                                                    <h4 class="text-sm font-medium text-gray-900 dark:text-white">${enrollment.courseTitle || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CourseWithoutTitle"].Value))'}</h4>
                                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                                        @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["EnrolledAtPrefix"].Value)) ${enrollment.enrolledAt ? new Date(enrollment.enrolledAt).toLocaleDateString(document.documentElement.lang) : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StatusUnknown"].Value))'}
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="text-start">
                                                <div class="text-sm font-medium text-gray-900 dark:text-white">${(enrollment.progressPercentage || 0).toFixed(1)}%</div>
                                                <div class="progress-bar-container">
                                                    <div class="progress-bar" style="width: ${enrollment.progressPercentage || 0}%;"></div>
                                                </div>
                                                <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                                    ${enrollment.completedLectures || 0} / ${enrollment.totalLectures || 0} @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["LecturesUnit"].Value))
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-3 flex items-center justify-between">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getStatusBadgeClass(enrollment.status)}">
                                                ${getStatusText(enrollment.status)}
                                            </span>
                                            ${enrollment.lastActivity ?
                                                `<span class="text-xs text-gray-500 dark:text-gray-400">
                                                    @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["LastActivityPrefix"].Value)) ${new Date(enrollment.lastActivity).toLocaleDateString(document.documentElement.lang)}
                                                </span>` : ''
                                            }
                                        </div>
                                    </div>
                                `).join('') :
                                `<div class="text-center py-8 text-gray-500 dark:text-gray-400">
                                    <i class="fas fa-book-open text-2xl mb-2"></i>
                                    <p>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NoEnrollmentsYet"].Value))</p>
                                </div>`
                            }
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div>
                        <h3 class="section-title">@Localizer["RecentActivitySection"]</h3>
                        <div class="space-y-3">
                            ${recentActivities.length > 0 ?
                                recentActivities.map(activity => `
                                    <div class="activity-item ${activity.type || 'default'}">
                                        <div class="flex items-start space-x-3 space-x-reverse">
                                            <div class="flex-shrink-0">
                                                <div class="w-8 h-8 rounded-full ${getActivityIconClass(activity.type)} flex items-center justify-center">
                                                    <i class="${getActivityIcon(activity.type)} text-sm"></i>
                                                </div>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm text-gray-900 dark:text-white">${activity.description || '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ActivityWithoutDescription"].Value))'}</p>
                                                <div class="mt-1 flex items-center space-x-2 space-x-reverse">
                                                    <span class="text-xs text-gray-500 dark:text-gray-400">
                                                        ${activity.activityDate ? new Date(activity.activityDate).toLocaleDateString(document.documentElement.lang) : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StatusUnknown"].Value))'}
                                                    </span>
                                                    ${activity.courseTitle ?
                                                        `<span class="text-xs text-blue-600 dark:text-blue-400">${activity.courseTitle}</span>` : ''
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `).join('') :
                                `<div class="text-center py-8 text-gray-500 dark:text-gray-400">
                                    <i class="fas fa-history text-2xl mb-2"></i>
                                    <p>@Localizer["NoRecentActivity"]</p>
                                </div>`
                            }
                        </div>
                    </div>
                </div>
            `;
        }

        function getStatusBadgeClass(status) {
            if (!status) return 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200';

            switch(status.toLowerCase()) {
                case 'active':
                case '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ActiveStatus"].Value))':
                    return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
                case 'completed':
                case '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CompletedStatus"].Value))':
                    return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
                case 'inactive':
                case '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["InactiveStatus"].Value))':
                    return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
                default:
                    return 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200';
            }
        }

        function getStatusText(status) {
            if (!status) return '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StatusUnknown"].Value))';

            switch(status.toLowerCase()) {
                case 'active': return '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ActiveStatus"].Value))';
                case 'completed': return '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CompletedStatus"].Value))';
                case 'inactive': return '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["InactiveStatus"].Value))';
                default: return status;
            }
        }

        function getActivityIcon(type) {
            if (!type) return 'fas fa-bell';

            switch(type.toLowerCase()) {
                case 'enrollment':
                case 'تسجيل':
                    return 'fas fa-user-plus';
                case 'completion':
                case 'إكمال':
                    return 'fas fa-check-circle';
                case 'video':
                case 'فيديو':
                    return 'fas fa-play-circle';
                case 'quiz':
                case 'اختبار':
                    return 'fas fa-question-circle';
                case 'certificate':
                case 'شهادة':
                    return 'fas fa-award';
                default:
                    return 'fas fa-bell';
            }
        }

        function getActivityIconClass(type) {
            if (!type) return 'bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-300';

            switch(type.toLowerCase()) {
                case 'enrollment':
                case 'تسجيل':
                    return 'bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-300';
                case 'completion':
                case 'إكمال':
                    return 'bg-green-100 text-green-600 dark:bg-green-900 dark:text-green-300';
                case 'video':
                case 'فيديو':
                    return 'bg-purple-100 text-purple-600 dark:bg-purple-900 dark:text-purple-300';
                case 'quiz':
                case 'اختبار':
                    return 'bg-orange-100 text-orange-600 dark:bg-orange-900 dark:text-orange-300';
                case 'certificate':
                case 'شهادة':
                    return 'bg-yellow-100 text-yellow-600 dark:bg-yellow-900 dark:text-yellow-300';
                default:
                    return 'bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-300';
            }
        }

        // ========== Pagination & Bulk Actions (like Course Index) ==========
        document.addEventListener('DOMContentLoaded', function() {
            let filteredRows = [];
            let rowsPerPage = 5;
            let currentPage = 1;

            const totalStudents = document.getElementById('total-students');
            const showingFrom = document.getElementById('showing-from');
            const showingTo = document.getElementById('showing-to');
            const paginationNumbers = document.getElementById('pagination-numbers');
            const prevButton = document.getElementById('prev-page');
            const nextButton = document.getElementById('next-page');
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            const resetFiltersBtn = document.getElementById('resetFilters');
            const rowsPerPageSelect = document.getElementById('rows-per-page');

            function filterStudents() {
                const searchTerm = searchInput.value.toLowerCase();

                filteredRows = Array.from(document.querySelectorAll('tbody tr[data-student-id]')).filter(row => {
                    const nameEl = row.querySelector('h4');
                    const emailEl = row.querySelector('td:nth-child(3) span');
                    const name = nameEl ? nameEl.textContent.toLowerCase() : '';
                    const email = emailEl ? emailEl.textContent.toLowerCase() : '';
                    const status = row.getAttribute('data-status');

                    const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm);
                    const matchesStatus = !statusFilter.value || status === statusFilter.value;

                    return matchesSearch && matchesStatus;
                });

                if (totalStudents) totalStudents.textContent = filteredRows.length;
                currentPage = 1;
                updateTable();
                setupPagination();
            }

            function updateTable() {
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                document.querySelectorAll('tbody tr[data-student-id]').forEach(row => {
                    row.style.display = 'none';
                });

                filteredRows.slice(start, end).forEach(row => {
                    row.style.display = 'table-row';
                });

                if (showingFrom) showingFrom.textContent = filteredRows.length === 0 ? 0 : start + 1;
                if (showingTo) showingTo.textContent = Math.min(end, filteredRows.length);
            }

            function setupPagination() {
                if (!paginationNumbers) return;
                const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
                paginationNumbers.innerHTML = '';

                if (pageCount <= 1) return;

                addPageButton(1);

                const startPage = Math.max(2, currentPage - 1);
                const endPage = Math.min(pageCount - 1, currentPage + 1);

                if (startPage > 2) {
                    paginationNumbers.innerHTML += '<span class="px-3 py-1 text-gray-500">...</span>';
                }

                for (let i = startPage; i <= endPage; i++) {
                    addPageButton(i);
                }

                if (endPage < pageCount - 1) {
                    paginationNumbers.innerHTML += '<span class="px-3 py-1 text-gray-500">...</span>';
                }

                if (pageCount > 1) {
                    addPageButton(pageCount);
                }

                updatePaginationButtons();
            }

            function addPageButton(pageNumber) {
                const pageButton = document.createElement('button');
                pageButton.className = `pagination-btn ${pageNumber === currentPage ? 'active' : ''}`;
                pageButton.textContent = pageNumber;
                pageButton.addEventListener('click', () => {
                    currentPage = pageNumber;
                    updateTable();
                    setupPagination();
                });
                paginationNumbers.appendChild(pageButton);
            }

            function updatePaginationButtons() {
                if (!prevButton || !nextButton) return;
                const pageCount = Math.ceil(filteredRows.length / rowsPerPage);

                prevButton.disabled = currentPage === 1;
                nextButton.disabled = currentPage === pageCount || pageCount === 0;

                prevButton.classList.toggle('disabled', prevButton.disabled);
                nextButton.classList.toggle('disabled', nextButton.disabled);
            }

            searchInput?.addEventListener('input', filterStudents);
            statusFilter?.addEventListener('change', filterStudents);
            resetFiltersBtn?.addEventListener('click', function() {
                searchInput.value = '';
                statusFilter.value = '';
                filterStudents();
            });

            rowsPerPageSelect?.addEventListener('change', function() {
                rowsPerPage = parseInt(this.value);
                currentPage = 1;
                updateTable();
                setupPagination();
            });

            prevButton?.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    updateTable();
                    setupPagination();
                }
            });

            nextButton?.addEventListener('click', () => {
                const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
                if (currentPage < pageCount) {
                    currentPage++;
                    updateTable();
                    setupPagination();
                }
            });

            filterStudents();

            // ========== Bulk Actions ==========
            const bulkActionsContainer = document.getElementById('bulkActionsContainer');
            const selectAllCheckbox = document.getElementById('selectAll');
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkActionSelect = document.getElementById('bulkAction');
            const applyBulkActionBtn = document.getElementById('applyBulkAction');

            function updateSelectedCount() {
                const selectedCount = document.querySelectorAll('.row-checkbox:checked').length;
                if (selectedCountSpan) selectedCountSpan.textContent = selectedCount;

                if (selectedCount > 0) {
                    bulkActionsContainer?.classList.remove('hidden');
                    if (selectAllCheckbox) selectAllCheckbox.checked = selectedCount === document.querySelectorAll('.row-checkbox').length;
                } else {
                    bulkActionsContainer?.classList.add('hidden');
                    if (selectAllCheckbox) selectAllCheckbox.checked = false;
                }
            }

            selectAllCheckbox?.addEventListener('change', function() {
                const isChecked = this.checked;
                document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                updateSelectedCount();
            });

            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', updateSelectedCount);
            });

            applyBulkActionBtn?.addEventListener('click', function() {
                const action = bulkActionSelect?.value;
                const selected = Array.from(document.querySelectorAll('.row-checkbox:checked'));

                if (selected.length === 0) return;

                if (action === 'notification' || action === 'message') {
                    showBulkNotificationModal();
                } else if (action === 'export') {
                    const rows = selected.map(cb => {
                        const row = cb.closest('tr');
                        const nameEl = row.querySelector('h4');
                        const emailEl = row.querySelector('td:nth-child(3) span');
                        return [nameEl ? nameEl.textContent : '', emailEl ? emailEl.textContent : ''].join(',');
                    });
                    const csv = '\uFEFF' + rows.join('\n');
                    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = 'students.csv';
                    link.click();
                    URL.revokeObjectURL(link.href);
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('sendBulkNotification')?.addEventListener('click', showBulkNotificationModal);

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeModal('bulkNotificationModal');
                    closeModal('confirmationModal');
                    closeModal('studentDetailsModal');
                    closeModal('sendMessageModal');
                }
            });

            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeModal(this.id);
                    }
                });
            });
        });
    </script>
}
