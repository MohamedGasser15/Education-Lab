        .dark .bn-search-result:active {
            background: #1f2937;
        }

        .bn-search-result img {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            object-fit: cover;
            flex-shrink: 0;
            background: #f3f4f6;
