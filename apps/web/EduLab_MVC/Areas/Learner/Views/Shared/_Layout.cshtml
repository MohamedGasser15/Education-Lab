                <i class="fas fa-arrow-right rtl-flip"></i>
            </button>
            <div class="bn-search-field">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="bn-search-input" name="search" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="@Localizer["SearchPlaceholder"]">
            </div>
            <button type="button" id="bn-search-clear" class="bn-search-icon-btn bn-clear-hidden" aria-label="@Localizer["Clear"]">
                <i class="fas fa-times"></i>
            </button>
        </form>
        <div class="bn-search-body">
            <div id="bn-suggestions">
                <div class="bn-search-section-title">@Localizer["Trending"]</div>
                <div class="bn-chips" id="bn-trending">
                    @foreach (var bnT in new[] { "Programming", "AI", "Design", "Marketing", "Business", "Languages" })
                    {
                        <button type="button" class="bn-chip" data-term="@Localizer[bnT]"><i class="fas fa-arrow-trend-up"></i>@Localizer[bnT]</button>
                    }
                </div>
                <div class="bn-search-section-title">@Localizer["RecentSearches"]</div>
                <div class="bn-chips" id="bn-recent"></div>
            </div>
            <div id="bn-results" class="bn-hidden"></div>
        </div>
    </div>

    <!-- Mobile Bottom Navigation -->
    <nav id="mobile-bottom-nav" class="mobile-bottom-nav" aria-label="@Localizer["MainNavigation"]">
        <a href="/" class="bn-item @(isBnHome ? "active" : "")" aria-current="@(isBnHome ? "page" : null)">
            <i class="fas fa-house bn-icon"></i>
            <span class="bn-label">@Localizer["Home"]</span>
        </a>
        <a asp-area="Learner" asp-controller="Course" asp-action="Index" class="bn-item @(isBnCourses ? "active" : "")" aria-current="@(isBnCourses ? "page" : null)">
            <i class="fas fa-graduation-cap bn-icon"></i>
            <span class="bn-label">@Localizer["Courses"]</span>
        </a>
        <button id="bn-search" class="bn-search" aria-label="@Localizer["Search"]">
            <span class="bn-search-circle"><i class="fas fa-magnifying-glass"></i></span>
        </button>
        <a asp-area="Learner" asp-controller="Cart" asp-action="Index" class="bn-item @(isBnCart ? "active" : "")" aria-current="@(isBnCart ? "page" : null)">
            <i class="fas fa-cart-shopping bn-icon">
                @if (bnCartCount > 0)
                {
                    <span class="bn-badge">@(bnCartCount > 99 ? "99+" : bnCartCount.ToString())</span>
                }
            </i>
            <span class="bn-label">@Localizer["Cart"]</span>
        </a>
        @if (isLoggedIn)
        {
            <a asp-area="Learner" asp-controller="Profile" asp-action="@(bnUserRole == "Instructor" ? "Instructor" : "Index")" class="bn-item @(isBnProfile ? "active" : "")" aria-current="@(isBnProfile ? "page" : null)">
                <i class="fas fa-user bn-icon"></i>
                <span class="bn-label">@Localizer["Profile"]</span>
            </a>
        }
        else
        {
            <button id="bn-menu" class="bn-item" aria-label="@Localizer["Menu"]">
                <i class="fas fa-bars bn-icon"></i>
                <span class="bn-label">@Localizer["Menu"]</span>
            </button>
        }
    </nav>

    <script>
        // Global Form Loading State
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (form.getAttribute('data-no-loading') === 'true') return;
            const submitBtn = form.querySelector('button[type="submit"]');
            if (!submitBtn) return;
            if (submitBtn.disabled) return;
            submitBtn.disabled = true;
            submitBtn.classList.add('cursor-wait', 'opacity-80');
            submitBtn.dataset.originalHtml = submitBtn.innerHTML;
            if (submitBtn.querySelector('i') && submitBtn.textContent.trim() === '') {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            } else {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin @(isArabic ? "ml-2" : "mr-2")"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Processing"].Value))';
            }
        });
    </script>

    @{
        var learnerCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
        var learnerAct = ViewContext.RouteData.Values["Action"]?.ToString();
        var showSupportWidget = isLoggedIn && learnerCtrl == "Home" &&
            (learnerAct == "contact" || learnerAct == "faq" || learnerAct == "privacy" || learnerAct == "terms" || learnerAct == "help");
    }
    @if (showSupportWidget)
    {
        @await Html.PartialAsync("_SupportChatWidget")
    }
</body>
</html>
