.navbar-classic {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.03);
}
.dark .navbar-classic {
    background: #1f2937;
    border-bottom-color: #374151;
}

.top-bar-simple {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
}
.dark .top-bar-simple {
    background: #111827;
    border-bottom-color: #1f2937;
    color: #9ca3af;
}

.nav-icon-btn-classic {
    background: transparent;
}

/* أزرار الموبايل في النافبار — ستايل حقيقي بدون apply */
.mobile-icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f3f4f6;
    color: #4b5563;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    padding: 0;
    transition: background 0.2s, transform 0.15s, color 0.2s;
    -webkit-tap-highlight-color: transparent;
}

.dark .mobile-icon-btn {
    background: #1f2937;
    color: #e5e7eb;
}

.mobile-icon-btn:hover {
    background: #e5e7eb;
    color: #2563eb;
}

.dark .mobile-icon-btn:hover {
    background: #374151;
    color: #60a5fa;
}

.mobile-icon-btn:active {
    transform: scale(0.88);
}

.search-box-classic {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 40px;
    padding: 0.4rem 1rem;
    transition: all 0.2s;
}
.dark .search-box-classic {
    background: #374151;
    border-color: #4b5563;
}
.search-box-classic:focus-within {
    background: white;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
}
.dark .search-box-classic:focus-within {
    background: #1f2937;
        }
        /* ========== TOP BAR GRADIENT ========== */
        .top-bar-gradient {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: white;
        }

        .top-bar-gradient a {
        color: rgba(255, 255, 255, 0.85);
        transition: color 0.2s;
        }

        .top-bar-gradient a:hover {
        color: white;
        }

        .top-bar-gradient i {
        color: rgba(255, 255, 255, 0.9);
        }
    </style>
    <style>
        /* Show suggestions when input is focused */
        .search-enhanced-container:focus-within .search-suggestions-enhanced {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        }
    
        /* Keep suggestions visible when hovering over them */
        .search-suggestions-enhanced:hover {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
        }
    
        /* Smooth transitions */
        .search-suggestions-enhanced {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
        }
    
        /* Suggestion item hover animation */
        .suggestion-item {
        transition: all 0.15s ease;
        }

        .suggestion-item:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px -4px rgba(0, 0, 0, 0.05);
        }

        .dark .suggestion-item:hover {
        box-shadow: 0 4px 8px -4px rgba(0, 0, 0, 0.2);
        }
    
        /* Responsive adjustments */
        @@media (max-width: 1024px) {
        .search-enhanced-container .search-suggestions-enhanced {
        left: auto;
        right: 0;
        width: 380px;
        }
        }
    </style>

</head>
