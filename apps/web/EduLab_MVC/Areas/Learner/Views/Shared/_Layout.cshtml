    <script>
        // إدارة القائمة الجانبية للهواتف المحمولة
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const closeSidebar = document.getElementById('close-sidebar');
            const mobileSidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('overlay');
            const mobileMenuContent = document.getElementById('mobile-menu-content');

            // نسخ محتوى القائمة المحمولة إلى الشريط الجانبي
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && mobileMenuContent) {
                mobileMenuContent.innerHTML = mobileMenu.innerHTML;
                mobileMenu.remove(); // إزالة القائمة الأصلية من DOM
            }

            // فتح القائمة الجانبية
            if (mobileMenuButton && mobileSidebar && overlay) {
                mobileMenuButton.addEventListener('click', function() {
                    mobileSidebar.classList.add('open');
                    overlay.classList.add('active');
                    document.body.style.overflow = 'hidden'; // منع التمرير عند فتح القائمة
                });
            }

            // إغلاق القائمة الجانبية
            if (closeSidebar && mobileSidebar && overlay) {
                closeSidebar.addEventListener('click', function() {
                    mobileSidebar.classList.remove('open');
                    overlay.classList.remove('active');
                    document.body.style.overflow = ''; // إعادة التمرير
                });
            }

            // إغلاق القائمة الجانبية عند النقر على الـ overlay
            if (overlay && mobileSidebar) {
                overlay.addEventListener('click', function() {
                    mobileSidebar.classList.remove('open');
                    overlay.classList.remove('active');
                    document.body.style.overflow = ''; // إعادة التمرير
                });
            }
        });

        let loadingScreen = document.getElementById('loading-screen');
        let loadingBar = document.getElementById('loading-bar');
        let percentElement = document.getElementById('loading-percent');
        let loadingTimeout;
        let hideTimeout;
        let resourcesLoaded = 0;
        let totalResources = 0;
        let percent = 0;
        let pageLoaded = false;
        let domReady = false;

        document.addEventListener('DOMContentLoaded', function() {
            domReady = true;
        });

        function updateProgress() {
            percent = Math.min(Math.round((resourcesLoaded / totalResources) * 100), 100);
            if (percentElement) percentElement.textContent = percent + '%';
            if (loadingBar) loadingBar.style.width = percent + '%';
        }

        function showLoadingScreen() {
            if (pageLoaded || !loadingScreen) return;

            loadingScreen.style.display = 'flex';
            loadingScreen.style.pointerEvents = 'auto';
            loadingScreen.style.opacity = '1';

            const resources = document.querySelectorAll('img, iframe, video, audio');
            totalResources = resources.length || 1;
            resources.forEach(resource => {
                resource.addEventListener('load', () => {
                    resourcesLoaded++;
                    updateProgress();
                });
                resource.addEventListener('error', () => {
                    resourcesLoaded++;
                    updateProgress();
                });
            });

            // تقدم تدريجي حتى لا تبدو الشاشة عالقة
            const fallbackInterval = setInterval(() => {
                if (percent < 85) {
                    percent = Math.min(percent + 2, 85);
                    if (percentElement) percentElement.textContent = percent + '%';
                    if (loadingBar) loadingBar.style.width = percent + '%';
                }
                if (pageLoaded) clearInterval(fallbackInterval);
            }, 150);

            // حد أقصى للعرض حتى لو استمرت الموارد في التحميل
            hideTimeout = setTimeout(hideLoadingScreen, 2500);
        }

        function hideLoadingScreen() {
            if (!loadingScreen) return;
            clearTimeout(loadingTimeout);
            clearTimeout(hideTimeout);
            pageLoaded = true;

            if (percentElement) percentElement.textContent = '100%';
            if (loadingBar) loadingBar.style.width = '100%';

            loadingScreen.style.opacity = '0';
            setTimeout(() => {
                if (loadingScreen) {
                    loadingScreen.style.display = 'none';
                    loadingScreen.style.pointerEvents = 'none';
                }
            }, 300);
        }

        // اعرض شاشة التحميل فقط إذا تأخر وصول الصفحة فعلاً (قبل DOMContentLoaded)
        loadingTimeout = setTimeout(function() {
            if (!domReady && !pageLoaded) showLoadingScreen();
        }, 1200);

        window.addEventListener('load', hideLoadingScreen);

        if (document.readyState === 'complete') {
            hideLoadingScreen();
        }
    </script>
    <script>
        // نظام عرض الرسائل المحسن
        document.addEventListener('DOMContentLoaded', function() {
            // معالجة رسائل TempData من الخادم
            @if (TempData["SuccessMessage"] != null)
            {
                        <text>showAlert('success', '@Html.Raw(TempData["SuccessMessage"])');</text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                        <text>showAlert('error', '@Html.Raw(TempData["ErrorMessage"])');</text>
            }
        });

        // دالة لعرض الرسائل
        function showAlert(type, message, duration = 5000) {
            const alertContainer = document.getElementById('alert-container');
            if (!alertContainer) return;

            // امسح أي رسالة موجودة قبل ما تضيف الجديدة
            alertContainer.innerHTML = "";

            const alertElement = document.createElement('div');
            alertElement.className = `alert alert-${type}`;
            alertElement.setAttribute('role', 'alert');

            // تحديد الأيقونة المناسبة حسب نوع الرسالة
            let icon = '';
            switch(type) {
                case 'success':
                    icon = 'fa-check-circle';
                    break;
                case 'error':
                    icon = 'fa-exclamation-circle';
                    break;
                case 'info':
                    icon = 'fa-info-circle';
                    break;
                case 'warning':
                    icon = 'fa-exclamation-triangle';
                    break;
                default:
                    icon = 'fa-info-circle';
            }

            alertElement.innerHTML = `
                <i class="fas ${icon} alert-icon"></i>
                <div class="alert-content">${message}</div>
                <button class="alert-close" onclick="closeAlert(this.parentElement)">
                    <i class="fas fa-times"></i>
                </button>
                <div class="alert-progress">
                    <div class="alert-progress-bar"></div>
                </div>
            `;

            alertContainer.appendChild(alertElement);

            // باقي الكود زي ما هو (إظهار، progress bar، إخفاء...)
            setTimeout(() => {
                alertElement.classList.add('show');

                const progressBar = alertElement.querySelector('.alert-progress-bar');
                if (progressBar) {
                    progressBar.style.width = '100%';
                    setTimeout(() => {
                        progressBar.style.transition = `width ${duration}ms linear`;
                        progressBar.style.width = '0%';
                    }, 50);
                }
            }, 10);

            const autoHide = setTimeout(() => {
                closeAlert(alertElement);
            }, duration);

            alertElement.addEventListener('mouseenter', () => {
                clearTimeout(autoHide);
                const progressBar = alertElement.querySelector('.alert-progress-bar');
                if (progressBar) {
                    progressBar.style.transition = 'none';
                    const currentWidth = parseFloat(getComputedStyle(progressBar).width);
                    progressBar.dataset.currentWidth = currentWidth;
                }
            });

            alertElement.addEventListener('mouseleave', () => {
                const progressBar = alertElement.querySelector('.alert-progress-bar');
                if (progressBar) {
                    const currentWidth = parseFloat(progressBar.dataset.currentWidth || '100');
                    const remainingTime = (currentWidth / 100) * duration;

                    progressBar.style.transition = `width ${remainingTime}ms linear`;
                    progressBar.style.width = '0%';

                    setTimeout(() => {
                        closeAlert(alertElement);
                    }, remainingTime);
                }
            });
        }


        // دالة لإغلاق الرسالة
        function closeAlert(alertElement) {
            if (!alertElement) return;

            alertElement.classList.remove('show');
            alertElement.classList.add('hide');

            setTimeout(() => {
                if (alertElement.parentNode) {
                    alertElement.parentNode.removeChild(alertElement);
                }
            }, 400);
        }

        // دوال مساعدة للأنواع المختلفة من الرسائل
        function showSuccess(message, duration) {
            showAlert('success', message, duration);
        }

        function showError(message, duration) {
            showAlert('error', message, duration);
        }

        function showInfo(message, duration) {
            showAlert('info', message, duration);
        }

        function showWarning(message, duration) {
            showAlert('warning', message, duration);
        }

        // جعل الدوال متاحة عالمياً
        window.showAlert = showAlert;
        window.showSuccess = showSuccess;
        window.showError = showError;
        window.showInfo = showInfo;
        window.showWarning = showWarning;
        window.closeAlert = closeAlert;
    </script>
    <script>
        (function() {
        // Unified Dropdown Manager
        document.addEventListener('DOMContentLoaded', function() {
        const dropdowns = document.querySelectorAll('.dropdown');
            
        dropdowns.forEach(dropdown => {
        const toggle = dropdown.querySelector('.dropdown-toggle');
        const content = dropdown.querySelector('.dropdown-content');
                
        if (!toggle || !content) return;
                
        // Prevent clicks inside content from closing
        content.addEventListener('click', (e) => e.stopPropagation());
                
        // Toggle dropdown on button click
        toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
                    
        // Close all other dropdowns
        document.querySelectorAll('.dropdown-content').forEach(c => {
        if (c !== content) {
        c.classList.add('hidden');
        }
        });
                    
        // Toggle current dropdown
        content.classList.toggle('hidden');
        });
        });
            
        // Close all dropdowns when clicking outside
        document.addEventListener('click', function() {
        document.querySelectorAll('.dropdown-content').forEach(content => {
        content.classList.add('hidden');
        });
        });
        });
        })();
    </script>
    <script>
        // ========== نظام الاقتراحات الفورية للبحث (Autocomplete) ==========
        (function() {
            const suggestUrl = '@Url.Action("Suggest", "Course", new { area = "Learner" })';
            const noResultsText = '@Html.Raw(Localizer["NoResultsFound"].Value)';

            function escapeHtml(s) {
                const div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }

            // تمييز الجزء المطابق من النص
            function highlight(text, query) {
                const idx = text.toLowerCase().indexOf(query.toLowerCase());
                if (idx === -1) return escapeHtml(text);
                return escapeHtml(text.slice(0, idx)) +
                    '<mark class="bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded px-0.5">' +
                    escapeHtml(text.slice(idx, idx + query.length)) + '</mark>' +
                    escapeHtml(text.slice(idx + query.length));
            }

            function initSuggestions(config) {
                const input = document.getElementById(config.inputId);
                const resultsEl = document.getElementById(config.resultsId);
                const staticEl = config.staticId ? document.getElementById(config.staticId) : null;
                if (!input || !resultsEl) return;

                let debounceTimer = null;
                let currentItems = [];
                let activeIndex = -1;

                function setActive(idx) {
                    activeIndex = idx;
                    Array.from(resultsEl.children).forEach(function(el, i) {
                        el.classList.toggle('bg-blue-50', i === idx);
                        el.classList.toggle('dark:bg-blue-900/30', i === idx);
                    });
                }

                function render(items) {
                    currentItems = items;
                    activeIndex = -1;
                    resultsEl.innerHTML = '';

                    if (items.length === 0) {
                        resultsEl.innerHTML =
                            '<div class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">' +
                            '<i class="fas fa-search text-gray-300 dark:text-gray-600 block mb-2 text-xl"></i>' +
                            escapeHtml(noResultsText) + '</div>';
                        return;
                    }

                    items.forEach(function(item, idx) {
                        const row = document.createElement('a');
                        row.href = item.url;
                        row.className = 'flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors border-b border-gray-50 dark:border-gray-700/50 last:border-0 cursor-pointer';

                        const isInstructor = item.type === 'instructor';
                        const isCategory = item.type === 'category';
                        const itemIcon = isCategory ? 'fa-folder' : (isInstructor ? 'fa-chalkboard-teacher' : 'fa-graduation-cap');
                        const placeholder =
                            '<div class=&quot;w-10 h-10 ' + (isInstructor ? 'rounded-full' : 'rounded-lg') + ' bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0&quot;>' +
                            '<i class=&quot;fas ' + itemIcon + ' text-sm&quot;></i></div>';
                        const thumb = item.thumb
                            ? '<img src="' + escapeHtml(item.thumb) + '" alt="" class="w-10 h-10 ' + (isInstructor ? 'rounded-full' : 'rounded-lg') + ' object-cover flex-shrink-0" onerror="this.outerHTML=\'' + placeholder + '\'">'
                            : placeholder;

                        row.innerHTML =
                            thumb +
                            '<div class="flex-1 min-w-0">' +
                            '<div class="text-sm font-bold text-gray-800 dark:text-gray-200 truncate">' + highlight(item.title, input.value) + '</div>' +
                            '<div class="text-[10px] text-gray-400 font-medium truncate mt-0.5"><i class="fas fa-chalkboard-teacher mr-1"></i>' + escapeHtml(item.subtitle || '') + '</div>' +
                            '</div>' +
                            '<span class="text-[10px] text-gray-400 font-bold flex-shrink-0 bg-gray-50 dark:bg-gray-700/50 px-2 py-1 rounded-lg">' + escapeHtml(item.category || '') + '</span>';
                        row.addEventListener('mouseenter', function() { setActive(idx); });
                        row.addEventListener('mousedown', function(e) {
                            e.preventDefault();
                            window.location.href = item.url;
                        });
                        resultsEl.appendChild(row);
                    });
                }

                function fetchSuggestions() {
                    const term = input.value.trim();
                    if (term.length < 2) {
                        resultsEl.classList.add('hidden');
                        if (staticEl) staticEl.classList.remove('hidden');
                        return;
                    }
                    if (staticEl) staticEl.classList.add('hidden');
                    resultsEl.classList.remove('hidden');

                    fetch(suggestUrl + '?term=' + encodeURIComponent(term), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            if (input.value.trim().toLowerCase() !== term.toLowerCase()) return;
                            render(Array.isArray(data) ? data : []);
                        })
                        .catch(function() {
                            if (input.value.trim().toLowerCase() !== term.toLowerCase()) return;
                            render([]);
                        });
                }

                input.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(fetchSuggestions, 300);
                });

                input.addEventListener('keydown', function(e) {
                    if (e.key === 'ArrowDown') {
                        if (currentItems.length > 0) {
                            e.preventDefault();
                            setActive((activeIndex + 1) % currentItems.length);
                        }
                    } else if (e.key === 'ArrowUp') {
                        if (currentItems.length > 0) {
                            e.preventDefault();
                            setActive(activeIndex <= 0 ? currentItems.length - 1 : activeIndex - 1);
                        }
                    } else if (e.key === 'Enter') {
                        if (activeIndex >= 0 && currentItems[activeIndex]) {
                            e.preventDefault();
                            window.location.href = currentItems[activeIndex].url;
                        }
                    } else if (e.key === 'Escape') {
                        resultsEl.classList.add('hidden');
                        if (staticEl) staticEl.classList.remove('hidden');
                    }
                });

                document.addEventListener('click', function(e) {
                    if (!input.contains(e.target) && !resultsEl.contains(e.target)) {
                        resultsEl.classList.add('hidden');
                        if (staticEl) staticEl.classList.remove('hidden');
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function() {
                initSuggestions({
                    inputId: 'navbarSearchInput',
                    resultsId: 'dynamicSuggestionsDesktop',
                    staticId: 'staticSuggestionsDesktop'
                });
                initSuggestions({
                    inputId: 'mobileSearchInput',
                    resultsId: 'dynamicSuggestionsMobile',
                    staticId: null
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ToastMessages")
</body>
</html>