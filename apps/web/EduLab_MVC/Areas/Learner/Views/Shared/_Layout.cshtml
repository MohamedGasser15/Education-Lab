@using System.Globalization
@using EduLab_MVC.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject EduLab_MVC.Services.ServiceInterfaces.ISiteSettingsService _siteSettings
@inject EduLab_MVC.Services.ServiceInterfaces.ICartService _cartService
@inject EduLab_MVC.Services.ServiceInterfaces.IUserService _userService
@{
    var token = Context.Request.Cookies["AuthToken"];
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var siteSettings = await _siteSettings.GetSettingsAsync();
    var siteName = siteSettings?.SiteName ?? "EduLab";
    var siteDescription = siteSettings?.SiteDescription ?? "";
    var defaultLang = siteSettings?.DefaultLanguage ?? "en";
    var defaultTheme = siteSettings?.DefaultTheme ?? "system";
    var primaryColor = siteSettings?.PrimaryColor ?? "#2563eb";
    var hasLangCookie = Context.Request.Cookies.ContainsKey(".AspNetCore.Culture");
    var currentCulture = hasLangCookie ? CultureInfo.CurrentUICulture.Name : defaultLang;
    var isArabic = currentCulture.StartsWith("ar");
    var nameLen = siteName.Length;
    var splitAt = (int)Math.Ceiling(nameLen / 2.0);
    var brandFirst = siteName.Substring(0, splitAt);
    var brandSecond = siteName.Substring(splitAt);

    var bnCart = isLoggedIn ? await _cartService.GetUserCartAsync() : null;
    var bnCartCount = bnCart?.Items?.Count() ?? 0;
    var bnUser = isLoggedIn ? await _userService.GetCurrentUserAsync() : null;
    var bnUserRole = bnUser?.Role;
    var bnController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var bnAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isBnHome = bnController == "Home" && bnAction == "Index";
    var isBnCourses = bnController == "Course";
    var isBnCart = bnController == "Cart";
    var isBnProfile = bnController == "Profile" || bnController == "Auth";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @siteName</title>
    @if (!string.IsNullOrEmpty(siteDescription))
    {
        <meta name="description" content="@siteDescription">
    }
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Add Swiper JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link rel="icon" type="image/x-icon" href="~/Img/Logo/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/Img/Logo/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/Img/Logo/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/Img/Logo/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/Img/Logo/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="~/Img/Logo/android-chrome-512x512.png">
    <link rel="manifest" href="~/manifest.json">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Tajawal', 'Inter', 'sans-serif'],
                    },
                    colors: {
                    primary: {
                        600: '@primaryColor',
                        700: '@primaryColor',
                    }
                    }
                }
            }
        }
    </script>
    <script>
        // Apply theme before rendering to prevent flash
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const siteDefaultTheme = '@defaultTheme';
            let theme;
            if (savedTheme) {
                theme = savedTheme;
            } else if (siteDefaultTheme === 'dark') {
                theme = 'dark';
            } else if (siteDefaultTheme === 'light') {
                theme = 'light';
            } else {
                theme = systemPrefersDark ? 'dark' : 'light';
            }

            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
    <style>
        html, body {
            overflow-x: hidden;
            max-width: 100%;
        }

        .animate-gradient-text {d
            animation: gradientText 3s ease infinite;
            background: linear-gradient(90deg, #3b82f6, #10b981, #3b82f6);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @@keyframes gradientText {
            0% {
                background-position: 0% center;
            }

            100% {
                background-position: 200% center;
            }
        }

        .animate-pulse {
            animation: pulse 1.5s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.7;
            }

            50% {
                opacity: 1;
            }
        }

        /* Mobile sidebar styles */
        .mobile-sidebar {
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
        }

            .mobile-sidebar.open {
                transform: translateX(0);
            }

        .mobile-sidebar-header {
            padding: 18px 16px;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .dark .mobile-sidebar-header {
            border-bottom-color: #334155;
        }

        .mobile-sidebar-header .truncate {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 40;
        }

            .overlay.active {
                display: block;
            }

        /* تحسينات للهواتف المحمولة */
        @@media (max-width: 768px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
                max-width: 100%;
                overflow-x: hidden;
            }

            .header-top {
                font-size: 0.75rem;
            }

            .main-nav {
                padding-top: 0.5rem;
                padding-bottom: 0.5rem;
            }

            .mobile-search-input {
                border-radius: 0.5rem;
            }
            /* منع التمرير الأفقي في القوائم المنسدلة */
            .dropdown-content {
                max-width: 100vw;
                right: 0;
                left: 0;
            }
            /* تحسين عرض العناصر في الجوال */
            .header-top span {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }

        /* ضمان أن جميع الصور لا تتجاوز عرض الشاشة */
        img {
            max-width: 100%;
            height: auto;
        }

        /* ========== MOBILE BOTTOM NAVIGATION (Floating Pill) ========== */
        .mobile-bottom-nav {
            position: fixed;
            left: 12px;
            right: 12px;
            bottom: calc(10px + env(safe-area-inset-bottom, 0px));
            z-index: 45;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(18px) saturate(1.4);
            -webkit-backdrop-filter: blur(18px) saturate(1.4);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: 26px;
            box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.28), 0 2px 8px rgba(0, 0, 0, 0.06);
            padding: 6px 10px;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .dark .mobile-bottom-nav {
            background: rgba(23, 30, 46, 0.85);
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.6);
        }

        .mobile-bottom-nav.nav-hidden {
            transform: translateY(180%);
        }

        .bn-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            padding: 5px 0 3px;
            border-radius: 14px;
            color: #6b7280;
            text-decoration: none;
            transition: color 0.2s, transform 0.15s;
            position: relative;
        }

        .dark .bn-item {
            color: #9ca3af;
        }

        .bn-item.active {
            color: #2563eb;
        }

        .dark .bn-item.active {
            color: #60a5fa;
        }

        .bn-item:active {
            transform: scale(0.9);
        }

        button.bn-item {
            background: none;
            border: none;
            cursor: pointer;
            font-family: inherit;
            width: 100%;
            -webkit-tap-highlight-color: transparent;
        }

        .bn-icon {
            font-size: 1.15rem;
            position: relative;
            line-height: 1.4;
        }

        .bn-label {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        .bn-badge {
            position: absolute;
            top: -5px;
            inset-inline-end: -10px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            background: #2563eb;
            color: white;
            font-size: 10px;
            font-weight: 800;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.4);
        }

        .dark .bn-badge {
            border-color: #111827;
        }

        .bn-search {
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        .bn-search-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            margin-top: -22px;
            border: 4px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 10px 22px -8px rgba(37, 99, 235, 0.55);
            transition: transform 0.2s;
        }

        .dark .bn-search-circle {
            border-color: #171e2e;
        }

        .bn-search:active .bn-search-circle {
            transform: scale(0.9);
        }

        /* ========== MOBILE SPOTLIGHT SEARCH OVERLAY ========== */
        .bn-search-overlay {
            position: fixed;
            inset: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.97);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }

        .dark .bn-search-overlay {
            background: rgba(15, 20, 32, 0.97);
        }

        .bn-search-overlay.open {
            opacity: 1;
            visibility: visible;
        }

        /* أنيميشن فتح سلس — المحتوى بيطلع من تحت بثبات */
        .bn-search-overlay.open .bn-search-header {
            animation: bnSlideUp 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .bn-search-overlay.open .bn-search-body {
            animation: bnSlideUp 0.5s 0.05s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes bnSlideUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* أنيميشن إغلاق سلس */
        .bn-search-overlay.closing .bn-search-header {
            animation: bnSlideDown 0.2s ease both;
        }

        .bn-search-overlay.closing .bn-search-body {
            animation: bnSlideDown 0.26s 0.03s ease both;
        }

        @@keyframes bnSlideDown {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            to {
                opacity: 0;
                transform: translateY(22px) scale(0.985);
            }
        }

        .bn-hidden {
            display: none !important;
        }

        .bn-clear-hidden {
            visibility: hidden;
            opacity: 0;
            width: 0;
            padding: 0;
            transition: all 0.2s;
        }

        .bn-clear-hidden.show {
            visibility: visible;
            opacity: 1;
            width: 42px;
            padding: 0;
        }

        .bn-search-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 16px 14px;
            padding-top: calc(26px + env(safe-area-inset-top, 0px));
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            flex-shrink: 0;
        }

        .dark .bn-search-header {
            border-color: rgba(255, 255, 255, 0.08);
        }

        .bn-search-icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f4f6;
            color: #374151;
            border: none;
            cursor: pointer;
            transition: transform 0.15s, background 0.2s;
            flex-shrink: 0;
        }

        .dark .bn-search-icon-btn {
            background: #1f2937;
            color: #e5e7eb;
        }

        .bn-search-icon-btn:active {
            transform: scale(0.88);
        }

        .bn-search-field {
            flex: 1;
