            align-items: center;
            gap: 7px;
        }

        .dark .bn-chip {
            background: #1f2937;
            color: #d1d5db;
        }

        .bn-chip:active {
            background: #e5e7eb;
            transform: scale(0.95);
        }

        .bn-chip i {
            font-size: 11px;
            color: #2563eb;
        }

        .bn-search-result {
            display: flex;
            align-items: center;
