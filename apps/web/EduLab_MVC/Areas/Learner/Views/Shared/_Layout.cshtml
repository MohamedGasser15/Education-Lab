        }

        .dark .bn-search-field input {
            color: #f3f4f6;
        }

        .bn-search-body {
            flex: 1;
            overflow-y: auto;
            padding: 18px 16px;
            padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
            -webkit-overflow-scrolling: touch;
        }

        .bn-search-section-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9ca3af;
            margin-bottom: 10px;
        }

        .bn-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .bn-chip {
            padding: 8px 14px;
            border-radius: 999px;
            background: #f3f4f6;
            color: #4b5563;
            font-size: 13px;
            font-weight: 600;
            border: none;
