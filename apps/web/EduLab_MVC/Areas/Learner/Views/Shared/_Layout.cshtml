@using System.Globalization
@using EduLab_MVC.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject EduLab_MVC.Services.ServiceInterfaces.ISiteSettingsService _siteSettings
@{
    var token = Context.Request.Cookies["AuthToken"];
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var siteSettings = await _siteSettings.GetSettingsAsync();
    var siteName = siteSettings?.SiteName ?? "EduLab";
    var siteDescription = siteSettings?.SiteDescription ?? "";
    var defaultLang = siteSettings?.DefaultLanguage ?? "en";
    var defaultTheme = siteSettings?.DefaultTheme ?? "system";
    var primaryColor = siteSettings?.PrimaryColor ?? "#2563eb";
    var hasLangCookie = Context.Request.Cookies.ContainsKey(".AspNetCore.Culture");
    var currentCulture = hasLangCookie ? CultureInfo.CurrentUICulture.Name : defaultLang;
    var isArabic = currentCulture.StartsWith("ar");
    var nameLen = siteName.Length;
    var splitAt = (int)Math.Ceiling(nameLen / 2.0);
    var brandFirst = siteName.Substring(0, splitAt);
    var brandSecond = siteName.Substring(splitAt);
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @siteName</title>
    @if (!string.IsNullOrEmpty(siteDescription))
    {
        <meta name="description" content="@siteDescription">
    }
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Add Swiper JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link rel="icon" type="image/x-icon" href="~/Img/Logo/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/Img/Logo/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/Img/Logo/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/Img/Logo/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/Img/Logo/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="~/Img/Logo/android-chrome-512x512.png">
    <link rel="manifest" href="~/manifest.json">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Tajawal', 'Inter', 'sans-serif'],
                    },
                    colors: {
                    primary: {
                        600: '@primaryColor',
                        700: '@primaryColor',
                    }
                    }
                }
            }
        }
    </script>
    <script>
        // Apply theme before rendering to prevent flash
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const siteDefaultTheme = '@defaultTheme';
            let theme;
            if (savedTheme) {
                theme = savedTheme;
            } else if (siteDefaultTheme === 'dark') {
                theme = 'dark';
            } else if (siteDefaultTheme === 'light') {
                theme = 'light';
            } else {
                theme = systemPrefersDark ? 'dark' : 'light';
            }

            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
    <style>
        html, body {
            overflow-x: hidden;
            max-width: 100%;
        }

        .animate-gradient-text {d
            animation: gradientText 3s ease infinite;
            background: linear-gradient(90deg, #3b82f6, #10b981, #3b82f6);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @@keyframes gradientText {
            0% {
                background-position: 0% center;
            }

            100% {
                background-position: 200% center;
            }
        }

        .animate-pulse {
            animation: pulse 1.5s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.7;
            }

            50% {
                opacity: 1;
            }
        }

        /* Mobile sidebar styles */
        .mobile-sidebar {
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
        }

            .mobile-sidebar.open {
                transform: translateX(0);
            }

        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 40;
        }

            .overlay.active {
                display: block;
            }

        /* تحسينات للهواتف المحمولة */
        @@media (max-width: 768px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
                max-width: 100%;
                overflow-x: hidden;
            }

            .header-top {
                font-size: 0.75rem;
            }

            .main-nav {
                padding-top: 0.5rem;
                padding-bottom: 0.5rem;
            }

            .mobile-search-input {
                border-radius: 0.5rem;
            }
            /* منع التمرير الأفقي في القوائم المنسدلة */
            .dropdown-content {
                max-width: 100vw;
                right: 0;
                left: 0;
            }
            /* تحسين عرض العناصر في الجوال */
            .header-top span {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }

        /* ضمان أن جميع الصور لا تتجاوز عرض الشاشة */
        img {
            max-width: 100%;
            height: auto;
        }
    </style>
    <style>
        /* نظام الرسائل المحسن */
        .alert-container {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }
        [dir="rtl"] .alert-container {
            left: auto;
            right: 50%;
            transform: translateX(50%);
        }
        /* تحسينات للبحث في الموبايل */
        #mobile-search {
            transition: all 0.3s ease-in-out;
        }

            #mobile-search.hidden {
                display: none;
            }

            #mobile-search:not(.hidden) {
                display: block;
                animation: slideDown 0.3s ease-in-out;
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert {
            position: relative;
            width: 320px;
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            overflow: hidden;
            font-size: 0.95rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .alert.show {
                opacity: 1;
                transform: translateY(0);
            }

            .alert.hide {
                opacity: 0;
                transform: translateY(-20px);
            }

        .alert-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .alert-error {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .alert-info {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
        }
        .alert-warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }

        .alert-icon {
            margin-inline-end: 12px;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .alert-content {
            flex-grow: 1;
            line-height: 1.5;
            padding-inline-end: 8px;
            font-weight: 500;
        }

        .alert-close {
            background: none;
            border: none;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.8);
            transition: all 0.2s;
            flex-shrink: 0;
            font-size: 1rem;
            padding: 4px;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .alert-close:hover {
                color: white;
                background: rgba(255, 255, 255, 0.2);
            }

        .alert-progress {
            position: absolute;
            bottom: 0;
            inset-inline-start: 0;
            height: 3px;
            background-color: rgba(255, 255, 255, 0.3);
            width: 100%;
            border-radius: 0 0 12px 12px;
            overflow: hidden;
        }

        .alert-progress-bar {
            height: 100%;
            width: 100%;
            transition: width linear;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 0 0 12px 12px;
        }

        /* دعم الوضع الداكن */
        .dark .alert {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.05);
        }

        /* تصميم متجاوب */
        @@media (max-width: 640px) {
            .alert-container {
                width: calc(100% - 40px);
                left: 50%;
                transform: translateX(-50%);
                top: 15px;
            }
            [dir="rtl"] .alert-container {
                left: auto;
                right: 50%;
                transform: translateX(50%);
            }

            .alert {
                width: 100%;
                max-width: 100%;
            }
        }/* ========== NAVBAR CLASSIC REDESIGN ========== */
.navbar-classic {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.03);
}
.dark .navbar-classic {
    background: #1f2937;
    border-bottom-color: #374151;
}

.top-bar-simple {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
}
.dark .top-bar-simple {
    background: #111827;
    border-bottom-color: #1f2937;
    color: #9ca3af;
}

.nav-icon-btn-classic {
    @@apply text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 p-2.5 rounded-xl transition-all duration-200;
    background: transparent;
}
.nav-icon-btn-classic:hover {
    background: #f1f5f9;
    transform: translateY(-1px);
}
.dark .nav-icon-btn-classic:hover {
    background: #374151;
}

.search-box-classic {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 40px;
    padding: 0.4rem 1rem;
    transition: all 0.2s;
}
.dark .search-box-classic {
    background: #374151;
    border-color: #4b5563;
}
.search-box-classic:focus-within {
    background: white;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
}
.dark .search-box-classic:focus-within {
    background: #1f2937;
        }
        /* ========== TOP BAR GRADIENT ========== */
        .top-bar-gradient {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: white;
        }

        .top-bar-gradient a {
        color: rgba(255, 255, 255, 0.85);
        transition: color 0.2s;
        }

        .top-bar-gradient a:hover {
        color: white;
        }

        .top-bar-gradient i {
        color: rgba(255, 255, 255, 0.9);
        }
    </style>
    <style>
        /* Show suggestions when input is focused */
        .search-enhanced-container:focus-within .search-suggestions-enhanced {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        }
    
        /* Keep suggestions visible when hovering over them */
        .search-suggestions-enhanced:hover {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
        }
    
        /* Smooth transitions */
        .search-suggestions-enhanced {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
        }
    
        /* Suggestion item hover animation */
        .suggestion-item {
        transition: all 0.15s ease;
        }

        .suggestion-item:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px -4px rgba(0, 0, 0, 0.05);
        }

        .dark .suggestion-item:hover {
        box-shadow: 0 4px 8px -4px rgba(0, 0, 0, 0.2);
        }
    
        /* Responsive adjustments */
        @@media (max-width: 1024px) {
        .search-enhanced-container .search-suggestions-enhanced {
        left: auto;
        right: 0;
        width: 380px;
        }
        }
    </style>

</head>
<body class="bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
    @* Loading Screen *@
    <div id="loading-screen" class="fixed inset-0 bg-white dark:bg-gray-900 flex items-center justify-center z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
        <div class="flex flex-col items-center space-y-4">
            <div class="flex items-center space-x-2">
                <i class="fas fa-graduation-cap text-3xl animate-gradient-text"></i>
                <span class="text-2xl font-bold animate-gradient-text">@siteName</span>
            </div>

            <div class="w-48 h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden relative">
                <div id="loading-bar" class="h-full bg-gradient-to-r from-blue-500 to-green-500 transition-all duration-300 ease-out" style="width: 0%"></div>
            </div>

            <div class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
                <span class="animate-pulse">@Localizer["LoadingContent"]</span>
                <span>•</span>
                <span id="loading-percent">0%</span>
            </div>
        </div>
    </div>

    <!-- Overlay for mobile sidebar -->
    <div id="overlay" class="overlay"></div>

    <!-- Header -->
    <!-- Header - Classic Redesign -->
    <header class="fixed w-full top-0 z-50">
        <!-- Top Bar (Gradient) -->
        <div class="top-bar-gradient text-xs py-1 px-4">
            <div class="container mx-auto flex justify-between items-center">
                <div class="flex space-x-3 space-x-reverse">
                    <span class="hidden sm:inline-block"><i class="fas fa-phone-alt ml-1"></i> 0123456789</span>
                    <span class="hidden sm:inline-block"><i class="fas fa-envelope ml-1"></i> edulab152@gmail.com</span>
                    <span class="sm:hidden"><i class="fas fa-envelope ml-1"></i> info@edulab.com</span>
                </div>
                <div class="flex space-x-3 space-x-reverse items-center">
                    <a asp-controller="Home" asp-action="SetLanguage" asp-route-culture="@(isArabic ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="hover:text-white transition text-xs flex items-center gap-1">
                        <i class="fas fa-globe"></i>
                        <span>@(isArabic ? "English" : "العربية")</span>
                    </a>
                    <span class="text-white/30">|</span>
                    <a href="#" class="hover:text-white transition"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="hover:text-white transition"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="hover:text-white transition"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="hover:text-white transition"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>

        <!-- Main Navbar -->
        <nav class="navbar-classic py-2 px-4 md:px-8">
            <div class="container mx-auto flex justify-between items-center">
                <!-- Logo -->
                <div class="flex items-center space-x-2 space-x-reverse">
                    <i class="fas fa-graduation-cap text-blue-600 dark:text-blue-400 text-3xl"></i>
                    <a href="/" class="text-2xl font-extrabold text-gray-900 dark:text-white">
                    <span class="text-xl font-bold text-gray-900 dark:text-white">@brandFirst</span><span class="text-xl font-bold text-blue-600 dark:text-blue-400">@brandSecond</span>
                    </a>
                </div>

                <!-- Desktop Search -->
                <div class="hidden md:block relative flex-1 mx-6 max-w-xl">
                    <form class="w-full" method="get" action="@Url.Action("Search", "Course", new { area = "Learner" })">
                        <div class="search-enhanced-container">
                            <!-- Main Search Bar -->
                            <div class="flex items-center bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md focus-within:border-blue-500 focus-within:shadow-lg transition-all duration-200">
                                <!-- Search Icon with subtle background -->
                                <div class="flex items-center justify-center pl-5 pr-5">
                                    <i class="fas fa-search text-gray-400 dark:text-gray-500 text-base"></i>
                                </div>
                
                                <!-- Input Field -->
                                <input type="text"
                                       name="search"
                                       id="navbarSearchInput"
                                       autocomplete="off"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       placeholder="@Localizer["SearchPlaceholder"]"
                                       class="w-full bg-transparent border-none focus:outline-none focus:ring-0 text-gray-800 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 text-sm py-2.5 px-3"
                                       style="outline: none !important; box-shadow: none !important;">
                                <!-- Divider -->
                                <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 mx-1"></div>
                
                                <!-- Submit Button with Arrow -->
                                <button type="submit"
                                        class="flex items-center justify-center text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-gray-700 p-2.5 rounded-full transition-all duration-200 group">
                                    <i class="fas fa-arrow-left text-sm group-hover:-translate-x-0.5 transition-transform"></i>
                                </button>
                            </div>
            
                            <!-- Suggestions Dropdown (Enhanced) -->
                            <div class="search-suggestions-enhanced absolute top-full left-0 right-0 mt-2 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 overflow-hidden opacity-0 invisible translate-y-[-10px] transition-all duration-200 z-50">
                                <div class="p-4">
                                    <!-- Static: Trending -->
                                    <div id="staticSuggestionsDesktop">
                                        <!-- Header -->
                                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                            @Localizer["Trending"]
                                        </p>
                    
                                        <!-- Trending List -->
                                        <div class="flex flex-col">
                                            @{
                                                var trendingItems = new[] { "Programming", "AI", "Design", "Marketing", "Business", "Languages" };
                                            }
                                            @for (var i = 0; i < trendingItems.Length; i++)
                                            {
                                                var key = trendingItems[i];
                                                @if (i > 0) { <div class="border-t border-gray-100 dark:border-gray-700/50"></div> }
                                                <a href="@Url.Action("Search", "Course", new { area = "Learner", search = Localizer[key].Value })" class="group flex items-center gap-3 px-1 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all">
                                                    <i class="fas fa-arrow-trend-up text-blue-600 dark:text-blue-400 text-xs flex-shrink-0"></i>
                                                    <span class="flex-1 font-medium">@Localizer[key]</span>
                                                    <i class="fas fa-arrow-left text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 flex-shrink-0"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                    <!-- Dynamic: Live Suggestions -->
                                    <div id="dynamicSuggestionsDesktop" class="hidden"></div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>


                <!-- Desktop Icons -->
                <!-- Desktop Icons (مع زيادة المسافات) -->
                <div class="hidden md:flex items-center gap-3 lg:gap-4">
                    @await Component.InvokeAsync("CategoriesDropdown")

                    @if (isLoggedIn)
                    {
                        @await Component.InvokeAsync("WishlistDropdown")
                    }

                    @await Component.InvokeAsync("CartDropdown")

                    @if (isLoggedIn)
                    {
                        @await Component.InvokeAsync("Notification")
                    }

                    <!-- Theme Toggle -->
                    <button id="theme-toggle" class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                        <i class="fas fa-moon dark:hidden"></i>
                        <i class="fas fa-sun hidden dark:block"></i>
                    </button>

                    <partial name="_LoginPartialView" />
                </div>

                <!-- Mobile Buttons -->
                <div class="md:hidden flex items-center space-x-2 space-x-reverse">
                    <button id="search-toggle" class="nav-icon-btn-classic">
                        <i class="fas fa-search"></i>
                    </button>
                    <button id="theme-toggle-mobile" class="nav-icon-btn-classic">
                        <i class="fas fa-moon dark:hidden"></i>
                        <i class="fas fa-sun hidden dark:block"></i>
                    </button>
                    <button id="mobile-menu-button" class="nav-icon-btn-classic">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Search Bar -->
        <div id="mobile-search" class="hidden md:hidden bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 px-4 py-3">
            <form class="w-full relative" method="get" action="@Url.Action("Search", "Course", new { area = "Learner" })">
                <input type="text" name="search" id="mobileSearchInput" autocomplete="off" placeholder="@Localizer["SearchMobilePlaceholder"]"
                       class="w-full pr-10 pl-4 py-2.5 rounded-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                <button type="submit" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400">
                    <i class="fas fa-search"></i>
                </button>
                <div id="dynamicSuggestionsMobile" class="hidden absolute top-full left-0 right-0 mt-2 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 overflow-hidden z-50"></div>
            </form>
        </div>
    </header>
    <!-- Mobile Sidebar -->
    <div id="mobile-sidebar" class="mobile-sidebar fixed top-0 right-0 h-full w-80 bg-white dark:bg-gray-800 shadow-xl z-50 overflow-y-auto">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2 space-x-reverse">
                    <i class="fas fa-graduation-cap text-blue-600 dark:text-blue-400 text-2xl"></i>
                    @brandFirst<span class="text-blue-600 dark:text-blue-400">@brandSecond</span>
                </div>
                <button id="close-sidebar" class="text-gray-500 dark:text-gray-400 hover:text-red-500 p-2 rounded-full">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
        </div>
        <div class="p-4">
