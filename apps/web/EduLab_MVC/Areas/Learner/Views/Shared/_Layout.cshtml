            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dark .bn-search-result-title {
            color: #f3f4f6;
        }

        .bn-search-result-sub {
            font-size: 11px;
            color: #6b7280;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dark .bn-search-result-sub {
            color: #9ca3af;
        }

        .bn-empty-state {
            text-align: center;
            padding: 44px 20px;
            color: #9ca3af;
        }

        .bn-empty-state i {
            font-size: 36px;
            color: #d1d5db;
            margin-bottom: 12px;
            display: block;
        }

        .bn-empty-state p {
            font-size: 14px;
            font-weight: 600;
        }

        [dir="rtl"] .rtl-flip {
            transform: scaleX(-1);
        }

        /* النجوم النصفية: عكس الأيقونة في RTL بحيث يبقى الجزء المليان موجهاً للنجوم الممتلئة */
        [dir="rtl"] .fa-star-half-alt,
        [dir="rtl"] .fa-star-half-stroke {
            transform: scaleX(-1);
        }

        @@media (max-width: 767px) {
            footer {
                padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px));
            }
        }

        /* إخفاء الشريط على الشاشات الكبيرة (لا نعتمد على md:hidden) */
        @@media (min-width: 768px) {
            .mobile-bottom-nav {
                display: none !important;
            }
        }
    </style>
    <style>
        /* نظام الرسائل المحسن */
        .alert-container {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }
        [dir="rtl"] .alert-container {
            left: auto;
            right: 50%;
            transform: translateX(50%);
        }
        /* تحسينات للبحث في الموبايل */
        #mobile-search {
            transition: all 0.3s ease-in-out;
        }

            #mobile-search.hidden {
                display: none;
            }

            #mobile-search:not(.hidden) {
                display: block;
                animation: slideDown 0.3s ease-in-out;
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert {
            position: relative;
            width: 320px;
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            overflow: hidden;
            font-size: 0.95rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .alert.show {
                opacity: 1;
                transform: translateY(0);
            }

            .alert.hide {
                opacity: 0;
                transform: translateY(-20px);
            }

        .alert-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .alert-error {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .alert-info {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
        }
        .alert-warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }

        .alert-icon {
            margin-inline-end: 12px;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .alert-content {
            flex-grow: 1;
            line-height: 1.5;
            padding-inline-end: 8px;
            font-weight: 500;
        }

        .alert-close {
            background: none;
            border: none;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.8);
            transition: all 0.2s;
            flex-shrink: 0;
            font-size: 1rem;
            padding: 4px;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .alert-close:hover {
                color: white;
                background: rgba(255, 255, 255, 0.2);
            }

        .alert-progress {
            position: absolute;
            bottom: 0;
            inset-inline-start: 0;
            height: 3px;
            background-color: rgba(255, 255, 255, 0.3);
            width: 100%;
            border-radius: 0 0 12px 12px;
            overflow: hidden;
        }

        .alert-progress-bar {
            height: 100%;
            width: 100%;
            transition: width linear;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 0 0 12px 12px;
        }

        /* دعم الوضع الداكن */
        .dark .alert {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.05);
        }

        /* تصميم متجاوب */
        @@media (max-width: 640px) {
            .alert-container {
                width: calc(100% - 40px);
                left: 50%;
                transform: translateX(-50%);
                top: 15px;
            }
            [dir="rtl"] .alert-container {
                left: auto;
                right: 50%;
                transform: translateX(50%);
            }

            .alert {
                width: 100%;
                max-width: 100%;
            }
