@using System.Globalization
@using EduLab_MVC.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject EduLab_MVC.Services.ServiceInterfaces.ISiteSettingsService _siteSettings

@{
    var siteSettings = await _siteSettings.GetSettingsAsync();
    var siteName = siteSettings?.SiteName ?? "EduLab";
    var siteDescription = siteSettings?.SiteDescription ?? "";
    var nameLen = siteName.Length;
    var splitAt = (int)Math.Ceiling(nameLen / 2.0);
    var brandFirst = siteName.Substring(0, splitAt);
    var brandSecond = siteName.Substring(splitAt);
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isArabic = currentCulture.StartsWith("ar");
}

<!-- Footer - Modern Redesign -->
<footer class="bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800">
    <!-- Main Footer Content -->
    <div class="container mx-auto px-4 py-16">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-12">
        
            <!-- About & Social -->
            <div class="space-y-5 col-span-2 lg:col-span-1">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 flex items-center justify-center shadow-md">
                        <i class="fas fa-graduation-cap text-white text-xl"></i>
                    </div>
                    <span class="text-2xl font-extrabold text-gray-900 dark:text-white">
                        @brandFirst<span class="text-blue-600 dark:text-blue-400">@brandSecond</span>
                    </span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @(!string.IsNullOrEmpty(siteDescription) ? siteDescription : Localizer["AboutPlatform"].Value)
                </p>
                <div class="flex items-center gap-3 pt-2">
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-blue-600 hover:text-white transition-all duration-200 shadow-sm">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-blue-600 hover:text-white transition-all duration-200 shadow-sm">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-blue-600 hover:text-white transition-all duration-200 shadow-sm">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-blue-600 hover:text-white transition-all duration-200 shadow-sm">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-5 relative inline-block">
                    @Localizer["QuickLinks"]
                    <span class="absolute -bottom-2 left-0 w-12 h-1 bg-blue-600 dark:bg-blue-400 rounded-full"></span>
                </h3>
                <ul class="space-y-3 mt-4">
                    <li><a href="/" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs text-blue-500"></i> @Localizer["Home"]</a></li>
                    <li><a asp-controller="Course" asp-action="Index" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs text-blue-500"></i> @Localizer["Courses"]</a></li>
                    <li><a asp-controller="instructors" asp-action="Index" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs text-blue-500"></i> @Localizer["Instructors"]</a></li>
                    <li><a asp-controller="Home" asp-action="blog" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs text-blue-500"></i> @Localizer["Blog"]</a></li>
                    <li><a asp-controller="Home" asp-action="about" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs text-blue-500"></i> @Localizer["About"]</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-5 relative inline-block">
                    @Localizer["HelpCenter"]
                    <span class="absolute -bottom-2 left-0 w-12 h-1 bg-blue-600 dark:bg-blue-400 rounded-full"></span>
                </h3>
                <ul class="space-y-3 mt-4">
                    <li><a asp-controller="Home" asp-action="faq" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-question-circle text-blue-500 text-xs"></i> @Localizer["FAQ"]</a></li>
                    <li><a asp-controller="Home" asp-action="contact" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-headset text-blue-500 text-xs"></i> @Localizer["Contact"]</a></li>
                    <li><a asp-controller="Home" asp-action="privacy" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-shield-alt text-blue-500 text-xs"></i> @Localizer["Privacy"]</a></li>
                    <li><a asp-controller="Home" asp-action="terms" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-file-contract text-blue-500 text-xs"></i> @Localizer["Terms"]</a></li>
                    <li><a asp-controller="Home" asp-action="help" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-2 text-sm"><i class="fas fa-life-ring text-blue-500 text-xs"></i> @Localizer["Help"]</a></li>
                </ul>
            </div>

            <!-- Newsletter -->
            <div class="col-span-2 lg:col-span-1">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-5 relative inline-block">
                    @Localizer["Newsletter"]
                    <span class="absolute -bottom-2 left-0 w-12 h-1 bg-blue-600 dark:bg-blue-400 rounded-full"></span>
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-5 leading-relaxed">
                    @Localizer["NewsletterDesc"]
                </p>
                <form class="space-y-3">
                    <div class="relative">
                        <input type="email" placeholder="@Localizer["EmailPlaceholder"]"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                               style="padding-inline-end: 3rem;">
                        <button type="submit" class="absolute top-1/2 -translate-y-1/2 w-9 h-9 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition flex items-center justify-center"
                                style="inset-inline-end: 0.5rem;">
                            <i class="fas fa-paper-plane text-sm"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                        <i class="far fa-envelope me-1"></i> @Localizer["NewsletterHint"]
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-100 dark:border-gray-800">
        <div class="container mx-auto px-4 py-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="text-sm text-gray-500 dark:text-gray-400 text-center md:text-start">
                    <p>© @DateTime.Now.Year <span class="font-bold text-gray-700 dark:text-gray-300">@Localizer["SiteName"]</span>. @Localizer["AllRightsReserved"]</p>
                </div>
                <div class="flex items-center gap-5">
                    <img src="~/Img/brands/Visa.png" alt="Visa" class="h-6 opacity-60 hover:opacity-100 transition">
                    <img src="~/Img/brands/Mastercard.png" alt="Mastercard" class="h-6 opacity-60 hover:opacity-100 transition">
                    <img src="~/Img/brands/PayPal.png" alt="PayPal" class="h-6 opacity-60 hover:opacity-100 transition">
                    <img src="~/Img/brands/Stripe.png" alt="Stripe" class="h-6 opacity-60 hover:opacity-100 transition">
                </div>
            </div>
        </div>
    </div>
</footer>
