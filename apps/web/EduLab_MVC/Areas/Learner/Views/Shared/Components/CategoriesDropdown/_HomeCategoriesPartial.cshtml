@using System.Globalization
@using EduLab_MVC.Common
@model List<EduLab_MVC.Models.DTOs.Category.CategoryDTO>
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
    @if (Model != null && Model.Any())
    {
        @foreach (var category in Model)
        {
            var color = GetCategoryColor(category.Category_Name);
            var iconClass = GetCategoryIcon(category.Category_Name);

            <a href="@Url.Action("ByCategory", "Course", new { id = category.Category_Id })"
                   class="group relative p-1 rounded-[2rem] transition-all duration-500 hover:-translate-y-2">
                
                <div class="relative bg-white dark:bg-gray-800/50 backdrop-blur-md border border-gray-100 dark:border-white/10 rounded-[1.8rem] p-4 md:p-6 h-full shadow-sm group-hover:shadow-xl transition-all duration-500 overflow-hidden @CategoryBorder[color]">
                    
                    <div class="absolute -top-10 -right-10 w-24 h-24 blur-2xl transition-all duration-500 @CategoryGlow[color]"></div>

                    <div class="relative z-10 flex flex-col items-center text-center">
                        <div class="w-14 h-14 md:w-16 md:h-16 mb-3 md:mb-4 rounded-2xl flex items-center justify-center transform group-hover:rotate-[10deg] transition-transform duration-500 shadow-inner @CategoryIconBox[color]">
                            <i class="fas @iconClass text-xl md:text-2xl"></i>
                        </div>

                        <h3 class="font-bold text-gray-800 dark:text-white transition-colors duration-300 line-clamp-1 text-sm md:text-base @CategoryTitleHover[color]">
                            @(isArabic || string.IsNullOrEmpty(category.Category_EnglishName) ? category.Category_Name : category.Category_EnglishName)
                        </h3>

                        <span class="mt-3 px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 text-[10px] font-bold uppercase tracking-wider rounded-full transition-all duration-500 group-hover:text-white @CategoryBadge[color]">
                            @(category.CoursesCount) @Localizer["CourseUnit"]
                        </span>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div class="col-span-full py-12 flex flex-col items-center justify-center border-2 border-dashed border-gray-200 dark:border-white/5 rounded-[2.5rem] bg-gray-50/50 dark:bg-transparent">
            <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-4">
                <i class="fas fa-th-large text-2xl text-gray-400"></i>
            </div>
            <p class="text-gray-500 dark:text-gray-400 font-medium">@Localizer["NoCategoriesAvailable"]</p>
        </div>
    }
</div>

