@using System.Globalization
@using EduLab_MVC.Models.DTOs.Category
@using EduLab_MVC.Common
@model List<CategoryDTO>
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}

<style>
    .categories-dropdown-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #374151;
        padding: 8px 12px;
        border-radius: 12px;
        transition: all 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        font-weight: 500;
        font-size: 14px;
    }

    .dark .categories-dropdown-btn {
        color: #e5e7eb;
    }

        .categories-dropdown-btn:hover {
            background: #f3f4f6;
        }

    .dark .categories-dropdown-btn:hover {
        background: #374151;
    }

    .categories-dropdown-content {
        top: 110%;
        margin-top: 2px;
        width: 580px;
        right: -50px;
        padding: 1.25rem;
        border-radius: 1.5rem;
        background: white;
        border: 1px solid #e5e7eb;
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.1);
    }

    .dark .categories-dropdown-content {
        background: #1f2937;
        border-color: #374151;
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.3);
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .category-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid #f0f0f0;
        transition: all 0.2s ease;
    }

    .dark .category-card {
        background: #1e293b;
        border-color: #334155;
    }

    .category-card:hover {
        background: white;
        border-color: #3b82f6;
        box-shadow: 0 6px 12px -6px rgba(59, 130, 246, 0.2);
        transform: translateY(-2px);
    }

    .dark .category-card:hover {
        background: #111827;
        border-color: #3b82f6;
    }

    .category-icon-bg {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .category-info h4 {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 2px;
        color: #1e293b;
    }

    .dark .category-info h4 {
        color: #f1f5f9;
    }

    .category-info p {
        font-size: 0.75rem;
        color: #64748b;
    }

    .dark .category-info p {
        color: #94a3b8;
    }

    @@media (max-width: 640px) {
        .categories-dropdown-content {
            width: 320px;
            right: -20px;
        }

        .category-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="relative dropdown" id="categories-dropdown">
    <button class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 p-2 dropdown-toggle rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition flex items-center">
        <i class="fas fa-th-large text-xl me-2 ms-2"></i>
        <span>@Localizer["Categories"]</span>
    </button>

    <div class="dropdown-content categories-dropdown-content">
        <div class="category-grid">
            @foreach (var category in Model)
            {
                var bgColor = GetCategoryBgColor(category.Category_Name);
                var textColor = GetCategoryTextColor(category.Category_Name);
                <a asp-controller="Course" asp-action="ByCategory" asp-route-id="@category.Category_Id"
                       class="category-card">
                    <div class="category-icon-bg @bgColor">
                        <i class="fas @GetCategoryIcon(category.Category_Name) @textColor text-lg"></i>
                    </div>
                    <div class="category-info">
                        <h4>@(isArabic || string.IsNullOrEmpty(category.Category_EnglishName) ? category.Category_Name : category.Category_EnglishName)</h4>
                        <p>@(category.CoursesCount)+ @Localizer["CourseUnit"]</p>
                    </div>
                </a>
            }
        </div>

        <div class="mt-5 text-center">
            <a asp-controller="Course" asp-action="Index"
                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-xl text-sm font-medium hover:bg-blue-100 dark:hover:bg-blue-900/50 transition">
                <span>@Localizer["ViewAllCategories"]</span>
                <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-xs"></i>
            </a>
        </div>
    </div>
</div>

@functions {
    public string GetCategoryBgColor(string categoryName) => CategoryVisualHelper.GetCategoryBgColor(categoryName);
    public string GetCategoryTextColor(string categoryName) => CategoryVisualHelper.GetCategoryTextColor(categoryName);
    public string GetCategoryIcon(string categoryName) => CategoryVisualHelper.GetCategoryIcon(categoryName);
    public string GetCategoryColor(string categoryName) => CategoryVisualHelper.GetCategoryTextClass(categoryName);
}

