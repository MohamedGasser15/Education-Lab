@using System.Globalization
@using EduLab_MVC.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject EduLab_MVC.Services.ServiceInterfaces.ICurrencyService CurrencyService

@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isArabic = currentCulture.StartsWith("ar");
    var currentCurr = CurrencyService.GetCurrentCurrency();
    var mCurrent = currentCurr;
    var mCurrs = CurrencyService.GetSupportedCurrencies();
    var arabCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "EGP", "SAR", "AED", "KWD", "QAR", "BHD", "OMR", "JOD", "MAD", "DZD", "TND", "LYD", "IQD", "LBP", "SDG" };
}

<!-- Sleek Horizontal Rectangle Currency Selection Modal -->
<div id="currencyModal" class="fixed inset-0 z-[99999] hidden items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true">
    <!-- Backdrop with smooth fade -->
    <div id="currencyModalBackdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-md opacity-0 transition-opacity duration-300 ease-out" onclick="closeCurrencyModal()"></div>

    <!-- Wide Rectangle Dialog Container (max-w-4xl) -->
    <div id="currencyModalDialog" class="relative w-full max-w-4xl rounded-3xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-7 z-10 opacity-0 scale-95 translate-y-3 transition-all duration-300 ease-out max-h-[88vh] flex flex-col overflow-hidden">
        
        <!-- Top Bar: Title, Subtitle, & Close Button -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800/80 shrink-0">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500/10 to-indigo-500/10 dark:from-blue-500/20 dark:to-indigo-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl font-bold border border-blue-500/20 shadow-xs">
                    <i class="fas fa-coins"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-lg font-black text-slate-900 dark:text-white tracking-tight">
                            @Localizer["SelectCurrency"]
                        </h3>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">
                            @currentCurr.Code
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        @Localizer["SelectCurrencyDesc"]
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeCurrencyModal()" class="w-9 h-9 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white flex items-center justify-center transition-all cursor-pointer shadow-2xs" aria-label="Close">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Controls: Search Input + Category Filter Pills -->
        <div class="pt-4 pb-3 space-y-3 shrink-0">
            <div class="relative">
                <i class="fas fa-search absolute start-4 top-3.5 text-slate-400 text-sm"></i>
                <input type="text" id="modalCurrencySearch"
                       placeholder="@Localizer["SearchCurrencyPlaceholder"]"
                       class="w-full ps-11 pe-10 py-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all shadow-inner"
                       oninput="filterModalCurrencies()">
                <button type="button" id="clearCurrencySearch" onclick="clearModalSearch()" class="hidden absolute end-3.5 top-3 text-slate-400 hover:text-slate-600 dark:hover:text-white transition">
                    <i class="fas fa-times-circle text-sm"></i>
                </button>
            </div>

            <!-- Region Filter Tabs -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
                <button type="button" onclick="setCurrencyCategory('all', this)" class="currency-cat-btn active-cat px-3 py-1.5 rounded-xl font-bold transition-all bg-blue-600 text-white shadow-xs">
                    @Localizer["AllCurrencies"]
                </button>
                <button type="button" onclick="setCurrencyCategory('arab', this)" class="currency-cat-btn px-3 py-1.5 rounded-xl font-bold transition-all bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300">
                    🇪🇬 @Localizer["ArabAndGulfCurrencies"]
                </button>
                <button type="button" onclick="setCurrencyCategory('global', this)" class="currency-cat-btn px-3 py-1.5 rounded-xl font-bold transition-all bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300">
                    🌍 @Localizer["GlobalCurrencies"]
                </button>
            </div>
        </div>

        <!-- Currencies 3-Column Landscape Grid -->
        <div class="overflow-y-auto pe-1 flex-1 min-h-[260px] custom-scrollbar" id="modalCurrenciesScrollArea">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 pb-2" id="modalCurrenciesGrid">
                @foreach (var c in mCurrs)
                {
                    var isSel = c.Code.Equals(mCurrent.Code, StringComparison.OrdinalIgnoreCase);
                    var isArab = arabCodes.Contains(c.Code);
                    <a asp-controller="Home" asp-action="SetCurrency" asp-route-currency="@c.Code" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       data-cat="@(isArab ? "arab" : "global")"
                       data-search="@c.Code.ToLower() @c.Name.ToLower() @c.NameAr.ToLower() @c.SymbolEn.ToLower() @c.SymbolAr.ToLower()"
                       class="modal-currency-item group/card flex items-center justify-between p-3 rounded-2xl border transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md cursor-pointer @(isSel ? "bg-gradient-to-r from-blue-50/90 to-indigo-50/60 dark:from-blue-950/60 dark:to-indigo-950/40 border-blue-500 dark:border-blue-500/80 text-blue-600 dark:text-blue-400 font-bold shadow-xs ring-1 ring-blue-500/30" : "bg-white dark:bg-slate-800/60 border-slate-200/70 dark:border-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-slate-300 dark:hover:border-slate-700 text-slate-800 dark:text-slate-200")">
                        
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="text-2xl shrink-0 transition-transform group-hover/card:scale-110">@c.FlagEmoji</span>
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-black text-sm tracking-wide @(isSel ? "text-blue-600 dark:text-blue-400" : "text-slate-900 dark:text-white")">@c.Code</span>
                                    <span class="text-xs text-slate-500 dark:text-slate-400 truncate font-medium">@c.GetDisplayName(isArabic)</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0 ps-2">
                            @{
                                var sym = c.GetSymbol(isArabic);
                                var isDistinctSymbol = !string.Equals(sym, c.Code, StringComparison.OrdinalIgnoreCase);
                            }
                            @if (isDistinctSymbol)
                            {
                                <span class="text-xs font-bold px-2 py-0.5 rounded-lg border font-mono transition-colors @(isSel ? "bg-blue-600 text-white border-blue-600" : "bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                                    @sym
                                </span>
                            }
                            @if (isSel)
                            {
                                <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] shadow-2xs">
                                    <i class="fas fa-check"></i>
                                </span>
                            }
                        </div>
                    </a>
                }
            </div>
            <div id="noCurrenciesMsg" class="hidden text-center py-12 text-slate-400 text-xs font-medium">
                <i class="fas fa-search text-2xl mb-2 block opacity-40"></i>
                @(isArabic ? "لم يتم العثور على أي عملة مطابقة لبحثك" : "No matching currencies found")
            </div>
        </div>

        <!-- Footer: Quick active status info -->
        <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 shrink-0">
            <span>@(isArabic ? "العملة الحالية:" : "Current:") <b class="text-slate-700 dark:text-slate-300">@currentCurr.FlagEmoji @currentCurr.Code (@currentCurr.GetDisplayName(isArabic))</b></span>
            <span class="font-medium">@mCurrs.Count @(isArabic ? "عملة متاحة" : "currencies supported")</span>
        </div>
    </div>
</div>

<script>
    var _currCategory = 'all';

    function openCurrencyModal() {
        var modal = document.getElementById('currencyModal');
        var backdrop = document.getElementById('currencyModalBackdrop');
        var dialog = document.getElementById('currencyModalDialog');
        if (modal && backdrop && dialog) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(function() {
                backdrop.classList.remove('opacity-0');
                backdrop.classList.add('opacity-100');
                dialog.classList.remove('opacity-0', 'scale-95', 'translate-y-3');
                dialog.classList.add('opacity-100', 'scale-100', 'translate-y-0');
            });
            setTimeout(function() {
                var input = document.getElementById('modalCurrencySearch');
                if (input) input.focus();
            }, 150);
        }
    }

    function closeCurrencyModal() {
        var modal = document.getElementById('currencyModal');
        var backdrop = document.getElementById('currencyModalBackdrop');
        var dialog = document.getElementById('currencyModalDialog');
        if (modal && backdrop && dialog) {
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
            dialog.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
            dialog.classList.add('opacity-0', 'scale-95', 'translate-y-3');
            setTimeout(function() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            }, 250);
        }
    }

    function setCurrencyCategory(cat, btn) {
        _currCategory = cat;
        document.querySelectorAll('.currency-cat-btn').forEach(function(b) {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-xs', 'active-cat');
            b.classList.add('bg-slate-100', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-300');
        });
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs', 'active-cat');
        btn.classList.remove('bg-slate-100', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-300');
        filterModalCurrencies();
    }

    function filterModalCurrencies() {
        var searchInput = document.getElementById('modalCurrencySearch');
        var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var clearBtn = document.getElementById('clearCurrencySearch');
        if (clearBtn) clearBtn.classList.toggle('hidden', !query);

        var items = document.querySelectorAll('#modalCurrenciesGrid .modal-currency-item');
        var visibleCount = 0;

        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            var searchData = item.getAttribute('data-search') || '';
            var catData = item.getAttribute('data-cat') || '';

            var matchesCategory = (_currCategory === 'all') || (catData === _currCategory);
            var matchesQuery = !query || searchData.indexOf(query) !== -1;

            if (matchesCategory && matchesQuery) {
                item.style.display = 'flex';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        }

        var noMsg = document.getElementById('noCurrenciesMsg');
        if (noMsg) noMsg.classList.toggle('hidden', visibleCount > 0);
    }

    function clearModalSearch() {
        var input = document.getElementById('modalCurrencySearch');
        if (input) {
            input.value = '';
            input.focus();
            filterModalCurrencies();
        }
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeCurrencyModal();
    });
</script>
