@using System.Globalization
@using EduLab_MVC.Services.ServiceInterfaces
@using EduLab_MVC.Common;
@using EduLab_MVC.Resources
@using Microsoft.Extensions.Localization
@inject IUserService _userService
@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResources> Localizer

@{
    var user = await _userService.GetCurrentUserAsync();
    var token = Context.Request.Cookies["AuthToken"];
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var fullName = user?.FullName ?? Localizer["User"].Value;
    var role = user?.Role;
    var profileImage = user?.ProfileImageUrl;
    var baseUrl = Configuration["ApiBaseUrl"];

    bool hasAdminClaim()
    {
        foreach (var claim in User.Claims)
        {
            if (Array.IndexOf(AdminClaims.All, claim.Type) >= 0)
                return true;
        }
        return false;
    }

    if (!string.IsNullOrEmpty(profileImage) && !profileImage.StartsWith("http"))
    {
        profileImage = baseUrl.TrimEnd('/') + "/" + profileImage.TrimStart('/');
    }

    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var languages = new List<(string Name, string Code)>
    {
        ("English", "en"),
        ("العربية", "ar"),
        ("中文", "zh"),
        ("Nederlands", "nl"),
        ("Français", "fr"),
        ("Deutsch", "de"),
        ("हिन्दी", "hi"),
        ("Bahasa Indonesia", "id"),
        ("Italiano", "it"),
        ("日本語", "ja"),
        ("한국어", "ko"),
        ("Bahasa Melayu", "ms"),
        ("Português (Brasil)", "pt"),
        ("Русский", "ru"),
        ("Español", "es"),
        ("Tiếng Việt", "vi"),
        ("Türkçe", "tr"),
        ("Українська", "uk"),
        ("اردو", "ur"),
        ("Polski", "pl")
    };
}

<style>
    /* ========== LOGIN PARTIAL BASE STYLES ========== */
    .user-profile-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 8px 4px 12px;
        background: transparent;
        border-radius: 40px;
        transition: all 0.2s;
        cursor: pointer;
    }

        .user-profile-btn:hover {
            background: #f3f4f6;
        }

    .dark .user-profile-btn:hover {
        background: #374151;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .dark .user-avatar {
        border-color: #374151;
    }

    .user-name {
        font-weight: 600;
        font-size: 14px;
        color: #1f2937;
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dark .user-name {
        color: #f3f4f6;
    }

    .user-dropdown {
        position: absolute;
        top: calc(100% + 12px);
        left: auto;
        right: 0;
        width: 260px;
        max-width: calc(100vw - 2.5rem);
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 35px -8px rgba(0,0,0,0.15);
        border: 1px solid #f0f0f0;
        overflow: hidden;
        z-index: 100;
        padding: 8px;
        animation: userDdPop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes userDdPop {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    [dir="rtl"] .user-dropdown {
        right: auto;
        left: 0;
    }

    .dark .user-dropdown {
        background: #1f2937;
        border-color: #374151;
        box-shadow: 0 20px 35px -8px rgba(0,0,0,0.5);
    }

    .user-dropdown-header {
        padding: 16px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dark .user-dropdown-header {
        border-bottom-color: #374151;
    }

    .user-dropdown-avatar {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        border: 2px solid #e5e7eb;
    }

    .dark .user-dropdown-avatar {
        border-color: #4b5563;
    }

    .user-dropdown-info h4 {
        font-weight: 700;
        color: #111827;
        font-size: 15px;
        word-break: break-word;
        max-width: 150px;
    }

    .dark .user-dropdown-info h4 {
        color: white;
    }

    .user-dropdown-info p {
        font-size: 13px;
        color: #6b7280;
    }

    .dark .user-dropdown-info p {
        color: #9ca3af;
    }

    .user-dropdown-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        color: #374151;
        font-size: 14px;
        font-weight: 500;
        border-radius: 12px;
        margin: 2px 0;
        transition: background 0.15s, padding-inline-start 0.15s, color 0.15s;
    }

    .dark .user-dropdown-item {
        color: #e5e7eb;
    }

    .user-dropdown-item:hover {
        background: #f3f4f6;
        padding-inline-start: 18px;
    }

    .dark .user-dropdown-item:hover {
        background: #2d3748;
    }

    .user-dropdown-item i {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: #f3f4f6;
        color: #6b7280;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 13px;
        transition: all 0.15s;
    }

    .dark .user-dropdown-item i {
        background: #2d3748;
        color: #9ca3af;
    }

    .user-dropdown-item:hover i {
        background: #eff6ff;
        color: #2563eb;
    }

    .dark .user-dropdown-item:hover i {
        background: #1e3a5f;
        color: #60a5fa;
    }

    .user-dropdown-divider {
        height: 1px;
        background: #f3f4f6;
        margin: 6px 0;
    }

    .dark .user-dropdown-divider {
        background: #374151;
    }

    .logout-btn {
        color: #dc2626 !important;
    }

        .logout-btn i {
            color: #dc2626 !important;
        }

    /* Mobile Menu Card */
    .mobile-menu-card {
        background: transparent;
        border-radius: 0;
        padding: 0;
        margin: 0;
        box-shadow: none;
    }

    .mobile-user-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #eef2f7;
        border-radius: 20px;
    }

    .dark .mobile-user-header {
        background: #1e293b;
        border-color: #334155;
    }

    .mobile-avatar {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        border: 3px solid #fff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        flex-shrink: 0;
    }

    .dark .mobile-avatar {
        border-color: #1e293b;
    }

    .role-chip {
        display: inline-block;
        margin-top: 5px;
        padding: 3px 12px;
        border-radius: 999px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 11px;
        font-weight: 700;
    }

    .dark .role-chip {
        background: #1e3a5f;
        color: #93c5fd;
    }

    /* Guest Mobile Menu */
    .guest-hero {
        text-align: center;
        padding: 26px 16px 22px;
        background: linear-gradient(135deg, #eff6ff, #f0fdf4);
        border: 1px solid #e0edff;
        border-radius: 20px;
        margin-bottom: 18px;
    }

    .dark .guest-hero {
        background: #1e293b;
        border-color: #334155;
    }

    .guest-hero-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 12px;
        border-radius: 20px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: white;
        font-size: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.45);
    }

    .guest-hero h3 {
        font-weight: 800;
        font-size: 18px;
        color: #111827;
        margin: 0;
    }

    .dark .guest-hero h3 {
        color: #fff;
    }

    .guest-hero p {
        font-size: 13px;
        color: #6b7280;
        margin-top: 5px;
        margin-bottom: 0;
    }

    .dark .guest-hero p {
        color: #9ca3af;
    }

    .guest-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 13px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 15px;
        margin-bottom: 10px;
        transition: all 0.2s;
        text-decoration: none;
    }

    .guest-btn:active {
        transform: scale(0.97);
    }

    .guest-btn-login {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .dark .guest-btn-login {
        background: #1e3a5f;
        color: #93c5fd;
        border-color: #1e3a5f;
    }

    .guest-btn-login:hover {
        background: #dbeafe;
    }

    .dark .guest-btn-login:hover {
        background: #1e4a75;
    }

    .guest-btn-register {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: white;
        box-shadow: 0 8px 18px -6px rgba(37, 99, 235, 0.45);
    }

    .guest-btn-register:hover {
        background: linear-gradient(135deg, #1d4ed8, #2563eb);
        transform: translateY(-1px);
    }

    .guest-links {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #e5e7eb;
    }

    .dark .guest-links {
        border-top-color: #334155;
    }

    .guest-links a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 12px;
        border-radius: 12px;
        color: #4b5563;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.15s;
        text-decoration: none;
    }

    .dark .guest-links a {
        color: #9ca3af;
    }

    .guest-links a:hover {
        background: #f3f4f6;
    }

    .dark .guest-links a:hover {
        background: #1f2937;
    }

    .guest-links a i {
        color: #2563eb;
        width: 20px;
    }

    /* Logged-in Mobile Menu Items */
    .m-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 10px;
        border-radius: 14px;
        color: #374151;
        font-weight: 500;
        font-size: 14px;
        transition: background 0.15s, transform 0.15s;
        text-decoration: none;
        width: 100%;
        border: none;
        background: none;
        cursor: pointer;
        font-family: inherit;
        text-align: start;
    }

    .dark .m-nav-item {
        color: #e5e7eb;
    }

    .m-nav-item:hover {
        background: #f3f4f6;
    }

    .dark .m-nav-item:hover {
        background: #1f2937;
    }

    .m-nav-item:active {
        transform: scale(0.98);
    }

    .m-nav-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        transition: all 0.15s;
    }

    .dark .m-nav-icon {
        background: #1e3a5f;
        color: #93c5fd;
    }

    .m-nav-item:hover .m-nav-icon {
        background: #2563eb;
        color: white;
    }

    .dark .m-nav-item:hover .m-nav-icon {
        background: #3b82f6;
    }

    .m-nav-item.logout {
        color: #dc2626;
    }

    .m-nav-item.logout .m-nav-icon {
        background: #fef2f2;
        color: #dc2626;
    }

    .dark .m-nav-item.logout .m-nav-icon {
        background: #451a1a;
        color: #f87171;
    }

    .m-nav-item.logout:hover {
        background: #fef2f2;
    }

    .dark .m-nav-item.logout:hover {
        background: #451a1a;
    }

    .m-nav-item.logout:hover .m-nav-icon {
        background: #dc2626;
        color: white;
    }

    .dark .m-nav-item.logout:hover .m-nav-icon {
        background: #ef4444;
    }

    /* Guest Buttons */
    .login-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 14px;
        color: #374151;
        background: transparent;
        border: 1px solid #e5e7eb;
        transition: all 0.2s;
        white-space: nowrap;
        text-decoration: none;
    }

    .dark .login-btn {
        color: #e5e7eb;
        border-color: #4b5563;
    }

    .login-btn:hover {
        background: #f3f4f6;
        border-color: #d1d5db;
    }

    .dark .login-btn:hover {
        background: #374151;
    }

    .login-btn:active {
        transform: scale(0.96);
    }

    .register-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 14px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: white;
        box-shadow: 0 4px 10px -2px rgba(37, 99, 235, 0.4);
        transition: all 0.2s;
        white-space: nowrap;
        text-decoration: none;
    }

        .register-btn:hover {
            background: linear-gradient(135deg, #1d4ed8, #2563eb);
            transform: translateY(-1px);
            box-shadow: 0 8px 14px -4px rgba(37, 99, 235, 0.5);
        }

        .register-btn:active {
            transform: scale(0.96);
        }

    /* ========== RESPONSIVE ADJUSTMENTS ========== */
    @@media (max-width: 640px) {
        .user-dropdown {
            width: 240px;
            right: 0;
            left: auto;
        }

        .user-dropdown-header {
            padding: 14px;
        }

        .user-dropdown-avatar {
            width: 44px;
            height: 44px;
        }

        .user-dropdown-info h4 {
            font-size: 14px;
        }

        .user-dropdown-item {
            padding: 10px 14px;
            font-size: 13px;
        }

        .user-name {
            max-width: 80px;
        }

        .login-btn, .register-btn {
            padding: 6px 14px;
            font-size: 13px;
        }
    }

    @@media (max-width: 480px) {
        .user-profile-btn {
            gap: 6px;
            padding: 2px 6px 2px 8px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
        }

        .user-name {
            display: none; /* نخفي الاسم في الشاشات الصغيرة جداً ونعتمد فقط على الصورة */
        }

        .mobile-user-header {
            padding: 14px;
        }

        .mobile-avatar {
            width: 52px;
            height: 52px;
        }
    }

    /* للشاشات الكبيرة جداً (أجهزة سطح المكتب العريضة) */
    @@media (min-width: 1280px) {
        .user-name {
            max-width: 160px;
        }

        .user-dropdown {
            width: 280px;
        }
    }

    /* تحسين ظهور القائمة على أجهزة iPad والأجهزة اللوحية */
    @@media (min-width: 768px) and (max-width: 1024px) {
        .user-dropdown {
            width: 250px;
        }
    }

    /* Language Modal */
    .language-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .language-modal-overlay.active {
        display: flex;
    }

    .language-modal-box {
        background: white;
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 560px;
        overflow: hidden;
        animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .dark .language-modal-box {
        background: #1f2937;
    }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .language-modal-title {
        padding: 18px 20px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        border-bottom: 1px solid #f3f4f6;
    }

    .dark .language-modal-title {
        color: white;
        border-bottom-color: #374151;
    }

    .language-modal-close {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #6b7280;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .dark .language-modal-close {
        background: #374151;
        color: #d1d5db;
    }

    .language-modal-close:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .language-modal-list {
        padding: 12px;
        max-height: 380px;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
    }

    .language-option {
        display: block;
        padding: 10px 4px;
        text-align: center;
        border-radius: 10px;
        color: #374151;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.15s;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dark .language-option {
        color: #e5e7eb;
    }

    .language-option:hover {
        background: #f3f4f6;
    }

    .dark .language-option:hover {
        background: #374151;
    }

    .language-option.active {
        background: #eff6ff;
        color: #2563eb;
        font-weight: 700;
    }

    .dark .language-option.active {
        background: #1e3a5f;
        color: #60a5fa;
    }

    @@media (max-width: 767px) {
        .language-modal-overlay {
            align-items: flex-end;
            padding: 0;
        }

        .language-modal-box {
            max-width: 100%;
            max-height: 78vh;
            display: flex;
            flex-direction: column;
            border-radius: 24px 24px 0 0;
            animation: langSheetUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }

        .language-modal-list {
            flex: 1;
            max-height: none;
            overflow-y: auto;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            padding: 14px 14px 20px;
        }

        .language-option {
            font-size: 13px;
            padding: 12px 4px;
            border-radius: 12px;
        }
    }

    @@keyframes langSheetUp {
        from {
            transform: translateY(100%);
        }

        to {
            transform: translateY(0);
        }
    }
</style>

@if (isLoggedIn)
{
    <!-- Desktop User Menu -->
    <div class="relative dropdown  hidden md:block">
        <div class="user-profile-btn dropdown-toggle">
            <div class="user-avatar">
                <img src="@(string.IsNullOrEmpty(profileImage) ? Url.Content("~/img/User Logo.png") : profileImage)"
                     class="w-full h-full object-cover" alt="User">
            </div>
            <span class="user-name">@fullName</span>
            <i class="fas fa-chevron-down text-gray-400 text-xs"></i>
        </div>

        <div class="dropdown-content user-dropdown">
            <div class="user-dropdown-header">
                <img src="@(string.IsNullOrEmpty(profileImage) ? Url.Content("~/img/User Logo.png") : profileImage)"
                     class="user-dropdown-avatar object-cover" alt="User">
                <div class="user-dropdown-info">
                    <h4>@fullName</h4>
                    <p>@role</p>
                </div>
            </div>

            <div class="py-2">
                @if (hasAdminClaim())
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="user-dropdown-item">
                        <i class="fas fa-tachometer-alt"></i> @Localizer["AdminDashboard"]
                    </a>
                    <a asp-area="Learner" asp-controller="Profile" asp-action="Index" class="user-dropdown-item">
                        <i class="fas fa-user"></i> @Localizer["Profile"]
                    </a>
                }
                else if (role == SD.Instructor)
                {
                    <a href="/Instructor/Dashboard/Index" class="user-dropdown-item">
                        <i class="fas fa-chalkboard-teacher"></i> @Localizer["InstructorDashboard"]
                    </a>
                    <a asp-area="Learner" asp-controller="Profile" asp-action="Instructor" class="user-dropdown-item">
                        <i class="fas fa-user"></i> @Localizer["Profile"]
                    </a>
                }
                else if (role == SD.Student)
                {
                    <a asp-area="Learner" asp-controller="Profile" asp-action="Index" class="user-dropdown-item">
                        <i class="fas fa-user"></i> @Localizer["Profile"]
                    </a>
                    <a asp-area="Learner" asp-controller="InstructorApplication" asp-action="Apply" class="user-dropdown-item">
                        <i class="fas fa-file-signature"></i> @Localizer["ApplyAsInstructor"]
                    </a>
                }
                @if (role == SD.InstructorPending)
                {
                    <a asp-area="Learner" asp-controller="Profile" asp-action="Index" class="user-dropdown-item">
                        <i class="fas fa-user"></i> @Localizer["Profile"]
                    </a>
                    <a asp-area="Learner" asp-controller="InstructorApplication" asp-action="MyApplications" class="user-dropdown-item">
                        <i class="fas fa-file-alt"></i> @Localizer["MyApplications"]
                    </a>
                }

                <a asp-area="Learner" asp-controller="MyLearning" asp-action="Index" class="user-dropdown-item">
                    <i class="fas fa-book-open"></i> @Localizer["MyCourses"]
                </a>

