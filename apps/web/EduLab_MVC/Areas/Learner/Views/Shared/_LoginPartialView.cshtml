                </button>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="m-nav-item logout">
                        <i class="fas fa-sign-out-alt m-nav-icon"></i> @Localizer["Logout"]
