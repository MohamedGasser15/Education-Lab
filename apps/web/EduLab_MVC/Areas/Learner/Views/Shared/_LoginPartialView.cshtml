            <a asp-controller="Auth" asp-action="Login" class="guest-btn guest-btn-login">
                <i class="fas fa-sign-in-alt"></i> @Localizer["Login"]
            </a>
            <a asp-controller="Auth" asp-action="Register" class="guest-btn guest-btn-register">
                <i class="fas fa-user-plus"></i> @Localizer["Register"]
