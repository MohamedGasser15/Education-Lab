    /* Enhanced, snappy course card hover info */
    .course-hover-info {
        position: absolute;
        top: 0;
        width: 320px;
        min-height: 100%;
        background: white;
        border-radius: 0.875rem;
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.15), 0 10px 15px -5px rgba(0, 0, 0, 0.08);
        padding: 1.25rem;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        z-index: 60;
        border: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        overflow: visible !important;
        cursor: default;
        transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, 
                    transform 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, 
                    visibility 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
        will-change: opacity, transform;
    }

    .dark .course-hover-info {
        background: #1f2937;
        border-color: #374151;
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.6), 0 10px 15px -5px rgba(0, 0, 0, 0.4);
    }

    /* Invisible hover bridge to eliminate the gap between card and tooltip */
    .course-hover-bridge {
        position: absolute;
        top: -10px;
        bottom: -10px;
        width: 28px;
        pointer-events: auto;
        z-index: 10;
        background: transparent;
    }

    /* ========== DEFAULT TOOLTIP POSITIONING (RTL vs LTR) ========== */
    /* In RTL: Default is on the LEFT of the card */
    html[dir="rtl"] .course-hover-info,
    [dir="rtl"] .course-hover-info,
    [dir=rtl] .course-hover-info,
    .course-hover-info.pos-left,
    .course-hover-info.force-left {
        right: calc(100% + 14px);
        left: auto;
        transform: translateX(6px);
