        border-color: rgba(159, 18, 57, 0.6) !important;
    }

    .course-card-wrapper:hover {
        z-index: 35;
    }

    /* Wishlist button tooltip - positioned as original (below button) with elevated z-index */
    .wishlist-btn[data-tooltip]::after {
        content: attr(data-tooltip);
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: #111827;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
        padding: 5px 10px;
        border-radius: 6px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
        z-index: 9999;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .dark .wishlist-btn[data-tooltip]::after {
        background: #1f2937;
        color: #f3f4f6;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    }

    .wishlist-btn[data-tooltip]::before {
        content: '';
        position: absolute;
        top: calc(100% + 3px);
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-bottom-color: #111827;
        border-top-color: transparent;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
        z-index: 9999;
    }

    .dark .wishlist-btn[data-tooltip]::before {
        border-bottom-color: #1f2937;
    }

    .wishlist-btn[data-tooltip]:hover::after,
    .wishlist-btn[data-tooltip]:hover::before,
    .wishlist-btn[data-tooltip]:focus::after,
    .wishlist-btn[data-tooltip]:focus::before,
    .wishlist-btn[data-tooltip]:active::after,
    .wishlist-btn[data-tooltip]:active::before {
        opacity: 1;
        visibility: visible;
    }

    @@keyframes wishlistPulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.3);
        }

        100% {
            transform: scale(1);
        }
    }

    .wishlist-pulse {
        animation: wishlistPulse 0.4s ease-in-out;
    }
</style>

<!-- Display in the regular grid mode -->
<div class="swiper-slide">
    <div class="w-full h-full">
        <div class="course-card-wrapper relative group h-full cursor-pointer">
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-2 group h-full flex flex-col relative" onclick="window.location='@Url.Action("Details", "Course", new { area = "Learner", id = Model.Id })'">
                <div class="relative overflow-hidden rounded-t-xl">
                    <img src="@Model.ThumbnailUrl" alt="@Model.Title" loading="lazy" decoding="async" class="w-full h-40 object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-60"></div>

                    @if (showBadges)
                    {
                        <div class="course-badges">
                            @if (isFeatured)
                            {
                                <span class="course-badge badge-featured">
                                    <i class="fas fa-crown me-1"></i> @Localizer["Featured"]
                                </span>
                            }
                            @if (isNew)
                            {
                                <span class="course-badge badge-new">
                                    <i class="fas fa-bolt me-1"></i> @Localizer["New"]
                                </span>
                            }
                            @if (Model.Discount > 0)
                            {
                                <span class="course-badge badge-discount">
                                    <i class="fas fa-tag me-1"></i> @Localizer["Discount"] @Model.Discount%
                                </span>
                            }
                        </div>
                    }

                    <!-- Rating in the bottom-left corner -->
                    <div class="absolute bottom-2 left-2 flex items-center bg-blue-600 text-white px-2 py-1 rounded-full text-xs font-medium">
                        <i class="fas fa-star ml-[3px]"></i>
                        <span>@(hasRatings? FormatRating(averageRating) : "0.0")</span>
                    </div>
                </div>

                @if (isLoggedIn)
                {
                    <!-- Wishlist button in the top-right corner (outside thumbnail overflow-hidden so its tooltip can float above the card) -->
                    <div class="absolute top-2.5 right-2.5 z-40">
                        <button type="button"
                                onclick="event.stopPropagation(); toggleWishlist(@Model.Id, this)"
                                data-tooltip="@(isCourseInWishlist ? Localizer["InWishlist"] : Localizer["Wishlist"])"
                                aria-label="@(isCourseInWishlist ? Localizer["InWishlist"] : Localizer["Wishlist"])"
                                class="wishlist-btn group/btn w-8 h-8 rounded-full flex items-center justify-center bg-white/90 dark:bg-gray-800/90 backdrop-blur-md shadow-md hover:shadow-lg border border-white/60 dark:border-gray-700/60 transition-all duration-200 hover:scale-110 active:scale-95 @(isCourseInWishlist ? "active" : "")">
                            <i class="@(isCourseInWishlist ? "fas fa-heart text-red-500" : "far fa-heart text-gray-600 dark:text-gray-300 group-hover/btn:text-red-500") text-sm transition-transform duration-200"></i>
                        </button>
                    </div>
                }

                <div class="p-4 flex-grow flex flex-col">
                    <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-2 group-hover:text-blue-600 transition line-clamp-1">@Model.Title</h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm mb-3 line-clamp-2">@Model.ShortDescription</p>

                    @if (!(currentController == "Profile" && currentAction == "InstructorProfile" || currentAction == "Instructor"))
                    {
                        <div class="flex items-center mb-3 text-sm text-gray-500 dark:text-gray-400">
                            @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl) && !Model.ProfileImageUrl.Contains("default-instructor"))
                            {
                                <img src="@Model.ProfileImageUrl"
                                     alt="@Model.InstructorName"
                                     class="w-6 h-6 rounded-full object-cover me-2 border border-gray-200 dark:border-gray-700 shrink-0 shadow-sm"
                                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');" />
                                <i class="fas fa-user-tie me-2 hidden shrink-0"></i>
                            }
                            else
                            {
                                <i class="fas fa-user-tie me-2 shrink-0"></i>
                            }
                            <span class="line-clamp-1">@Model.InstructorName</span>
                        </div>
                    }
                    <div class="mt-auto">
                        <div class="flex items-center gap-1 mb-2">
                            @if (hasRatings)
                            {
                                @Html.Raw(GetStarRating(averageRating))
                                <span class="text-sm font-bold text-gray-900 dark:text-white">@FormatRating(averageRating)</span>
                                <span class="text-gray-500 dark:text-gray-400 text-sm">(@totalRatings)</span>
                            }
                            else
                            {
                                @Html.Raw(GetStarRating(0))
                                <span class="text-sm font-bold text-gray-900 dark:text-white">0.0</span>
                                <span class="text-gray-500 dark:text-gray-400 text-sm">(0)</span>
                            }
                        </div>

                        <div class="flex flex-wrap justify-between items-center gap-2">
                            @{
                                var finalPrice = Model.Price - (Model.Price * (Model.Discount ?? 0) / 100);
                            }
                            <div>
                                @if (finalPrice <= 0)
                                {
                                    <span class="text-lg font-bold text-green-600 dark:text-green-400 inline-flex items-center gap-1.5">
                                        <i class="fas fa-gift text-sm"></i>
                                        @Localizer["Free"]
                                    </span>
                                }
                                else
                                {
                                    <span class="text-lg font-bold text-blue-600 dark:text-blue-400">@finalPrice.ToString("0") @Localizer["EGP"]</span>
                                    @if (Model.Discount > 0)
                                    {
                                        <span class="text-sm text-gray-500 line-through block">@Model.Price.ToString("0") @Localizer["EGP"]</span>
                                    }
                                }
                            </div>

                            @if (isUserEnrolled)
                            {
                                <button class="text-white bg-green-600 px-3 py-2 rounded-lg text-sm cursor-default" disabled>
                                    <i class="fas fa-check-circle me-1"></i> @Localizer["AlreadyEnrolled"]
                                </button>
                            }
                            else if (isCourseInCart)
                            {
                                <button onclick="event.stopPropagation(); toggleCart(@Model.Id, this)"
                                        class="text-white bg-orange-500 px-3 py-2 rounded-lg text-sm transition-colors add-to-cart-btn active">
                                    <span class="btn-text"><i class="fas fa-shopping-cart me-1"></i> @Localizer["InCart"]</span>
                                    <span class="loading-spinner hidden">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            }
                            else
                            {
                                <button onclick="event.stopPropagation(); toggleCart(@Model.Id, this)"
                                        class="text-white bg-blue-600 hover:bg-blue-700 px-3 py-2 rounded-lg text-sm transition-colors add-to-cart-btn">
                                    <span class="btn-text">@Localizer["AddToCart"]</span>
                                    <span class="loading-spinner hidden">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hover element (pointing dynamically at the course card) -->
            <div class="course-hover-info bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
                <div class="course-hover-bridge"></div>
                <div class="course-tooltip-arrow">
                   
                </div>
                <h3 class="font-bold text-xl mb-3 text-gray-800 dark:text-white">@Model.Title</h3>
                @if (!(currentController == "Profile" && currentAction == "InstructorProfile" || currentController == "Profile" && currentAction == "Instructor"))
                {
                    <div class="flex items-center gap-2 mb-1 text-sm text-gray-600 dark:text-gray-300">
                        <i class="fas fa-user-tie"></i>
                        <span>@Localizer["InstructorLabel"] @Model.InstructorName</span>
                    </div>
                }

                <div class="flex items-center gap-2 mb-4 text-sm">
                    <span class="text-gray-500 dark:text-gray-400">
                        <i class="fas fa-calendar-alt me-1"></i> @Localizer["UpdatedLabel"] @GetArabicMonthName(Model.CreatedAt.ToString("MMMM")) @Model.CreatedAt.ToString("yyyy")
                    </span>
                    <span class="text-gray-500 dark:text-gray-400">•</span>
                    <span class="text-gray-500 dark:text-gray-400">
                        <i class="fas fa-clock me-1"></i> @FormatDuration(Model.Duration)
                    </span>
                </div>

                @{
                    var highlights = (Model.Learnings != null && Model.Learnings.Any())
                        ? Model.Learnings.Where(x => !string.IsNullOrWhiteSpace(x)).Take(3).ToList()
                        : ((Model.Requirements != null && Model.Requirements.Any()) ? Model.Requirements.Where(x => !string.IsNullOrWhiteSpace(x)).Take(3).ToList() : new List<string>());
                }

                @if (highlights.Any())
                {
                    <ul class="text-base text-gray-700 dark:text-gray-300 mb-5 space-y-3">
                        @foreach (var item in highlights)
                        {
                            <li class="flex items-start gap-3">
                                <i class="fas fa-check mt-1 text-blue-500 flex-shrink-0"></i>
                                <span class="line-clamp-2">@item</span>
                            </li>
                        }
                    </ul>
                }

                <div class="course-hover-actions">
                    <div class="flex justify-between items-center">
                                                        @if (isLoggedIn)
                        {
                            <button onclick="event.stopPropagation(); toggleWishlist(@Model.Id, this)"
                            class="wishlist-text-btn text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-base flex items-center gap-2 transition-colors ms-3 @(isCourseInWishlist ? "active" : "")">
                                <i class="@(isCourseInWishlist ? "fas fa-heart text-red-500" : "far fa-heart")"></i>
                                <span class="btn-text">@(isCourseInWishlist ? Localizer["InWishlist"] : Localizer["Wishlist"])</span>
                                <span class="loading-spinner hidden">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        }
                        @if (isUserEnrolled)
                        {
                            <button class="text-white bg-green-600 px-4 py-2 rounded-lg text-base cursor-default flex items-center gap-2" disabled>
                                <i class="fas fa-check-circle"></i> @Localizer["AlreadyEnrolled"]
                            </button>
                        }
                        else if (isCourseInCart)
                        {
                            <button onclick="event.stopPropagation(); toggleCart(@Model.Id, this)"
                                    class="text-white bg-orange-500 px-4 py-2 rounded-lg text-base transition-colors flex items-center gap-2 add-to-cart-btn active">
                                <span class="btn-text"><i class="fas fa-shopping-cart"></i> @Localizer["InCart"]</span>
                                <span class="loading-spinner hidden">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        }
                        else
                        {
                            <button onclick="event.stopPropagation(); toggleCart(@Model.Id, this)"
                                    class="text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-base transition-colors flex items-center gap-2 add-to-cart-btn">
                                <span class="btn-text">@Localizer["AddToCart"]</span>
                                <span class="loading-spinner hidden">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    if (!window._courseCardTooltipInit) {
        window._courseCardTooltipInit = true;

        // Efficient delegated capture listener - runs ONLY on mouseenter of that specific card
        document.addEventListener('mouseenter', function (e) {
            const target = e.target;
            if (!target || !target.classList || !target.classList.contains('course-card-wrapper')) return;

            const tooltip = target.querySelector('.course-hover-info');
            if (!tooltip) return;

            const rect = target.getBoundingClientRect();
            const winWidth = window.innerWidth || document.documentElement.clientWidth;
            const container = target.closest('.swiper-container') || target.closest('.category-block');
            const rightBound = container ? Math.min(container.getBoundingClientRect().right, winWidth) : winWidth;
            const leftBound = container ? Math.max(container.getBoundingClientRect().left, 0) : 0;

            const spaceRight = rightBound - rect.right;
            const spaceLeft = rect.left - leftBound;
            const isRtl = document.documentElement.dir === 'rtl' || 
                          document.dir === 'rtl' || 
                          (document.body && document.body.getAttribute('dir') === 'rtl') || 
                          document.documentElement.getAttribute('dir') === 'rtl' ||
                          (document.documentElement.lang && document.documentElement.lang.toLowerCase().startsWith('ar'));

            tooltip.classList.remove('pos-left', 'pos-right', 'force-left', 'force-right');

            // In RTL, prefer opening to the LEFT (reading direction) unless space is insufficient
            // In LTR, prefer opening to the RIGHT unless space is insufficient
            let openOnRight = false;
            if (isRtl) {
                openOnRight = (spaceLeft < 335 && spaceRight >= 335);
            } else {
                openOnRight = (spaceRight >= 335 || spaceLeft < 335);
            }

            if (openOnRight) {
                tooltip.classList.add('pos-right', 'force-right');
            } else {
                tooltip.classList.add('pos-left', 'force-left');
            }
        }, true);
    }
</script>
<script>
        // Add/remove from the wishlist toggle function
    async function toggleWishlist(courseId, buttonElement) {
        // Determine which button was clicked
        let button;
        if (buttonElement) {
            button = buttonElement;
        } else {
            button = event.currentTarget;
        }

        const isCurrentlyActive = button.classList.contains('active');
        const action = isCurrentlyActive ? 'remove' : 'add';

        const icon = button.querySelector('i');
        const text = button.querySelector('.btn-text');
        const spinner = button.querySelector('.loading-spinner');

        // Save the original state
        const originalIconClass = icon.className;
        const originalText = text ? text.innerHTML : '';

        // Show loading state
        button.classList.add('loading');
        if (spinner) {
            spinner.classList.remove('hidden');
        }
        button.disabled = true;

        try {
            // Get the token if present
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {
                'Content-Type': 'application/json'
            };

            // Only attach the token if present
            if (tokenElement) {
                headers['RequestVerificationToken'] = tokenElement.value;
            }

            // Use the correct URLs with the Area
            const url = action === 'add'
                ? '/Learner/Wishlist/AddToWishlist'
                : '/Learner/Wishlist/RemoveFromWishlist';

            console.log(`Sending ${action} request to: ${url} for course: ${courseId}`);

            const response = await fetch(url, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify({ courseId: courseId })
            });

            if (response.ok) {
                const result = await response.json();
                console.log('Wishlist response:', result);

                if (result.success) {
                    // Update the state of all buttons for this course
                    updateAllWishlistButtons(courseId, action === 'add');

                    // Update the header counter if present
                    const wishlistCount = document.querySelector('[data-wishlist-count]');
                    if (wishlistCount) {
                        wishlistCount.textContent = result.wishlistCount || 0;
                        wishlistCount.classList.add('wishlist-pulse');
                        wishlistCount.addEventListener('animationend', () => {
                            wishlistCount.classList.remove('wishlist-pulse');
                        }, { once: true });
                    }

                    // Show the success message
                    const message = action === 'add'
                        ? ToastMessages.addedToWishlistSuccess
                        : ToastMessages.removedFromWishlistSuccess;
                    showSuccess(message);
                    if (window.refreshWishlistDropdown) refreshWishlistDropdown();

                } else {
                    throw new Error(result.message || @Html.Raw(Json.Serialize(Localizer["OperationFailed"].Value)));
                }
            } else {
                const errorText = await response.text();
                throw new Error(`@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ServerConnectionError"].Value)) ${response.status} - ${errorText}`);
            }
        } catch (error) {
            console.error('Error:', error);

            // Restore the button to its original state
            if (spinner) {
                spinner.classList.add('hidden');
            }
            button.classList.remove('loading');

            if (icon) {
                icon.className = originalIconClass;
            }
            if (text) {
                text.innerHTML = originalText;
            }

            showError(error.message || ToastMessages.failedToUpdateWishlist);

            // Re-enable the button after two seconds
            setTimeout(() => {
                button.disabled = false;
            }, 2000);
        }
    }

    // Function to update all wishlist buttons for this course
    function updateAllWishlistButtons(courseId, isAdded) {
        // Update the buttons in the main card
        const mainButtons = document.querySelectorAll(`button[onclick*="toggleWishlist(${courseId}"]`);

        mainButtons.forEach(button => {
            const icon = button.querySelector('i');
            const text = button.querySelector('.btn-text');

            if (isAdded) {
                // Added state - red heart
                button.classList.add('active');
                if (icon) {
                    icon.className = 'fas fa-heart text-red-500';
                    // Pulse effect
                    icon.classList.add('wishlist-pulse');
                    icon.addEventListener('animationend', () => {
                        icon.classList.remove('wishlist-pulse');
                    }, { once: true });
                }
                if (text) {
                    text.innerHTML = @Html.Raw(Json.Serialize(Localizer["InWishlist"].Value));
                }
                if (button.hasAttribute('data-tooltip')) {
                    button.setAttribute('data-tooltip', @Html.Raw(Json.Serialize(Localizer["InWishlist"].Value)));
                }
            } else {
                // Removed state - grey heart
                button.classList.remove('active');
                if (icon) {
                    icon.className = 'far fa-heart text-gray-500 dark:text-gray-300';
                }
                if (text) {
                    text.innerHTML = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Wishlist"].Value))';
                }
                if (button.hasAttribute('data-tooltip')) {
                    button.setAttribute('data-tooltip', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Wishlist"].Value))');
                }
            }

            // Remove the loading state and re-enable the button
            button.classList.remove('loading');
            const spinner = button.querySelector('.loading-spinner');
            if (spinner) {
                spinner.classList.add('hidden');
            }
            button.disabled = false;
        });
    }

    // Helper function to check the wishlist state on page load
    async function checkWishlistStatus(courseId) {
        try {
            const response = await fetch(`/Learner/Wishlist/IsCourseInWishlist?courseId=${courseId}`);
            if (response.ok) {
                const result = await response.json();
                return result.isInWishlist || false;
            }
        } catch (error) {
            console.error('Error checking wishlist status:', error);
        }
        return false;
    }
    // Add/remove from cart (toggle)
    async function toggleCart(courseId, buttonElement = null) {
        // Determine which button was clicked
        let button;
        if (buttonElement) {
            button = buttonElement;
        } else {
            button = event.currentTarget;
        }

        const spinner = button.querySelector('.loading-spinner');

        // Show loading state
        button.classList.add('loading');
        if (spinner) {
            spinner.classList.remove('hidden');
        }
        button.disabled = true;

        try {
            // Get the token if present
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {
                'Content-Type': 'application/json'
            };

            // Only attach the token if present
            if (tokenElement) {
                headers['RequestVerificationToken'] = tokenElement.value;
            }

            const response = await fetch('/Learner/Cart/ToggleCart', {
                method: 'POST',
                headers: headers,
                body: JSON.stringify({ courseId: courseId, quantity: 1 })
            });

            if (response.ok) {
                const result = await response.json();

                if (result.success) {
                    // Update all buttons for this course
                    updateAllCartButtons(courseId, result.inCart);

                    // Update cart count in header
                    const cartCount = document.querySelector('[data-cart-count]');
                    if (cartCount) {
                        cartCount.textContent = result.cartCount || 0;
                        cartCount.classList.add('cart-pulse');
                        cartCount.addEventListener('animationend', () => {
                            cartCount.classList.remove('cart-pulse');
                        }, { once: true });
                    }

                    // Show the success message
                    showSuccess(result.message || (result.inCart ? ToastMessages.addedToCartSuccess : ToastMessages.itemRemovedSuccess));
                    if (window.refreshCartDropdown) refreshCartDropdown();
                } else {
                    throw new Error(result.message || 'Failed to update cart');
                }
            } else {
                // If the response failed, try to get the message from the response
                let errorMessage = 'Failed to update cart';
                try {
                    const errorResult = await response.json();
                    errorMessage = errorResult.message || errorMessage;
                } catch (e) {
                    // If JSON parsing fails, use the default message
                }
                throw new Error(errorMessage);
            }
        } catch (error) {
            console.error('Error:', error);

            // Restore the button to its original state on error
            button.classList.remove('loading');
            if (spinner) {
                spinner.classList.add('hidden');
            }

            showError(error.message || ToastMessages.addToCartError);

            // Re-enable the button after two seconds
            setTimeout(() => {
                button.disabled = false;
            }, 2000);
        }
    }

    // Function to update all cart buttons for this course
    function updateAllCartButtons(courseId, isInCart) {
        const buttons = document.querySelectorAll(`button[onclick*="toggleCart(${courseId}"]`);

        buttons.forEach(button => {
            const text = button.querySelector('.btn-text');
            const spinner = button.querySelector('.loading-spinner');

            // Remove the loading state and re-enable the button
            button.classList.remove('loading');
            if (spinner) {
                spinner.classList.add('hidden');
            }
            button.disabled = false;

            if (isInCart) {
                // "In cart" state - orange
                button.classList.add('active');
                button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                button.classList.add('bg-orange-500');
                if (text) {
                    text.innerHTML = '<i class="fas fa-shopping-cart me-1"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["InCart"].Value))';
                }
            } else {
                // "Add to cart" state - blue
                button.classList.remove('active', 'bg-orange-500');
                button.classList.add('bg-blue-600', 'hover:bg-blue-700');
                if (text) {
                    text.innerHTML = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AddToCart"].Value))';
                }
            }
        });
    }

    // Helper function to add an item to the cart from anywhere
    function addToCartFromAnywhere(courseId) {
        toggleCart(courseId);
    }
</script>
