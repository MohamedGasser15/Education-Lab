    [dir="rtl"] .course-hover-info .course-hover-bridge,
    [dir=rtl] .course-hover-info .course-hover-bridge,
    .course-hover-info.pos-left .course-hover-bridge,
    .course-hover-info.force-left .course-hover-bridge {
        right: -24px;
        left: auto;
    }

    /* In LTR: Default is on the RIGHT of the card */
    html:not([dir="rtl"]) .course-hover-info,
    [dir="ltr"] .course-hover-info,
    [dir=ltr] .course-hover-info,
    .course-hover-info.pos-right,
    .course-hover-info.force-right {
        left: calc(100% + 14px);
        right: auto;
        transform: translateX(-6px);
    }

    html:not([dir="rtl"]) .course-hover-info .course-hover-bridge,
    [dir="ltr"] .course-hover-info .course-hover-bridge,
    [dir=ltr] .course-hover-info .course-hover-bridge,
    .course-hover-info.pos-right .course-hover-bridge,
    .course-hover-info.force-right .course-hover-bridge {
        left: -24px;
        right: auto;
    }

    /* JS Dynamic Direction Overrides */
    .course-hover-info.pos-left,
    .course-hover-info.force-left {
        right: calc(100% + 14px) !important;
        left: auto !important;
        transform: translateX(6px);
    }

