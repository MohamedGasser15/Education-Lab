@using EduLab_MVC.Models.DTOs.Category
@model List<EduLab_MVC.Models.DTOs.Course.CourseDTO>
@{
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["BrowseCoursesTitle"].Value;
    var coursesByCategory = Model.GroupBy(c => c.CategoryId).ToList();
    var isCollection = ViewBag.CollectionMode == true;
    var isSingleCategory = ViewBag.CategoryId != null;
    var isFilteredView = isSingleCategory || isCollection;
    var singleCategoryMode = isFilteredView;
}

<style>
    /* ========== BASE ANIMATIONS ========== */
    @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
    }

    @@keyframes move-dots {
        0% { background-position: 0 0; }
        100% { background-position: 40px 40px; }
    }
    .animated-dots-grid {
        background-image: radial-gradient(rgba(255, 255, 255, 0.4) 1.5px, transparent 1.5px);
        background-size: 40px 40px;
        animation: move-dots 4s linear infinite;
    }

    /* ========== HERO SECTION (matches Home) ========== */
    .hero-gradient-bg {
        background: radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.15) 0%, transparent 50%),
                    radial-gradient(circle at 80% 70%, rgba(6, 182, 212, 0.1) 0%, transparent 50%),
                    linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }
    .hero-glass-card {
        backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .hero-btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        box-shadow: 0 10px 20px -8px rgba(37, 99, 235, 0.4);
        transition: all 0.3s ease;
    }
    .hero-btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 30px -10px rgba(37, 99, 235, 0.5);
    }

    /* ========== CATEGORY PILLS (inspired by Hero Topics) ========== */
    .category-pill {
        backdrop-filter: blur(8px);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }
    .dark .category-pill {
        background: rgba(255, 255, 255, 0.03);
    }
    .category-pill:hover {
        background: rgba(37, 99, 235, 0.2);
        border-color: rgba(37, 99, 235, 0.4);
        transform: translateY(-2px);
    }
    .category-pill.active {
        background: #2563eb !important;
        color: white !important;
        border-color: #2563eb !important;
    }
    .no-scrollbar::-webkit-scrollbar {
        display: none !important;
    }
    .no-scrollbar {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
    }

    #categoryScrollRow {
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
    }
    #categoryScrollRow.is-dragging {
        cursor: grabbing !important;
        scroll-behavior: auto !important;
    }
    #categoryScrollRow a {
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ========== COURSE CARD ENHANCED (matches Home) ========== */
    .course-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }
    .dark .course-card {
        border-color: rgba(255, 255, 255, 0.05);
    }
    .course-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 35px -12px rgba(0, 0, 0, 0.15);
        border-color: rgba(37, 99, 235, 0.3);
    }
    .dark .course-card:hover {
        box-shadow: 0 25px 35px -12px rgba(0, 0, 0, 0.5);
    }

    /* ========== SWIPER NAVIGATION (matches Home) ========== */
    .swiper-button-next,
    .swiper-button-prev {
        width: 48px !important;
        height: 48px !important;
        background: white !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1) !important;
        border: 1px solid rgba(0,0,0,0.05) !important;
        transition: all 0.3s !important;
    }
    .swiper-button-next:hover,
    .swiper-button-prev:hover {
        background: #2563eb !important;
        transform: scale(1.1) !important;
    }
    .swiper-button-next:hover::after,
    .swiper-button-prev:hover::after {
        color: white !important;
    }
    .swiper-button-next::after,
    .swiper-button-prev::after {
        font-size: 18px !important;
        font-weight: bold !important;
        color: #2563eb !important;
    }
    .dark .swiper-button-next,
    .dark .swiper-button-prev {
        background: #1e293b !important;
        border-color: rgba(255,255,255,0.1) !important;
    }
    .dark .swiper-button-next::after,
    .dark .swiper-button-prev::after {
        color: #60a5fa !important;
    }

    /* ========== GRID MODE SWIPER (Natural auto-fill 270px columns without card stretching) ========== */
    .swiper-container.grid-mode .swiper-wrapper {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, 270px) !important;
        justify-content: start !important;
        gap: 1.5rem !important;
        transform: none !important;
        width: 100% !important;
        padding: 1rem 0 !important;
    }

    .swiper-container.grid-mode .swiper-slide {
        width: 270px !important;
        max-width: 270px !important;
        min-width: 270px !important;
        height: auto !important;
        margin: 0 !important;
    }
    .swiper-container.grid-mode ~ .swiper-button-prev,
    .swiper-container.grid-mode ~ .swiper-button-next {
        display: none !important;
    }

    @@media (max-width: 580px) {
        .swiper-container.grid-mode .swiper-wrapper {
            grid-template-columns: 1fr !important;
            justify-items: center !important;
        }
        .swiper-container.grid-mode .swiper-slide {
            width: 100% !important;
            max-width: 300px !important;
            min-width: 0 !important;
        }
    }

    /* ========== CATEGORY 1-ROW SWIPER (All View - Fixed 270px Cards) ========== */
    .category-swiper {
        overflow: hidden !important;
        padding-top: 0.75rem !important;
        padding-bottom: 1.25rem !important;
    }
    .category-swiper .swiper-wrapper {
        display: flex !important;
    }
    .category-swiper .swiper-slide {
        width: 270px !important;
        max-width: 270px !important;
        min-width: 270px !important;
        height: auto !important;
        flex-shrink: 0 !important;
    }

    @@media (max-width: 580px) {
        .category-swiper .swiper-slide {
            width: 85vw !important;
            max-width: 290px !important;
            min-width: 0 !important;
        }
    }



    /* ========== RESPONSIVE ========== */
    @@media (max-width: 640px) {
        .swiper-button-next,
        .swiper-button-prev {
            display: none;
        }
        .swiper-container.grid-mode .swiper-wrapper {
            grid-template-columns: 1fr !important;
        }
        .category-block-header {
            flex-wrap: wrap;
        }
        .category-block-header h3 {
            font-size: 1.15rem;
        }
        .category-block-header .category-icon {
            width: 2.4rem;
            height: 2.4rem;
            border-radius: 0.9rem;
            font-size: 1.1rem;
        }
        .category-block-header .course-count {
            font-size: 0.75rem;
            padding: 0.2rem 0.8rem;
        }
        .category-block-header a {
            font-size: 0.8rem;
            padding: 0.45rem 0.9rem !important;
        }
    }

    /* ========== SECTION BADGE (same as Home) ========== */
    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.2rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #1e3a8a;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 40px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .dark .section-badge {
        color: #f1f5f9;
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }

    .dark .section-badge i {
        color: #93c5fd;
    }/* ========== FULL WIDTH ADJUSTMENTS ========== */
.courses-section-fullwidth {
    width: 100%;
}

/* Remove the constraints from the container */
section.courses-section-bg > .container {
    max-width: 100% !important;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

/* Blocks take up the full width */
.category-block {
    width: 100%;
    margin-bottom: 4rem;
    padding: 2rem 2rem;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(8px);
    border-radius: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s ease;
}

/* Let the inner grid take advantage of the full width */
.category-block .grid,
.category-block .swiper-container {
    width: 100%;
}

/* Improve responsiveness across devices */
@@media (max-width: 768px) {
    section.courses-section-bg > .container {
        padding-left: 1rem;
        padding-right: 1rem;
    }
    .category-block {
        padding: 1.5rem 1rem;
    }
}/* ========== CATEGORY BLOCK SEPARATION ========== */
.category-block {
    margin-bottom: 4rem;
    padding: 2rem 1.5rem;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(8px);
    border-radius: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s ease;
}
.dark .category-block {
    background: rgba(17, 24, 39, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.2);
}
.category-block:hover {
    box-shadow: 0 25px 40px -12px rgba(37, 99, 235, 0.1);
}

/* Category title inside the block */
.category-block-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(37, 99, 235, 0.2);
}
.dark .category-block-header {
    border-bottom-color: rgba(59, 130, 246, 0.2);
}

.category-block-header h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1e293b;
}
.dark .category-block-header h3 {
    color: #f1f5f9;
}

.category-block-header .category-icon {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    border-radius: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.4rem;
    box-shadow: 0 8px 15px -5px rgba(37, 99, 235, 0.3);
}

.category-block-header .course-count {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    padding: 0.25rem 1rem;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-inline-start: auto;
    white-space: nowrap;
}
.dark .course-count {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
}
</style>

<!-- Hero Section - same design as Home -->
<!-- Hero Section - Fully Responsive (No custom breakpoints) -->
<section class="relative min-h-[50vh] md:min-h-[60vh] flex items-center justify-center overflow-hidden hero-gradient-bg">
    <div class="absolute inset-0 opacity-20 animated-dots-grid"></div>
    <div class="container mx-auto px-4 md:px-6 relative z-20 py-8 sm:py-12 md:py-16">
        <div class="flex flex-col items-center text-center space-y-4 sm:space-y-6 animate-fade-in-up">
            <span class="section-badge text-white !bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full text-sm">
                <i class="fas fa-layer-group me-2"></i> @Localizer["CoursesLibrary"]
            </span>
            
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold leading-tight text-white max-w-4xl px-2">
                <span>@Localizer["ExplorePrefix"] </span>
                <span class="text-transparent bg-clip-text bg-gradient-to-l from-blue-400 via-cyan-400 to-blue-400">@Localizer["ThousandsCourses"]</span>
                <br class="hidden sm:block">
                <span class="text-white/90">@Localizer["StartLearningToday"]</span>
            </h1>
            
            <p class="text-sm sm:text-base md:text-lg text-gray-300 max-w-2xl leading-relaxed px-4">
                @Localizer["ChooseFrom"] <span class="font-bold text-blue-300">@(ViewBag.TotalCourses ?? Model.Count) @Localizer["CourseUnit"]</span> @Localizer["InVariousFields"]
            </p>

            <!-- Search Box - Responsive (Column on small screens, row on sm and up) -->
            <div class="hero-glass-card w-full max-w-2xl rounded-2xl p-2 sm:p-1.5 flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                <div class="flex-grow relative">
                    <i class="fas fa-search absolute start-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm sm:text-base"></i>
                    <input type="text" id="searchInput" placeholder='@Localizer["SearchPlaceholder"]'
                           class="w-full bg-transparent py-2.5 sm:py-3 ps-10 sm:ps-12 pe-4 text-white placeholder:text-gray-400 rounded-xl text-sm sm:text-base focus:outline-none">
                </div>
                <button type="submit" id="heroSearchBtn" class="hero-btn-primary text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2 whitespace-nowrap">
                    <span>@Localizer["SearchButton"]</span>
                    <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-xs sm:text-sm ms-1"></i>
                </button>
            </div>
        </div>
    </div>
    
    <div class="absolute bottom-[-1px] left-0 right-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none" class="block w-full h-auto">
            <path d="M0 120L60 105C120 90 240 60 360 52.5C480 45 600 60 720 67.5C840 75 960 75 1080 67.5C1200 60 1320 45 1380 37.5L1440 30V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white" class="dark:fill-gray-900" />
        </svg>
    </div>
</section>

<section class="py-12 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
        <div class="text-center mb-8">
            <span class="section-badge mb-3">@Localizer["CategoriesLabel"]</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white mb-3">
                @Localizer["BrowseBy"] <span class="text-transparent bg-clip-text bg-gradient-to-l from-blue-600 to-cyan-400">@Localizer["FieldsHighlight"]</span>
            </h2>
        </div>
        
        <!-- Single Clean Scrollable Row with Navigation Arrows -->
        <div class="relative max-w-6xl mx-auto flex items-center">
            <!-- Scroll Left Arrow -->
            <button type="button" id="catScrollLeft" 
                    aria-label="Scroll Left"
                    class="hidden sm:flex items-center justify-center w-9 h-9 rounded-full bg-white dark:bg-gray-800 shadow-md border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 z-10 hover:bg-blue-600 hover:text-white transition flex-shrink-0 me-2">
                <i class="fas fa-chevron-@(isArabic ? "right" : "left") text-xs"></i>
            </button>

            <!-- Horizontal Scrollable Row (Hidden scrollbar, row جدا) -->
            <div id="categoryScrollRow" 
                 class="flex flex-nowrap overflow-x-auto gap-2.5 py-2 px-1 w-full scroll-smooth no-scrollbar">
                <a href="@Url.Action("Index")" 
                   class="category-pill flex-shrink-0 whitespace-nowrap @(ViewBag.CategoryId == null && ViewBag.CollectionMode != true ? "active" : "") px-5 py-2.5 rounded-full text-gray-700 dark:text-gray-200 font-medium text-sm flex items-center gap-2 shadow-sm">
                    <i class="fas fa-th-large"></i> @Localizer["AllFilter"]
                </a>
                @foreach (var category in ViewBag.Categories)
                {
                    <a href="@Url.Action("ByCategory", new { id = category.Category_Id })"
                       class="by-cat-link category-pill flex-shrink-0 whitespace-nowrap @(ViewBag.CategoryId == category.Category_Id ? "active" : "") px-5 py-2.5 rounded-full text-gray-700 dark:text-gray-200 font-medium text-sm flex items-center gap-2 shadow-sm">
                        <i class="fas @EduLab_MVC.Common.CategoryVisualHelper.GetCategoryIcon(category.Category_Name)"></i> @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? category.Category_Name : (category.Category_EnglishName ?? category.Category_Name))
                    </a>
                }
            </div>

            <!-- Scroll Right Arrow -->
            <button type="button" id="catScrollRight" 
                    aria-label="Scroll Right"
                    class="hidden sm:flex items-center justify-center w-9 h-9 rounded-full bg-white dark:bg-gray-800 shadow-md border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 z-10 hover:bg-blue-600 hover:text-white transition flex-shrink-0 ms-2">
                <i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs"></i>
            </button>
        </div>
    </div>
</section>
<!-- Courses Display Section - Enhanced with Clear Separation -->
<!-- Courses Display Section - Full Width Enhanced -->
<section class="py-8 bg-gray-50 dark:bg-gray-900/50 courses-section-bg">
    <div class="container mx-auto relative z-10">
        @if (isFilteredView)
        {
            var categories = ViewBag.Categories as IEnumerable<CategoryDTO>;
            var category = isSingleCategory ? categories?.FirstOrDefault(c => c.Category_Id == (int)ViewBag.CategoryId) : null;
            var categoryName = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? (category?.Category_Name ?? Localizer["UnknownCategory"]) : (category?.Category_EnglishName ?? category?.Category_Name ?? Localizer["UnknownCategory"]);
            var actualTotalCourses = (int)(ViewBag.TotalCount ?? (category?.CoursesCount > 0 ? category.CoursesCount : Model.Count));
            
            var headerBadge = isSingleCategory ? Localizer["CategoryLabel"].Value : (ViewBag.CollectionBadge as string ?? Localizer["CoursesLibrary"].Value);
            var headerTitle = isSingleCategory ? categoryName : (ViewBag.CollectionTitle as string ?? Localizer["ExploreCourses"].Value);
            var headerSubtitle = isSingleCategory 
                ? $"{actualTotalCourses} {Localizer["CoursesAvailableFor"].Value}" 
                : (ViewBag.CollectionSubtitle as string ?? $"{actualTotalCourses} {Localizer["CoursesAvailableFor"].Value}");
            var headerIcon = ViewBag.CollectionIcon as string ?? "fa-layer-group";
            var pageAction = ViewBag.PageAction as string ?? (isSingleCategory ? "ByCategory" : "Index");
            
            Func<int, object> getRouteValues = p => isSingleCategory 
                ? new { id = ViewBag.CategoryId, page = p, pageSize = ViewBag.PageSize ?? 24 } 
                : new { page = p, pageSize = ViewBag.PageSize ?? 24 };
            
            <div class="single-category-header mb-10">
                <div class="flex flex-col md:flex-row justify-between items-end gap-4">
                    <div>
                        <span class="section-badge mb-3 flex items-center gap-2">
                            <i class="fas @headerIcon text-blue-500"></i>
                            @headerBadge
                        </span>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">
                            @headerTitle
                        </h2>
                        <p class="text-gray-600 dark:text-gray-400 mt-2 text-lg">@headerSubtitle</p>
                    </div>
                    <a href="@Url.Action("Index")" class="group flex items-center gap-2 px-6 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-white/10 rounded-xl shadow-md hover:shadow-xl hover:border-blue-500/50 transition-all">
                        <span class="text-gray-700 dark:text-gray-200 font-medium group-hover:text-blue-600">@Localizer["ViewAllCategories"]</span>
                        <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-blue-600 group-hover:-translate-x-1 transition-transform"></i>
                    </a>
                </div>
            </div>

            <div class="single-category-mode-grid swiper-container grid-mode py-2">
                <div class="swiper-wrapper">
                    @foreach (var course in Model)
                    {
                        ViewData["SwiperMode"] = false;
                        @await Html.PartialAsync("_CourseCard", course)
                    }
                </div>
            </div>

            @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
            {
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
                int totalCount = ViewBag.TotalCount ?? Model.Count;
                int pageSize = ViewBag.PageSize ?? 24;

                <div class="flex flex-col items-center justify-center gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-800">
                    <div class="text-sm font-semibold text-gray-500 dark:text-gray-400 text-center">
                        @Localizer["Showing"] <span class="font-bold text-blue-600">@((currentPage - 1) * pageSize + 1)</span> @Localizer["To"] <span class="font-bold text-blue-600">@Math.Min(currentPage * pageSize, totalCount)</span> @Localizer["OutOf"] <span class="font-bold text-gray-900 dark:text-white">@totalCount</span> @Localizer["CourseUnit"]
                    </div>
                    <div class="flex items-center justify-center gap-2 flex-wrap">
                        <a href="@Url.Action(pageAction, getRouteValues(currentPage - 1))" 
                           class="px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-blue-600 hover:text-white transition-colors @(currentPage <= 1 ? "opacity-50 pointer-events-none" : "")">
                            <i class="fas fa-chevron-@(isArabic ? "right" : "left") text-xs"></i>
                        </a>
                        @{
                            var startP = Math.Max(1, currentPage - 2);
                            var endP = Math.Min(totalPages, currentPage + 2);
                        }
                        @for (var p = startP; p <= endP; p++)
                        {
                            <a href="@Url.Action(pageAction, getRouteValues(p))" 
                               class="px-4 py-2 rounded-xl font-bold transition-colors @(p == currentPage ? "bg-blue-600 text-white shadow-md" : "border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-blue-500 hover:text-white")">
                                @p
                            </a>
                        }
                        <a href="@Url.Action(pageAction, getRouteValues(currentPage + 1))" 
                           class="px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-blue-600 hover:text-white transition-colors @(currentPage >= totalPages ? "opacity-50 pointer-events-none" : "")">
                            <i class="fas fa-chevron-@(isArabic ? "left" : "right") text-xs"></i>
                        </a>
                    </div>
                </div>
            }

        }
        else
        {
            <div id="categoryBlocksContainer">
                @await Html.PartialAsync("_CategoryRowsPartial", Model)
            </div>

            <!-- Lazy Loading Sentinel & Subtle Loading Indicator -->
            <div id="infiniteScrollSentinel" class="py-6 flex flex-col items-center justify-center @(ViewBag.HasMoreCategories == true ? "" : "hidden")" 
                 data-skip="@(ViewBag.LoadedCategoriesCount ?? 3)" 
                 data-total="@(ViewBag.TotalCategoriesCount ?? 0)"
                 data-url="@Url.Action("GetMoreCategories", "Course", new { area = "Learner" })">
                <div id="lazyCategoriesLoading" class="hidden flex items-center gap-3 px-6 py-3 rounded-2xl bg-white/80 dark:bg-gray-800/80 backdrop-blur-md border border-gray-200/60 dark:border-gray-700/60 shadow-lg transition-all duration-300">
                    <div class="w-5 h-5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">@Localizer["LoadingMoreCourses"]</span>
                </div>
            </div>
        }
    </div>
</section><!-- Featured Categories Component (optional) -->
<section class="py-12 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
        <div class="text-center mb-8">
            <span class="section-badge mb-3">@Localizer["FeaturedCategories"]</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">
                @Localizer["DiscoverParticles"] <span class="text-transparent bg-clip-text bg-gradient-to-l from-blue-600 to-purple-500">@Localizer["FieldsHighlight"]</span> @Localizer["TrendingFields"]
            </h2>
        </div>
        @await Component.InvokeAsync("CategoriesDropdown", new { type = "featured" })
    </div>
</section>

<script>
    (function() {
        'use strict';

        // ========== SEARCH ==========
        const searchBtn = document.getElementById('heroSearchBtn');
        const searchInput = document.getElementById('searchInput');
        if (searchBtn && searchInput) {
            searchBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const query = searchInput.value.trim();
                if (query) {
                    window.location.href = '@Url.Action("Search", "Course", new { area = "Learner" })' + '?search=' + encodeURIComponent(query);
                }
            });
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchBtn.click();
                }
            });
        }

        // ========== SWIPER INIT (Category 1-Row Sliders in All View) ==========
        function initCategorySwipers(scope = document) {
            if (typeof Swiper === 'undefined') return;
            scope.querySelectorAll('.category-swiper').forEach(container => {
                if (container.swiper) return;
                const swiperId = container.id;
                const catId = swiperId.replace('swiper-', '');
                const prevBtn = document.querySelector(`.cat-prev-${catId}`);
                const nextBtn = document.querySelector(`.cat-next-${catId}`);

                const swiper = new Swiper(container, {
                    slidesPerView: 'auto',
                    spaceBetween: 20,
                    speed: 350,
                    grabCursor: true,
                    watchOverflow: true,
                    observer: true,
                    observeParents: true,
                    resistance: true,
                    resistanceRatio: 0.85,
                    navigation: {
                        nextEl: nextBtn,
                        prevEl: prevBtn,
                        disabledClass: 'opacity-0 pointer-events-none'
                    }
                });

                // Prevent accidental card click/navigation when dragging
                let isDragging = false;
                swiper.on('sliderMove', function() {
                    isDragging = true;
                });
                swiper.on('touchEnd', function() {
                    setTimeout(() => { isDragging = false; }, 100);
                });
                container.addEventListener('click', function(e) {
                    if (isDragging || !swiper.allowClick) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                }, true);
            });
        }
        initCategorySwipers();

        // Any remaining generic swipers not in grid mode
        if (typeof Swiper !== 'undefined') {
            document.querySelectorAll('.swiper-container:not(.grid-mode):not(.category-swiper)').forEach(container => {
                const nextEl = container.parentElement?.querySelector('.swiper-button-next');
                const prevEl = container.parentElement?.querySelector('.swiper-button-prev');
                if (nextEl && prevEl) {
                    new Swiper(container, {
                        slidesPerView: 1,
                        spaceBetween: 24,
                        navigation: { nextEl, prevEl },
                        breakpoints: {
                            640: { slidesPerView: 2 },
                            1024: { slidesPerView: 3 },
                            1280: { slidesPerView: 4 }
                        }
                    });
                }
            });
        }

        // ========== LAZY LOAD CATEGORIES ON SCROLL ==========
        const sentinel = document.getElementById('infiniteScrollSentinel');
        if (sentinel && 'IntersectionObserver' in window) {
            let isLoading = false;
            let skip = parseInt(sentinel.dataset.skip || '3');
            const total = parseInt(sentinel.dataset.total || '0');
            const fetchUrl = sentinel.dataset.url;

            const loadMoreCategories = async () => {
                if (isLoading || skip >= total) return;
                isLoading = true;
                const loader = document.getElementById('lazyCategoriesLoading');
                if (loader) loader.classList.remove('hidden');

                try {
                    const res = await fetch(`${fetchUrl}?skip=${skip}&take=3`);
                    if (res.ok) {
                        const html = await res.text();
                        if (html && html.trim().length > 0) {
                            const container = document.getElementById('categoryBlocksContainer');
                            const temp = document.createElement('div');
                            temp.innerHTML = html;

                            const fragment = document.createDocumentFragment();
                            while (temp.firstChild) {
                                const child = temp.firstChild;
                                if (child.nodeType === 1) {
                                    fragment.appendChild(child);
                                } else {
                                    temp.removeChild(child);
                                }
                            }
                            container.appendChild(fragment);

                            // Initialize swiper on the newly appended blocks
                            initCategorySwipers(container);

                            skip += 3;
                            sentinel.dataset.skip = skip;

                            if (skip >= total) {
                                observer.disconnect();
                                sentinel.classList.add('hidden');
                            }
                        } else {
                            observer.disconnect();
                            sentinel.classList.add('hidden');
                        }
                    }
                } catch (err) {
                    console.error('Error loading more categories:', err);
                } finally {
                    isLoading = false;
                    if (loader) loader.classList.add('hidden');
                }
            };

            const observer = new IntersectionObserver((entries) => {
                if (entries[0] && entries[0].isIntersecting) {
                    loadMoreCategories();
                }
            }, { rootMargin: '350px' });

            observer.observe(sentinel);
        }

        // ========== RESPONSIVE DATA LOADING FOR ByCategory (3 Full Rows) ==========
        function getResponsivePageSize() {
            const container = document.querySelector('section.courses-section-bg > .container') || document.body;
            const availableWidth = container.clientWidth || window.innerWidth;
            // Each card is strictly fixed at 270px + 24px gap = 294px
            const colWidth = 270 + 24;
            const cols = Math.max(1, Math.floor((availableWidth + 24) / colWidth));
            return cols * 3;
        }

        // Keep client_page_size cookie fresh so server always serves exact page size
        function updatePageSizeCookie() {
            const size = getResponsivePageSize();
            document.cookie = 'client_page_size=' + size + '; path=/; max-age=2592000; SameSite=Lax';
            return size;
        }
        updatePageSizeCookie();
        window.addEventListener('resize', updatePageSizeCookie);

        // Update all ByCategory links to explicitly carry responsive pageSize
        document.querySelectorAll('a[href*="/ByCategory"]').forEach(link => {
            link.addEventListener('click', function(e) {
                try {
                    const optimal = updatePageSizeCookie();
                    const url = new URL(this.href, window.location.origin);
                    url.searchParams.set('pageSize', optimal);
                    this.href = url.toString();
                } catch (err) { }
            });
        });

        // If in ByCategory mode, ensure exactly 3 rows are rendered without any orphan cards
        function enforceThreeRows() {
            const grid = document.querySelector('.single-category-mode-grid .swiper-wrapper');
            if (!grid) return;
            const container = document.querySelector('section.courses-section-bg > .container') || grid;
            const availableWidth = container.clientWidth || window.innerWidth;
            const colWidth = 270 + 24;
            const cols = Math.max(1, Math.floor((availableWidth + 24) / colWidth));
            const maxVisible = cols * 3;
            const slides = grid.querySelectorAll('.swiper-slide');
            slides.forEach((slide, idx) => {
                if (idx < maxVisible) {
                    slide.style.removeProperty('display');
                } else {
                    slide.style.setProperty('display', 'none', 'important');
                }
            });
        }
        enforceThreeRows();
        window.addEventListener('resize', enforceThreeRows);

        // ========== CATEGORY ROW HORIZONTAL SCROLL & DRAG (HOLD TO SCROLL) ==========
        const scrollRow = document.getElementById('categoryScrollRow');
        const btnLeft = document.getElementById('catScrollLeft');
        const btnRight = document.getElementById('catScrollRight');

        if (scrollRow) {
            // Button navigation
            if (btnLeft && btnRight) {
                btnLeft.addEventListener('click', function() {
                    const scrollAmount = @(isArabic ? "280" : "-280");
                    scrollRow.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
                btnRight.addEventListener('click', function() {
                    const scrollAmount = @(isArabic ? "-280" : "280");
                    scrollRow.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
            }

            // Hold & Drag to Scroll (Mouse)
            let isDown = false;
            let startX = 0;
            let initialScrollLeft = 0;
            let hasDragged = false;

            scrollRow.addEventListener('mousedown', function(e) {
                isDown = true;
                hasDragged = false;
                scrollRow.classList.add('is-dragging');
                scrollRow.classList.remove('scroll-smooth');
                startX = e.pageX - scrollRow.offsetLeft;
                initialScrollLeft = scrollRow.scrollLeft;
            });

            window.addEventListener('mousemove', function(e) {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - scrollRow.offsetLeft;
                const walk = (x - startX) * 1.5;
                if (Math.abs(x - startX) > 6) {
                    hasDragged = true;
                }
                scrollRow.scrollLeft = initialScrollLeft - walk;
            });

            window.addEventListener('mouseup', function() {
                if (!isDown) return;
                isDown = false;
                scrollRow.classList.remove('is-dragging');
                scrollRow.classList.add('scroll-smooth');

                // If user dragged, block the click on category pills
                if (hasDragged) {
                    const blockClick = function(ev) {
                        ev.preventDefault();
                        ev.stopPropagation();
                        scrollRow.removeEventListener('click', blockClick, true);
                    };
                    scrollRow.addEventListener('click', blockClick, true);
                    setTimeout(function() {
                        scrollRow.removeEventListener('click', blockClick, true);
                    }, 100);
                }
            });
        }



        // ========== FORMAT DURATION (pre-existing) ==========
        window.formatDuration = function(seconds) {
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;
            return [
                hours.toString().padStart(2, '0'),
                minutes.toString().padStart(2, '0'),
                secs.toString().padStart(2, '0')
            ].join(':');
        };
    })();
</script>
