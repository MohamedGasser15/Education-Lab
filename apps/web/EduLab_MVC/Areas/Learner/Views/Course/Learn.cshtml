            <div class="bg-blue-50/50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/20 rounded-xl p-4">
                <div id="existing-rating" data-rating-id="${existingRating.id}">
                    <div class="text-center mb-4">
                        <h4 class="font-bold text-blue-800 dark:text-blue-355 text-sm mb-2 flex items-center justify-center gap-1.5">
