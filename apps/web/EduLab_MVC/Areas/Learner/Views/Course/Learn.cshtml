    function initializeRatingForm() {
        const ratingForm = document.getElementById('rating-form');
        const stars = document.querySelectorAll('.star-rating .star');
        const ratingValue = document.getElementById('rating-value');
        const ratingFeedback = document.getElementById('rating-feedback');
        
        const feedbackTexts = {
            1: @Html.Raw(Json.Serialize(Localizer["RatingPoor"].Value)),
            2: @Html.Raw(Json.Serialize(Localizer["RatingFair"].Value)),
            3: @Html.Raw(Json.Serialize(Localizer["RatingGood"].Value)),
            4: @Html.Raw(Json.Serialize(Localizer["RatingVeryGood"].Value)),
            5: @Html.Raw(Json.Serialize(Localizer["RatingExcellent"].Value))
        };
        
        if (stars && ratingValue) {
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const value = parseInt(this.getAttribute('data-value'));
                    ratingValue.value = value;
                    updateStars(stars, value);
                    
                    if (ratingFeedback) {
                        ratingFeedback.textContent = feedbackTexts[value] || '';
                        ratingFeedback.className = 'mt-2 text-xs text-amber-500 font-bold';
                    }
                });
                
                star.addEventListener('mouseenter', function() {
                    const value = parseInt(this.getAttribute('data-value'));
                    updateStars(stars, value, true);
                });
                
                star.addEventListener('mouseleave', function() {
                    const currentValue = parseInt(ratingValue.value) || 0;
                    updateStars(stars, currentValue);
                });
            });
        }
        
        if (ratingForm) {
            ratingForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                await submitRating();
            });
        }
    }

    function initializeExistingRating() {
        const editRatingBtn = document.getElementById('edit-rating-btn');
        const deleteRatingBtn = document.getElementById('delete-rating-btn');
        const saveEditBtn = document.getElementById('save-edit-rating');
        const cancelEditBtn = document.getElementById('cancel-edit-rating');
        const stars = document.querySelectorAll('#edit-rating-form .star');

        if (editRatingBtn) {
            editRatingBtn.addEventListener('click', function() {
                document.getElementById('existing-rating').classList.add('hidden');
                document.getElementById('edit-rating-form').classList.remove('hidden');
            });
        }

        if (deleteRatingBtn) {
            deleteRatingBtn.addEventListener('click', async function() {
                if (confirm(@Html.Raw(Json.Serialize(Localizer["ConfirmDeleteRating"].Value)))) {
                    await deleteRating();
                }
            });
        }

        if (saveEditBtn) {
            saveEditBtn.addEventListener('click', async function() {
                await updateRating();
            });
        }

        if (cancelEditBtn) {
            cancelEditBtn.addEventListener('click', function() {
                document.getElementById('existing-rating').classList.remove('hidden');
                document.getElementById('edit-rating-form').classList.add('hidden');
            });
        }

        if (stars) {
            const editRatingValue = document.getElementById('edit-rating-value');
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const value = parseInt(this.getAttribute('data-value'));
                    editRatingValue.value = value;
                    updateStars(stars, value);
                });
            });
        }
    }

    function updateStars(stars, value, isHover = false) {
        stars.forEach(star => {
            const starValue = parseInt(star.getAttribute('data-value'));
            const icon = star.querySelector('i');
            if (starValue <= value) {
                icon.className = 'fas fa-star text-2xl text-yellow-400';
            } else {
                icon.className = 'far fa-star text-2xl text-gray-300';
            }
        });
    }

    async function submitRating() {
        try {
            const form = document.getElementById('rating-form');
            const formData = new FormData(form);
            const ratingData = {
                CourseId: courseData.id,
                Value: parseInt(formData.get('Value')),
                Comment: formData.get('Comment')
            };
            
            const response = await fetch('/Learner/Rating/AddRating', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(ratingData)
            });
            
            if (response.ok) {
                showNotification(ToastMessages.ratingAddedSuccessfully, 'success');
                await loadRatingSystem();
            }
        } catch (error) {
            console.error(error);
        }
    }

    async function updateRating() {
        try {
            const ratingId = document.querySelector('input[name="RatingId"]').value;
            const value = document.getElementById('edit-rating-value').value;
            const comment = document.getElementById('edit-comment').value;
            
            const ratingData = {
                CourseId: courseData.id,
                Value: parseInt(value),
                Comment: comment
            };
            
            const response = await fetch(`/Learner/Rating/UpdateRating?ratingId=${ratingId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(ratingData)
            });
            
            if (response.ok) {
                showNotification(ToastMessages.ratingUpdatedSuccessfully, 'success');
                await loadRatingSystem();
            }
        } catch (error) {
            console.error(error);
        }
    }

    async function deleteRating() {
        try {
            const ratingId = document.getElementById('existing-rating').getAttribute('data-rating-id');
            const response = await fetch(`/Learner/Rating/DeleteRating?ratingId=${ratingId}&courseId=${courseData.id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });
            
            if (response.ok) {
                showNotification(ToastMessages.ratingDeletedSuccessfully, 'success');
                await loadRatingSystem();
            }
        } catch (error) {
            console.error(error);
        }
    }

    function showRatingModal() {
        if (progressPercentageVal >= 80 && !localStorage.getItem(`rating_modal_shown_${courseData.id}`)) {
            const modal = document.getElementById('rating-modal');
            loadRatingData().then(ratingData => {
                if (ratingData.success && ratingData.canRate && !ratingData.existingRating) {
                    modal.classList.remove('hidden');
                    localStorage.setItem(`rating_modal_shown_${courseData.id}`, 'true');
                    
                    const modalForm = document.getElementById('modal-rating-form');
                    modalForm.innerHTML = `
                        <form id="modal-rating-form-content" class="space-y-4">
                            <input type="hidden" name="CourseId" value="${courseData.id}" />
                            <div class="modal-star-rating flex justify-center gap-1.5" dir="ltr">
                                ${Array.from({length: 5}, (_, i) => 5 - i).map(i => `
                                    <button type="button" class="star text-gray-300 hover:text-yellow-400 transition-colors" data-value="${i}">
                                        <i class="far fa-star text-3xl"></i>
                                    </button>
                                `).join('')}
                            </div>
                            <input type="hidden" name="Value" id="modal-rating-value" required />
                            <textarea name="Comment" rows="2" 
                                class="w-full px-3 py-2 border border-gray-200 dark:border-gray-850 rounded-xl bg-white dark:bg-gray-905 text-sm text-gray-800 dark:text-white resize-none"
                                placeholder="@Localizer["CommentOptional"]"></textarea>
                            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-xl font-bold text-sm shadow-md">
                                @Localizer["SubmitRating"]
                            </button>
                        </form>
                    `;
                    
                    const modalStars = modalForm.querySelectorAll('.star');
                    const modalRatingValue = document.getElementById('modal-rating-value');
                    
                    modalStars.forEach(star => {
                        star.addEventListener('click', function() {
                            const value = parseInt(this.getAttribute('data-value'));
                            modalRatingValue.value = value;
                            updateStars(modalStars, value);
                        });
                    });
                    
                    const modalFormContent = document.getElementById('modal-rating-form-content');
                    modalFormContent.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        const formData = new FormData(this);
                        const ratingData = {
                            CourseId: courseData.id,
                            Value: parseInt(formData.get('Value')),
                            Comment: formData.get('Comment')
                        };
                        
                        const response = await fetch('/Learner/Rating/AddRating', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(ratingData)
                        });
                        
                        if (response.ok) {
                            showNotification(ToastMessages.ratingAddedSuccessfully, 'success');
                            closeRatingModal();
                            await loadRatingSystem();
                        }
                    });
                }
            });
        }
    }

    function closeRatingModal() {
        const modal = document.getElementById('rating-modal');
        modal.classList.add('hidden');
    }
    document.getElementById('close-rating-modal')?.addEventListener('click', closeRatingModal);
});

// ============================= نظام التعليقات =============================

function loadLectureComments(lectureId) {
    currentLectureId = lectureId;
    var list = document.getElementById('comments-list');
    var loading = document.getElementById('comments-loading');
    var empty = document.getElementById('comments-empty');
    var count = document.getElementById('comments-count');

    if (!list) return;

    if (loading) loading.classList.remove('hidden');
    if (empty) empty.classList.add('hidden');
    list.innerHTML = '';

    fetch('/Learner/Comments/GetLectureComments?lectureId=' + lectureId)
        .then(function(r) { return r.json(); })
        .then(function(comments) {
            if (loading) loading.classList.add('hidden');
            if (!comments || comments.length === 0) {
                if (empty) empty.classList.remove('hidden');
                if (count) count.textContent = '0';
                return;
            }
            if (empty) empty.classList.add('hidden');
            if (count) count.textContent = comments.length;
            
            function renderComment(c, isReply) {
                var initials = c.userName ? c.userName.charAt(0) : @Html.Raw(Json.Serialize(Localizer["UserInitial"].Value));
                var avatarHtml = c.userProfileImage
                    ? '<img src="' + c.userProfileImage + '" class="w-full h-full object-cover">'
                    : '<span class="text-xs font-bold">' + initials + '</span>';
                var isOwner = c.userId === currentUserId;
                var repliesHtml = '';
                if (c.replies && c.replies.length > 0) {
                    repliesHtml = '<div class="mr-6 mt-3 space-y-3 border-r border-blue-200 dark:border-blue-900 pr-3">' +
                        c.replies.map(function(r) { return renderComment(r, true); }).join('') +
                    '</div>';
                }
                var badgeHtml = c.isInstructorReply
                    ? '<span class="text-[9px] font-bold text-blue-600 bg-blue-50 dark:bg-blue-950 px-2 py-0.5 rounded-full mr-2">' + @Html.Raw(Json.Serialize(Localizer["InstructorBadge"].Value)) + '</span>'
                    : '';
                var actionsHtml = '<div class="flex items-center gap-3 mt-2 text-xs font-bold text-gray-500">' +
                    '<button onclick="showReplyInput(' + c.id + ')" class="text-blue-500 hover:underline flex items-center gap-1"><i class="fas fa-reply"></i> ' + @Html.Raw(Json.Serialize(Localizer["ReplyAction"].Value)) + '</button>' +
                    (isOwner ? '<button onclick="deleteComment(' + c.id + ')" class="text-red-500 hover:underline flex items-center gap-1"><i class="fas fa-trash-alt"></i> ' + @Html.Raw(Json.Serialize(Localizer["DeleteAction"].Value)) + '</button>' : '') +
                '</div>' +
                '<div id="replyInput-' + c.id + '" class="hidden mt-3 flex gap-2">' +
                    '<textarea rows="1" placeholder="' + @Html.Raw(Json.Serialize(Localizer["WriteReplyPlaceholder"].Value)) + '" class="flex-1 px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-xs text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none resize-none"></textarea>' +
                    '<button onclick="sendReplyInline(' + c.id + ')" class="px-3.5 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-bold hover:bg-blue-700 transition-all shrink-0"><i class="fas fa-paper-plane"></i></button>' +
                '</div>';
                
                return '<div class="flex gap-3 p-3.5 rounded-xl border border-gray-100 dark:border-gray-800 ' + (isReply ? 'bg-blue-50/20 dark:bg-blue-955/10' : 'bg-gray-50/50 dark:bg-gray-900/30') + ' comment-item" data-id="' + c.id + '">' +
                    '<div class="w-8 h-8 rounded-full bg-blue-105 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 overflow-hidden shrink-0">' + avatarHtml + '</div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-2 mb-1.5">' +
                            '<span class="text-xs font-bold text-gray-850 dark:text-gray-200">' + (c.userName || @Html.Raw(Json.Serialize(Localizer["DefaultUserName"].Value))) + '</span>' +
                            badgeHtml +
                            '<span class="text-[10px] text-gray-400">' + (c.timeAgo || '') + '</span>' +
                        '</div>' +
                        '<p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">' + c.content + '</p>' +
                        actionsHtml +
                        repliesHtml +
                    '</div>' +
                '</div>';
            }
            list.innerHTML = comments.map(function(c) { return renderComment(c, false); }).join('');
        })
        .catch(function() {
            loading.classList.add('hidden');
            empty.classList.remove('hidden');
            empty.innerHTML = '<i class="fas fa-exclamation-triangle text-3xl mb-2 opacity-20 text-red-500"></i><p class="text-xs font-bold text-gray-400">' + @Html.Raw(Json.Serialize(Localizer["ErrorLoadingComments"].Value)) + '</p>';
        });
}

document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('comment-input');
    var submit = document.getElementById('comment-submit');
    var chars = document.getElementById('comment-chars');

    if (!input || !submit) return;

    input.addEventListener('input', function() {
        var len = this.value.length;
        chars.textContent = len + '/1000';
        submit.disabled = len === 0 || len > 1000;
        if (len > 1000) {
            chars.classList.add('text-red-500');
            chars.classList.remove('text-gray-400');
        } else {
            chars.classList.remove('text-red-500');
            chars.classList.add('text-gray-400');
        }
    });

    submit.addEventListener('click', function() {
        var content = input.value.trim();
        if (!content || !currentLectureId) return;

        submit.disabled = true;
        submit.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        fetch('/Learner/Comments/AddComment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lectureId: currentLectureId, content: content })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
            location.reload();
        })
        .catch(function() {
            location.reload();
        });
    });
});

function deleteComment(commentId) {
    if (!confirm(@Html.Raw(Json.Serialize(Localizer["ConfirmDeleteComment"].Value)))) return;
    fetch('/Learner/Comments/DeleteComment?id=' + commentId, { method: 'POST' })
        .then(function(r) {
            if (r.ok) loadLectureComments(currentLectureId);
        });
}

function showReplyInput(commentId) {
    var el = document.getElementById('replyInput-' + commentId);
    if (el) {
        el.classList.toggle('hidden');
        if (!el.classList.contains('hidden')) el.querySelector('textarea').focus();
    }
}

function sendReplyInline(commentId) {
    var el = document.getElementById('replyInput-' + commentId);
    var ta = el.querySelector('textarea');
    if (!ta.value.trim()) return;

    fetch('/Learner/Comments/ReplyToComment?id=' + commentId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: ta.value.trim() })
    })
    .then(function() {
        location.reload();
    })
    .catch(function() {
        location.reload();
    });
}
</script>