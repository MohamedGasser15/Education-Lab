    async function loadRatingData() {
        try {
            const response = await fetch(`/Learner/Rating/GetRatingData?courseId=${courseData.id}`);
            if (response.ok) {
                return await response.json();
            }
            return { success: false };
        } catch (error) {
            console.error('Error loading rating data:', error);
            return { success: false };
        }
    }

    function renderRatingSummary(summary) {
        if (!summary) return;

        var container = document.getElementById('rating-summary');
        if (!container) return;

        var html = '<div class="flex flex-col md:flex-row items-center justify-between gap-6">' +
            '<div class="text-center flex-1">' +
                '<div class="w-20 h-20 bg-gradient-to-br from-yellow-400 to-amber-500 rounded-full flex flex-col items-center justify-center mx-auto mb-3 shadow-lg">' +
                    '<span class="text-2xl font-extrabold text-white">' + summary.averageRating.toFixed(1) + '</span>' +
                    '<span class="text-[10px] text-white/80 font-bold">@Localizer["OutOf5"]</span>' +
                '</div>' +
                '<div class="flex justify-center mb-1">';

        var fullStars = Math.floor(summary.averageRating);
        var hasHalfStar = summary.averageRating % 1 >= 0.5;
        for (var i = 1; i <= 5; i++) {
            if (i <= fullStars) html += '<i class="fas fa-star text-yellow-400 text-sm"></i>';
            else if (i === fullStars + 1 && hasHalfStar) html += '<i class="fas fa-star-half-alt text-yellow-400 text-sm"></i>';
            else html += '<i class="far fa-star text-gray-300 text-sm"></i>';
        }

        html += '</div><div class="text-xs text-gray-500 dark:text-gray-400">(' + summary.totalRatings + ' ' + @Html.Raw(Json.Serialize(Localizer["RatingUnit"].Value)) + ')</div></div>' +
            '<div class="flex-1 w-full max-w-md"><div class="space-y-2.5">';

        for (var i = 5; i >= 1; i--) {
            var count = summary.ratingDistribution[i] || 0;
            var pct = summary.totalRatings > 0 ? (count * 100.0 / summary.totalRatings) : 0;
            html += '<div class="flex items-center gap-2 text-xs">' +
                '<span class="font-bold text-gray-600 w-4">' + i + '</span>' +
                '<i class="fas fa-star text-yellow-400 text-[9px]"></i>' +
                '<div class="flex-1 h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">' +
                    '<div class="h-full bg-yellow-400 rounded-full" style="width:' + pct.toFixed(0) + '%"></div>' +
                '</div>' +
                '<span class="text-gray-400 w-6 text-left">' + count + '</span>' +
            '</div>';
        }

        html += '</div></div></div>';
        container.innerHTML = html;
    }

    function updateRatingVisibility(canRateDto, existingRating) {
        const ratingFormContainer = document.getElementById('rating-form-container');
        const ratingMessage = document.getElementById('rating-message');
        
        if (!canRateDto) return;

        if (canRateDto.canRate) {
            ratingMessage.classList.add('hidden');
            ratingFormContainer.classList.remove('hidden');
        } else if (canRateDto.hasRated && existingRating) {
            ratingMessage.classList.add('hidden');
            ratingFormContainer.classList.remove('hidden');
            renderExistingRating(existingRating);
        } else if (!canRateDto.eligibleToRate) {
            ratingFormContainer.classList.add('hidden');
            ratingMessage.classList.remove('hidden');
            ratingMessage.innerHTML = `
                <div class="bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30 rounded-xl p-5 text-center">
                    <div class="w-14 h-14 bg-blue-100 dark:bg-blue-955 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fas fa-trophy text-xl"></i>
                    </div>
                    <h4 class="text-base font-bold text-blue-900 dark:text-blue-300 mb-1">
                        @Localizer["KeepLearning"]
                    </h4>
                    <p class="text-xs text-blue-700/80 dark:text-blue-400/80 mb-3">
                        @Localizer["RateAfter80Percent"]
                    </p>
                    <div class="flex items-center justify-center gap-2 text-xs font-bold text-blue-900 dark:text-blue-300 mb-2">
                        <span>@Localizer["CurrentProgressLabel"]:</span>
                        <span>${progressPercentageVal}%</span>
                    </div>
                    <div class="w-full max-w-xs bg-blue-200 dark:bg-blue-955 rounded-full h-2 mx-auto overflow-hidden">
                        <div class="bg-blue-600 h-full rounded-full transition-all duration-500" style="width: ${progressPercentageVal}%"></div>
                    </div>
                </div>
            `;
        } else {
            ratingFormContainer.classList.add('hidden');
            ratingMessage.classList.remove('hidden');
            ratingMessage.textContent = @Html.Raw(Json.Serialize(Localizer["CannotRateYet"].Value));
        }
    }

    function renderExistingRating(existingRating) {
