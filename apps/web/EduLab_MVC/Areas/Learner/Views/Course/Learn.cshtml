                            <i class="fas fa-edit"></i> @Localizer["EditRatingLabel"]
                        </button>

                    </div>
                </div>

                <div id="edit-rating-form" class="hidden space-y-3 mt-4 border-t border-blue-100 dark:border-blue-900/30 pt-3">
