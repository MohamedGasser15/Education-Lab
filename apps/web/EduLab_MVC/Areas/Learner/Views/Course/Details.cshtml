@await Html.PartialAsync("_ReportModal")

@section Scripts {
    <script>
        const currentUserId = "@(User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")";
        // Free Preview Modal
        function openFreePreviewModal() {
            var modal = document.getElementById('freePreviewModal');
            var player = document.getElementById('freePreviewPlayer');
            if (!modal) return;
            document.body.style.overflow = 'hidden';
            modal.classList.remove('hidden');
            if (player) {
                player.currentTime = 0;
                player.play();
            }
        }

        function closeFreePreviewModal() {
            var modal = document.getElementById('freePreviewModal');
            var player = document.getElementById('freePreviewPlayer');
            if (modal) modal.classList.add('hidden');
            if (player) player.pause();
            document.body.style.overflow = '';
        }

        document.addEventListener('DOMContentLoaded', function() {
            var playBtn = document.getElementById('playPreviewBtn');
            if (playBtn) {
                playBtn.addEventListener('click', openFreePreviewModal);
            }

            var modal = document.getElementById('freePreviewModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) closeFreePreviewModal();
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeFreePreviewModal();
            });

            if (typeof showSuccess === 'function') {
                window.showReportToast = showSuccess;
            }

            // Hide course report button if already reported
            if (@(isLoggedIn ? "true" : "false")) {
                fetch('/Learner/Reports/Check?type=@SD.ReportTypeCourse&targetId=@Model.Id')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.reported) {
                            var btn = document.querySelector('.report-course-btn');
                            if (btn) {
                                var pill = document.createElement('span');
                                pill.className = 'w-full bg-transparent border border-green-200 dark:border-green-800 text-green-600 dark:text-green-400 py-2.5 rounded-lg text-xs font-bold flex items-center justify-center gap-2';
                                pill.innerHTML = '<i class="fas fa-check-circle"></i> @Html.Raw(Json.Serialize(Localizer["ReportedAlreadyLabel"].Value))';
                                btn.replaceWith(pill);
                            }
                        }
                    }).catch(function () {});
            }
        });

        function switchFreePreviewVideo(videoUrl, title, button) {
            var player = document.getElementById('freePreviewPlayer');
            if (!player || !videoUrl) return;

            // Update active state on buttons
            document.querySelectorAll('#freePreviewModal button[data-video-url]').forEach(function(btn) {
                btn.classList.remove('bg-blue-50', 'dark:bg-blue-900/20', 'border-blue-500');
                btn.classList.add('border-transparent');
            });
            button.classList.add('bg-blue-50', 'dark:bg-blue-900/20', 'border-blue-500');
            button.classList.remove('border-transparent');

            player.querySelector('source').src = videoUrl;
            player.load();
            player.play();
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Enable the content accordion
            const accordionButtons = document.querySelectorAll('.accordion-button');
            accordionButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const item = button.closest('.accordion-item');
                    const content = item.querySelector('.accordion-content');
                    const icon = button.querySelector('i');

                    content.classList.toggle('hidden');
                    icon.classList.toggle('rotate-180');
                });
            });

            // Enable the content tabs (My Learning Style)
            const cdTabs = document.querySelectorAll('#contentTabs .ml-tab');
            const cdPanels = document.querySelectorAll('.ml-panel');
            const cdIndicator = document.getElementById('cdTabIndicator');
            let cdActive = 'overview';

            function cdUpdateIndicator(el) {
                const containerRect = document.getElementById('contentTabs').getBoundingClientRect();
                const elRect = el.getBoundingClientRect();
                if (document.documentElement.dir === 'rtl') {
                    cdIndicator.style.right = (containerRect.right - elRect.right) + 'px';
                    cdIndicator.style.left = 'auto';
                } else {
                    cdIndicator.style.left = (elRect.left - containerRect.left) + 'px';
                    cdIndicator.style.right = 'auto';
                }
                cdIndicator.style.width = elRect.width + 'px';
            }

            const cdActiveInit = document.querySelector('#contentTabs .ml-tab.active');
            if (cdActiveInit && cdIndicator) {
                setTimeout(() => cdUpdateIndicator(cdActiveInit), 50);
            }

            window.addEventListener('resize', () => {
                const curr = document.querySelector('#contentTabs .ml-tab.active');
                if (curr) cdUpdateIndicator(curr);
            });

            cdTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const target = document.getElementById(tab.dataset.tab);
                    if (!target || target.id === cdActive) return;

                    cdUpdateIndicator(tab);

                    const current = document.getElementById(cdActive);
                    if (current) {
                        current.classList.add('animating', 'ml-panel-out');
                        current.addEventListener('animationend', function handler() {
                            current.classList.remove('active', 'animating', 'ml-panel-out');
                            current.removeEventListener('animationend', handler);

                            cdTabs.forEach(t => t.classList.remove('active'));
                            tab.classList.add('active');

                            target.classList.add('active', 'animating', 'ml-panel-in');
                            target.addEventListener('animationend', function h2() {
                                target.classList.remove('animating', 'ml-panel-in');
                                target.removeEventListener('animationend', h2);
                            });
                            cdActive = target.id;
                        });
                    } else {
                        cdTabs.forEach(t => t.classList.remove('active'));
                        tab.classList.add('active');
                        cdPanels.forEach(p => p.classList.remove('active'));
                        target.classList.add('active');
                        cdActive = target.id;
                    }
                });
            });

              // Enable the show comments button
            // Enable the show comments button
            const showCommentsBtn = document.getElementById('showCommentsBtn');
            const commentsSection = document.getElementById('commentsSection');

            if (showCommentsBtn && commentsSection) {
                showCommentsBtn.addEventListener('click', async () => {
                    if (commentsSection.classList.contains('hidden')) {
                        // Load comments the first time the section is shown
                        if (commentsSection.children.length === 0) {
                            await loadComments();
                        }
                        commentsSection.classList.remove('hidden');
                        showCommentsBtn.textContent = @Html.Raw(Json.Serialize(Localizer["HideComments"].Value));
                    } else {
                        commentsSection.classList.add('hidden');
                        showCommentsBtn.textContent = @Html.Raw(Json.Serialize(Localizer["ShowComments"].Value));
                    }
                });
            }

            // Function to load comments from the API
        async function loadComments() {
            try {
                const response = await fetch(`/Learner/Rating/GetCourseRatingsJson?courseId=@Model.Id&page=1&pageSize=50`);
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        displayComments(result.data);
                    } else {
                        commentsSection.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["FailedToLoadComments"].Value))</p>';
                    }
                } else {
                    commentsSection.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["FailedToLoadComments"].Value))</p>';
                }
            } catch (error) {
                console.error('Error loading comments:', error);
                commentsSection.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ErrorLoadingComments"].Value))</p>';
            }
        }

            // Function to render the comments
        function displayComments(ratings) {
            if (!ratings || ratings.length === 0) {
                commentsSection.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center py-8">@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["NoCommentsYet"].Value))</p>';
                return;
            }

            // Sort: reviews with comments first (rating high -> low), then those without comments
            const sortedRatings = [...ratings].sort((a, b) => {
                const aHasComment = a.comment && a.comment.trim() ? 1 : 0;
                const bHasComment = b.comment && b.comment.trim() ? 1 : 0;
                if (aHasComment !== bHasComment) return bHasComment - aHasComment;
                return (b.value || 0) - (a.value || 0);
            });

            const initialCount = 4;
            const visibleRatings = sortedRatings.slice(0, initialCount);
            const hiddenRatings = sortedRatings.slice(initialCount);

            const renderReview = (rating) => {
                const starIcons = Array.from({length: 5}, (_, i) =>
                    i < rating.value ?
                    '<i class="fas fa-star text-yellow-400 text-sm"></i>' :
                    '<i class="far fa-star text-yellow-400 text-sm"></i>'
                ).join('');

                // Resolve the user's profile image
                const apiBase = '@Configuration["ApiBaseUrl"]'.replace(/\/+$/, '');
                let userImage = rating.userProfileImage;
                if (userImage && !userImage.startsWith('http')) {
                    userImage = apiBase + userImage;
                } else if (!userImage) {
                    // Default user image (same as in the Login Partial)
                    userImage = '@Url.Content("~/img/User Logo.png")';
                }

                const timeAgo = formatDate(rating.createdAt);
                const commentText = rating.comment || 'لم يضيف المستخدم تعليقاً';
                const isOwnReview = @(isLoggedIn ? "true" : "false") && rating.userId === currentUserId;
                const reportReviewBtn = !isOwnReview
                    ? `<button type="button" class="report-review-btn ms-auto text-gray-300 hover:text-rose-500 transition-colors cursor-pointer"
                               data-report-type="@SD.ReportTypeReview" data-report-target="${rating.id}" data-report-label="${rating.userName}"
                               title="@Html.Raw(Json.Serialize(Localizer["ReportContent"].Value))">
                        <i class="fas fa-flag text-xs"></i>
                       </button>`
                    : '';

                return `
                    <div class="border-b border-gray-200 dark:border-gray-700 pb-6 last:border-b-0">
                        <div class="flex items-center gap-3.5 mb-3">
                            <img src="${userImage}" alt="${rating.userName}" class="w-10 h-10 rounded-full object-cover shrink-0">
                            <div>
                                <h4 class="font-medium text-gray-800 dark:text-white">${rating.userName}</h4>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <div class="flex items-center gap-0.5">
                                        ${starIcons}
                                    </div>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">${timeAgo}</span>
                                </div>
                            </div>
                            ${reportReviewBtn}
                        </div>
                        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">${commentText}</p>
                    </div>
                `;
            };

            let commentsHTML = visibleRatings.map(renderReview).join('');
            if (hiddenRatings.length > 0) {
                commentsHTML += '<div id="hiddenReviewsWrap" class="space-y-6 mt-6" style="display:none;">' + hiddenRatings.map(renderReview).join('') + '</div>';
            }

            commentsSection.innerHTML = commentsHTML;

            // "Show more" button
            const existingBtn = document.getElementById('showMoreCommentsBtn');
            if (existingBtn) existingBtn.remove();

            if (hiddenRatings.length > 0) {
                const moreBtn = document.createElement('div');
                moreBtn.className = 'text-center mt-6';
                moreBtn.id = 'showMoreCommentsBtn';
                moreBtn.innerHTML = `
                    <button type="button" id="showMoreCommentsInnerBtn" onclick="showMoreComments()"
                            class="text-blue-600 hover:text-blue-700 font-medium flex items-center justify-center gap-2 mx-auto transition-all duration-300">
                        <span>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ShowMoreReviews"].Value))</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                `;
                commentsSection.appendChild(moreBtn);

                const innerBtn = document.getElementById('showMoreCommentsInnerBtn');
                if (innerBtn) {
                    innerBtn.addEventListener('click', showMoreComments);
                }
            }

            // Hide report flags on reviews already reported by this user
            if (@(isLoggedIn ? "true" : "false")) {
                const reviewIds = sortedRatings
                    .filter(r => r.userId !== currentUserId)
                    .map(r => r.id);
                if (reviewIds.length > 0) {
                    fetch('/Learner/Reports/CheckMany?type=@SD.ReportTypeReview&ids=' + reviewIds.join(','))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            (data.reportedIds || []).forEach(function (rid) {
                                const flag = commentsSection.querySelector('[data-report-type="@SD.ReportTypeReview"][data-report-target="' + rid + '"]');
                                if (flag) {
                                    flag.classList.add('opacity-40', 'pointer-events-none');
                                    flag.setAttribute('data-reported', 'true');
                                }
                            });
                        }).catch(function () {});
                }
            }
        }

        // Show the remaining comments
        function showMoreComments() {
            const wrap = document.getElementById('hiddenReviewsWrap');
            if (wrap) {
                wrap.style.display = 'block';
            }
            const btn = document.getElementById('showMoreCommentsBtn');
            if (btn) {
                btn.style.display = 'none';
            }
        }
        window.showMoreComments = showMoreComments;


            // Helper function to format dates
        function formatDate(dateString) {
            try {
                const date = new Date(dateString);
                const now = new Date();
                const diffTime = Math.abs(now - date);
                const diffMinutes = Math.floor(diffTime / (1000 * 60));
                const diffHours = Math.floor(diffTime / (1000 * 60 * 60));
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

                if (diffMinutes < 1) {
                    return '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["JustNow"].Value))';
                } else if (diffMinutes < 60) {
                    return `${diffMinutes} ${@Html.Raw(Json.Serialize(Localizer["MinutesAgo"].Value))}`;
                } else if (diffHours < 24) {
                    return `${diffHours} ${@Html.Raw(Json.Serialize(Localizer["HoursAgo"].Value))}`;
                } else if (diffDays === 1) {
                    return @Html.Raw(Json.Serialize(Localizer["OneDayAgo"].Value));
                } else if (diffDays < 7) {
                    return `${diffDays} ${@Html.Raw(Json.Serialize(Localizer["DaysAgo"].Value))}`;
                } else if (diffDays < 30) {
                    const weeks = Math.floor(diffDays / 7);
                    return `${weeks} ${@Html.Raw(Json.Serialize(Localizer["WeeksAgo"].Value))}`;
                } else {
                    return date.toLocaleDateString('ar-EG', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });
                }
            } catch (error) {
                return @Html.Raw(Json.Serialize(Localizer["UnknownDate"].Value));
            }
        }
        });
    </script>
    <script>
                // Check the user's state when the page loads
        document.addEventListener('DOMContentLoaded', function() {
            // If the user is enrolled in the course, update the UI
            @if (ViewBag.IsUserEnrolled == true)
            {
                    <text>
                    const addToCartBtn = document.querySelector('.add-to-cart-btn');
                    if (addToCartBtn) {
                        addToCartBtn.innerHTML = '<i class="fas fa-play-circle"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StartLearningNow"].Value))';
                        addToCartBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                        addToCartBtn.classList.add('bg-green-600', 'hover:bg-green-700');
                        addToCartBtn.onclick = function() {
                            window.location.href = '@Url.Action("Watch", "Course", new { area = "Learner", id = Model.Id })';
                        };
                    }
                    </text>
            }
        });
                // Add/remove wishlist toggle function for the details page
        // Add/remove wishlist toggle for the details page - corrected version
        async function toggleWishlist(courseId, buttonElement) {
            let button;
            if (buttonElement) {
                button = buttonElement;
            } else {
                button = event.currentTarget;
            }

            const isCurrentlyActive = button.classList.contains('active');
            const action = isCurrentlyActive ? 'remove' : 'add';

            const text = button.querySelector('.btn-text');
            const spinner = button.querySelector('.loading-spinner');

            // Save the original state
            const originalContent = text.innerHTML;

            // Show loading state
            button.classList.add('loading');
            if (spinner) {
                spinner.classList.remove('hidden');
            }
            button.disabled = true;

            try {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = {
                    'Content-Type': 'application/json'
                };

                if (tokenElement) {
                    headers['RequestVerificationToken'] = tokenElement.value;
                }

                const url = action === 'add'
                    ? '/Learner/Wishlist/AddToWishlist'
                    : '/Learner/Wishlist/RemoveFromWishlist';

                console.log(`Sending ${action} request to: ${url} for course: ${courseId}`);

                const response = await fetch(url, {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ courseId: courseId })
                });

                if (response.ok) {
                    const result = await response.json();
                    console.log('Wishlist response:', result);

                    if (result.success) {
                        // Update the state of all buttons for this course
                        updateAllWishlistButtons(courseId, action === 'add');

                        // Update the header counter if present
                        const wishlistCount = document.querySelector('[data-wishlist-count]');
                        if (wishlistCount) {
                            wishlistCount.textContent = result.wishlistCount || 0;
                            wishlistCount.classList.add('wishlist-pulse');
                            wishlistCount.addEventListener('animationend', () => {
                                wishlistCount.classList.remove('wishlist-pulse');
                            }, { once: true });
                        }

                        // Show the success message
                        const message = action === 'add'
                            ? '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AddedToWishlistSuccess"].Value))'
                            : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["RemovedFromWishlistSuccess"].Value))';
                        showSuccess(message);
                        if (window.refreshWishlistDropdown) refreshWishlistDropdown();

                    } else {
                        throw new Error(result.message || @Html.Raw(Json.Serialize(Localizer["OperationFailed"].Value)));
                    }
                } else {
                    const errorText = await response.text();
                    throw new Error(`${@Html.Raw(Json.Serialize(Localizer["ServerConnectionError"].Value))}: ${response.status} - ${errorText}`);
                }
            } catch (error) {
                console.error('Error:', error);

                // Restore the button to its original state on error
                button.classList.remove('loading');
                if (spinner) {
                    spinner.classList.add('hidden');
                }
                text.innerHTML = originalContent;

                showError(error.message || ToastMessages.failedToUpdateWishlist);

                // Re-enable the button after a short delay
                setTimeout(() => {
                    button.disabled = false;
                }, 1000);
            }
        }

        // Update all wishlist buttons for this course on the page - corrected version
        function updateAllWishlistButtons(courseId, isAdded) {
            const buttons = document.querySelectorAll(`button[onclick*="toggleWishlist(${courseId}"]`);

            buttons.forEach(button => {
                const text = button.querySelector('.btn-text');
                const spinner = button.querySelector('.loading-spinner');

                // Remove the loading state first
                button.classList.remove('loading');
                if (spinner) {
                    spinner.classList.add('hidden');
                }
                button.disabled = false;

                if (isAdded) {
                    button.classList.add('active');
                    if (text) {
                        text.innerHTML = '<i class="fas fa-heart text-red-500"></i><span>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["RemoveFromWishlistBtn"].Value))</span>';
                    }
                } else {
                    button.classList.remove('active');
                    if (text) {
                        text.innerHTML = '<i class="far fa-heart"></i><span>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SaveWishlistBtn"].Value))</span>';
                    }
                }
            });
        }
        // Add/remove from cart (toggle) for the details page
        async function toggleCart(courseId, buttonElement = null) {
            let button;
            if (buttonElement) {
                button = buttonElement;
            } else {
                button = event.currentTarget;
            }

            const spinner = button.querySelector('.loading-spinner');

            // Show loading state
            button.classList.add('loading');
            if (spinner) {
                spinner.classList.remove('hidden');
            }
            button.disabled = true;

            try {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = {
                    'Content-Type': 'application/json'
                };

                if (tokenElement) {
                    headers['RequestVerificationToken'] = tokenElement.value;
                }

                const response = await fetch('/Learner/Cart/ToggleCart', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ courseId: courseId, quantity: 1 })
                });

                if (response.ok) {
                    const result = await response.json();

                    if (result.success) {
                        showSuccess(result.message || (result.inCart ? ToastMessages.addedToCartSuccess : ToastMessages.itemRemovedSuccess));
                        if (window.refreshCartDropdown) refreshCartDropdown();

                        // Update the state of all cart buttons for this course
                        updateAllCartButtons(courseId, result.inCart);

                        // Update cart count in header
                        const cartCount = document.querySelector('[data-cart-count]');
                        if (cartCount) {
                            cartCount.textContent = result.cartCount || 0;
                            cartCount.classList.add('cart-pulse');
                            cartCount.addEventListener('animationend', () => {
                                cartCount.classList.remove('cart-pulse');
                            }, { once: true });
                        }

                        // Dynamically manage the "Go to cart" button
                        const buttonsContainer = button.closest('.space-y-3');
                        if (buttonsContainer) {
                            let goToCartBtn = buttonsContainer.querySelector('.go-to-cart-btn');
                            if (result.inCart && !goToCartBtn) {
                                const buyNowButton = buttonsContainer.querySelector('button:last-child');
                                goToCartBtn = document.createElement('a');
                                goToCartBtn.href = '/Learner/Cart';
                                goToCartBtn.className = 'w-full bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 transition transform hover:-translate-y-0.5 shadow-md shadow-blue-500/20 go-to-cart-btn';
                                goToCartBtn.innerHTML = '<i class="fas fa-credit-card"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["GoToCartBtn"].Value))';

                                if (buyNowButton) {
                                    buttonsContainer.insertBefore(goToCartBtn, buyNowButton);
                                } else {
                                    buttonsContainer.appendChild(goToCartBtn);
                                }
                            } else if (!result.inCart && goToCartBtn) {
                                goToCartBtn.remove();
                            }
                        }

                    } else {
                        throw new Error(result.message || 'Failed to update cart');
                    }
                } else {
                    let errorMessage = 'Failed to update cart';
                    try {
                        const errorResult = await response.json();
                        errorMessage = errorResult.message || errorMessage;
                    } catch (e) {
                    }
                    throw new Error(errorMessage);
                }
            } catch (error) {
                console.error('Error:', error);

                // Restore the button to its original state on error
                button.classList.remove('loading');
                if (spinner) {
                    spinner.classList.add('hidden');
                }

                showError(error.message || ToastMessages.errorAddingToCart);

                // Re-enable the button after two seconds
                setTimeout(() => {
                    button.disabled = false;
                }, 2000);
            }
        }

        // Update all cart buttons for this course on the page
        function updateAllCartButtons(courseId, isInCart) {
            const buttons = document.querySelectorAll(`button[onclick*="toggleCart(${courseId}"]`);

            buttons.forEach(button => {
                const text = button.querySelector('.btn-text');
                const spinner = button.querySelector('.loading-spinner');

                // Remove the loading state first
                button.classList.remove('loading');
                if (spinner) {
                    spinner.classList.add('hidden');
                }
                button.disabled = false;

                if (isInCart) {
                    // "In cart" state - orange
                    button.classList.add('active');
                    button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                    button.classList.add('bg-orange-500');
                    if (text) {
                        text.innerHTML = '<i class="fas fa-shopping-cart"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AddedToCartLabel"].Value))';
                    }
                } else {
                    // "Add to cart" state - blue
                    button.classList.remove('active', 'bg-orange-500');
                    button.classList.add('bg-blue-600', 'hover:bg-blue-700');
                    if (text) {
                        text.innerHTML = '<i class="fas fa-shopping-cart"></i> @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AddToCartBtn"].Value))';
                    }
                }
            });
        }

        // Helper function to add an item to the cart from anywhere
        function addToCartFromAnywhere(courseId) {
            toggleCart(courseId);
        }

        // ========== ENFORCE EXACTLY 2 FULL ROWS (Matches ByCategory & Home) ==========
        function enforceTwoRows() {
            const grids = document.querySelectorAll('.swiper-container.grid-mode .swiper-wrapper');
            if (!grids.length) return;

            grids.forEach(grid => {
                const container = grid.closest('section') || grid.parentElement || grid;
                const availableWidth = grid.clientWidth || (container ? container.clientWidth : window.innerWidth);
                const colWidth = 270 + 24; // 270px card + 24px (1.5rem) gap
                const cols = Math.max(1, Math.floor((availableWidth + 24) / colWidth));
                const maxVisible = cols * 2; // Exactly 2 complete rows

                const slides = Array.from(grid.children).filter(el => el.classList.contains('swiper-slide') && !el.classList.contains('browse-more-slide'));
                slides.forEach((slide, idx) => {
                    if (idx < maxVisible) {
                        slide.style.removeProperty('display');
                    } else {
                        slide.style.setProperty('display', 'none', 'important');
                    }
                });
            });
        }
        enforceTwoRows();
        window.addEventListener('resize', enforceTwoRows);
        window.addEventListener('load', enforceTwoRows);
        document.addEventListener('DOMContentLoaded', enforceTwoRows);
    </script>
}
