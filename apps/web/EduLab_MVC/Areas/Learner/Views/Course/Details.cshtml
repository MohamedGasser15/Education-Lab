@using System.Globalization
@using EduLab_MVC.Services.ServiceInterfaces
@using EduLab_MVC.Models.DTOs.Course
@inject IWishlistService WishlistService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model EduLab_MVC.Models.DTOs.Course.CourseDTO
@{
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Model.Title;
    bool isCourseInWishlist = false;
    if (User.Identity.IsAuthenticated)
    {
        isCourseInWishlist = await WishlistService.IsCourseInWishlistAsync(Model.Id);
    }
    var token = Context.Request.Cookies["AuthToken"];
    var isLoggedIn = !string.IsNullOrEmpty(token);

    var freeSection = Model.Sections.FirstOrDefault(s => s.IsFreePreview);
    var freeSectionVideos = freeSection?.Lectures?
        .Where(l => l.ContentType == "Video" && l.VideoUrl != null)
        .ToList() ?? new List<LectureDTO>();
}
@functions {

    public string FormatRating(double rating)
    {
        return rating.ToString("0.0");
    }

    // New function to render the @Localizer["StarsLabel"]
    public string GetStarRating(double rating)
    {
        var fullStars = (int)Math.Floor(rating);
        var halfStar = rating - fullStars >= 0.5;
        var emptyStars = 5 - fullStars - (halfStar ? 1 : 0);

        var stars = "";

        // @Localizer["StarsLabel"] filled stars
        for (int i = 0; i < fullStars; i++)
        {
            stars += "<i class='fas fa-star text-yellow-400'></i>";
        }

        // Half star
        if (halfStar)
        {
            stars += "<i class='fas fa-star-half-alt text-yellow-400'></i>";
        }

        // @Localizer["StarsLabel"] empty stars
        for (int i = 0; i < emptyStars; i++)
        {
            stars += "<i class='far fa-star text-yellow-400'></i>";
        }

        return stars;
    }
}
<style>
    body {
        overflow-x: hidden;
    }
    /* Colors for the different states */
    .bg-orange-500 {
        background-color: #f97316 !important;
    }

        .bg-orange-500:hover {
            background-color: #ea580c !important;
        }

    .bg-green-600 {
        background-color: #16a34a !important;
    }

        .bg-green-600:hover {
            background-color: #15803d !important;
        }

    /* Improve the appearance of the cart buttons */
    .add-to-cart-btn {
        position: relative;
        transition: all 0.3s ease;
    }

        .add-to-cart-btn.loading {
            cursor: not-allowed;
            opacity: 0.8;
        }

        .add-to-cart-btn .loading-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .add-to-cart-btn.loading .loading-spinner {
            opacity: 1;
        }

        .add-to-cart-btn.loading .btn-text {
            opacity: 0;
        }
    /* Improvements for the wishlist button on the details page */
    .wishlist-btns {
        position: relative;
        overflow: hidden;
    }

        .wishlist-btns.loading {
            cursor: not-allowed;
            opacity: 0.7;
        }

        .wishlist-btns .btn-text {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .wishlist-btns.loading .btn-text {
            opacity: 0;
        }

        .wishlist-btns .loading-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
        }

        .wishlist-btns.loading .loading-spinner {
            opacity: 1;
        }

        .wishlist-btns.active {
            border-color: #ef4444 !important;
            color: #ef4444 !important;
            background-color: #fef2f2 !important;
        }
        .dark .wishlist-btn.active {
            background-color: rgba(239, 68, 68, 0.12) !important;
        }

            .wishlist-btns.active .btn-text {
                color: #ef4444;
            }

    @@keyframes wishlistPulse {
        0%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    100% {
        transform: scale(1);
    }

    }

    .wishlist-pulse {
        animation: wishlistPulse 0.4s ease-in-out;
    }

    /* Improvements for the button in its loading state */
    .wishlist-btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    /* ========== TABS (My Learning Style) ========== */
    .ml-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e5e7eb;
        margin-bottom: 24px;
        position: relative;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        /* Padding so the indicator isn't clipped by overflow-x */
        padding-bottom: 2px;
    }
    .dark .ml-tabs { border-bottom-color: #334155; }

    .ml-tabs::-webkit-scrollbar { display: none; }

    .ml-tab {
        padding: 14px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        border: none;
        background: none;
        position: relative;
        transition: color 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        outline: none;
    }
    .dark .ml-tab { color: #94a3b8; }
    .ml-tab:hover { color: #374151; }
    .dark .ml-tab:hover { color: #e2e8f0; }

    .ml-tab.active { color: #2563eb; }
    .dark .ml-tab.active { color: #60a5fa; }

    .ml-tab-indicator {
        position: absolute;
        bottom: 0;
        height: 2px;
        background: #2563eb;
        border-radius: 2px;
        transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1), width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
    }
    .dark .ml-tab-indicator { background: #60a5fa; }

    .ml-tab-icon {
        font-size: 0.85rem;
        opacity: 0.7;
    }
    .ml-tab.active .ml-tab-icon { opacity: 1; }

    .ml-tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px; height: 22px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0 6px;
        background: #f3f4f6;
        color: #6b7280;
        transition: all 0.2s;
    }
    .dark .ml-tab-count { background: #1e293b; color: #94a3b8; }
    .ml-tab.active .ml-tab-count {
        background: #dbeafe;
        color: #2563eb;
    }
    .dark .ml-tab.active .ml-tab-count {
        background: #1e3a5f;
        color: #60a5fa;
    }

    .ml-panel { display: none; }
    .ml-panel.active { display: block; }
    .ml-panel.animating { display: block; }

    .ml-panel-out {
        animation: mlSlideOut 0.25s ease forwards;
    }
    .ml-panel-in {
        animation: mlSlideIn 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @@keyframes mlSlideOut {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(-20px); }
    }
    @@keyframes mlSlideIn {
        from { opacity: 0; transform: translateX(20px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* Staggered entrance for the cards - same style as My Learning */
    .ml-panel .cd-card,
    .ml-panel .accordion-item {
        opacity: 0;
        transform: translateY(16px);
    }

    .ml-panel-in .cd-card,
    .ml-panel-in .accordion-item {
        animation: mlCardUp 0.4s ease forwards;
    }

    .ml-panel-in .accordion-item:nth-child(1)  { animation-delay: 0.05s; }
    .ml-panel-in .accordion-item:nth-child(2)  { animation-delay: 0.10s; }
    .ml-panel-in .accordion-item:nth-child(3)  { animation-delay: 0.15s; }
    .ml-panel-in .accordion-item:nth-child(4)  { animation-delay: 0.20s; }
    .ml-panel-in .accordion-item:nth-child(5)  { animation-delay: 0.25s; }
    .ml-panel-in .accordion-item:nth-child(n+6) { animation-delay: 0.30s; }

    .ml-panel.active .cd-card,
    .ml-panel.active .accordion-item,
    .ml-panel:not(.animating) .cd-card,
    .ml-panel:not(.animating) .accordion-item {
        opacity: 1;
        transform: none;
        animation: none;
    }

    @@keyframes mlCardUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ========== GRID MODE (Matches ByCategory & Home - Fixed 270px cards without stretching) ========== */
    .swiper-container.grid-mode .swiper-wrapper {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, 270px) !important;
        justify-content: start !important;
        gap: 1.5rem !important;
        transform: none !important;
        width: 100% !important;
        padding: 1rem 0 !important;
    }

    .swiper-container.grid-mode .swiper-slide {
        width: 270px !important;
        max-width: 270px !important;
        min-width: 270px !important;
        height: auto !important;
        margin: 0 !important;
    }

    .swiper-container.grid-mode ~ .swiper-button-prev,
    .swiper-container.grid-mode ~ .swiper-button-next,
    .swiper-container.grid-mode ~ .swiper-pagination {
        display: none !important;
    }

    .swiper-container.grid-mode .browse-more-slide {
        display: none !important;
    }

    @@media (max-width: 580px) {
        .swiper-container.grid-mode .swiper-wrapper {
            grid-template-columns: 1fr !important;
            justify-items: center !important;
        }
        .swiper-container.grid-mode .swiper-slide {
            width: 100% !important;
            max-width: 300px !important;
            min-width: 0 !important;
        }
    }
    </style>
<!-- Breadcrumb trail -->
<div class="container mx-auto px-4 pt-4">
    <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center gap-1.5 md:gap-2 flex-wrap">
            <li class="inline-flex items-center">
                <a asp-area="Learner" asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                    <i class="fas fa-home"></i>
                    <span>@Localizer["HomeBreadcrumb"]</span>
                </a>
            </li>
            <li class="inline-flex items-center">
                <div class="flex items-center gap-1.5 md:gap-2">
                    <i class="fas fa-chevron-@(isArabic ? "left" : "right") text-gray-400 text-xs"></i>
                    <a asp-area="Learner" asp-controller="Course" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">@Localizer["CoursesBreadcrumb"]</a>
                </div>
            </li>
            <li aria-current="page" class="inline-flex items-center">
                <div class="flex items-center gap-1.5 md:gap-2">
                    <i class="fas fa-chevron-@(isArabic ? "left" : "right") text-gray-400 text-xs"></i>
                    <span class="text-sm font-medium text-blue-600 dark:text-blue-400 truncate inline-block align-bottom max-w-[140px] md:max-w-[320px]">@Model.Title</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<section class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 order-2 lg:order-1">
            <!-- Course Title -->
            <h1 class="text-2xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2 leading-snug">@Model.Title</h1>

            <!-- Short Description -->
            <p class="text-gray-600 dark:text-gray-300 mb-4 text-base md:text-lg">@Model.ShortDescription</p>

            <!-- Rating and Basic Info -->
            <div class="flex flex-wrap items-center gap-3 md:gap-4 mb-6">
                <div class="flex items-center gap-2.5 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full text-sm">
                    <div class="flex items-center gap-1.5">
                        <i class="fas fa-star text-yellow-400 text-sm"></i>
                        <span class="text-gray-800 dark:text-white font-semibold">@(Model.AverageRating.ToString("0.0"))</span>
                    </div>
                    <span class="text-gray-500 dark:text-gray-400 text-xs md:text-sm">(@Model.TotalRatings @Localizer["RatingLabel"])</span>
                </div>

                <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-medium">
                    <i class="fas fa-user-graduate text-blue-500"></i>
                    <span>@Model.EnrollmentCount.ToString("N0") @Localizer["StudentLabel"]</span>
                </div>

                <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-medium">
                    <i class="fas fa-clock text-blue-500"></i>
                    <span>@(Model.Duration / 3600) @Localizer["HourUnit"]</span>
                </div>

                <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-medium">
                    <i class="fas fa-calendar-alt text-blue-500"></i>
                    <span>
                        @Localizer["UpdatedLabel"]: @Model.CreatedAt.ToString("MMMM yyyy", CultureInfo.CurrentUICulture)
                    </span>
                </div>
            </div>

            <!-- Instructor -->
            <div class="flex items-center gap-3.5 mb-6 p-4 bg-gray-50 dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                @if (string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 border-2 border-white dark:border-gray-600 shadow-sm flex items-center justify-center shrink-0">
                        <i class="fas fa-user text-blue-500 dark:text-blue-400 text-xl"></i>
                    </div>
                }
                else
                {
                    <img src="@Model.ProfileImageUrl"
                         alt='@Localizer["InstructorAlt"]'
                         class="w-12 h-12 rounded-full object-cover border-2 border-white dark:border-gray-600 shadow-sm shrink-0">
                }

                <div class="min-w-0 flex-1">
                    <h3 class="font-medium text-gray-800 dark:text-white truncate">@Model.InstructorName</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 truncate">@Model.Title</p>
                </div>
                <a asp-area="Learner"
                   asp-controller="Profile"
                   asp-action="InstructorProfile"
                   asp-route-id="@Model.InstructorId"
                   class="ms-auto shrink-0 text-blue-600 dark:text-blue-400 hover:underline text-xs md:text-sm inline-flex items-center gap-2 transition-transform rtl:hover:-translate-x-1 ltr:hover:translate-x-1">
                    <span>@Localizer["ViewProfileDetails"]</span>
                    <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-xs"></i>
                </a>

            </div>

            <div class="mb-8">
                <div class="ml-tabs" id="contentTabs">
                    <button class="ml-tab active" data-tab="overview">
                        <i class="fas fa-eye ml-tab-icon"></i> @Localizer["OverviewTab"]
                    </button>
                    <button class="ml-tab" data-tab="contents">
                        <i class="fas fa-list-ul ml-tab-icon"></i> @Localizer["ContentsTab"]
                        <span class="ml-tab-count">@Model.Sections.Count</span>
                    </button>
                    <button class="ml-tab" data-tab="ratings">
                        <i class="fas fa-star ml-tab-icon"></i> @Localizer["RatingsTab"]
                        <span class="ml-tab-count">@Model.TotalRatings</span>
                    </button>
                    <button class="ml-tab" data-tab="faq">
                        <i class="fas fa-question-circle ml-tab-icon"></i> @Localizer["FAQTab"]
                    </button>
                    <div class="ml-tab-indicator" id="cdTabIndicator"></div>
                </div>

                <!-- @Localizer["OverviewTab"] tab content -->
                <div id="overview" class="ml-panel active">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 md:p-6 cd-card">
                        <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white mb-4">@Localizer["WhatYouWillLearn"]</h2>

                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mb-6">
                            @foreach (var learning in Model.Learnings)
                            {
                                <li class="flex items-start gap-3">
                                    <i class="fas fa-check text-green-500 mt-1 shrink-0 text-sm"></i>
                                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm md:text-base">@learning</span>
                                </li>
                            }
                        </ul>

                        <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white mb-4">@Localizer["CourseRequirements"]</h2>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mb-6">
                            @foreach (var requirement in Model.Requirements)
                            {
                                <li class="flex items-start gap-3">
                                    <i class="fas fa-circle text-[6px] text-gray-400 dark:text-gray-500 mt-2.5 shrink-0"></i>
                                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm md:text-base">@requirement</span>
                                </li>
                            }
                        </ul>

                        <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white mb-4">@Localizer["CourseDescription"]</h2>
                        <div class="prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 break-words whitespace-normal">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>
                </div>

                <!-- @Localizer["ContentsTab"] tab content -->
                <div id="contents" class="ml-panel">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden cd-card">
                        <div class="border-b border-gray-200 dark:border-gray-700 px-5 md:px-6 py-4">
                            <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white">@Localizer["CourseContentTitle"]</h2>
                        </div>

                        <div class="p-3 md:p-4 space-y-3">
                            @foreach (var section in Model.Sections)
                            {
                                <div class="accordion-item border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
                                    <button class="accordion-button flex justify-between items-center w-full px-4 md:px-5 py-3.5 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition text-start">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <span class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
                                                <i class="fas fa-chevron-down text-xs transform transition-transform duration-300"></i>
                                            </span>
                                            <span class="font-medium text-gray-800 dark:text-white truncate">@(section.Title)</span>
                                        </div>
                                        <span class="text-xs text-gray-500 dark:text-gray-400 flex-shrink-0 ms-3">@(section.Lectures.Count) @Localizer["LectureUnit"] • @(section.Lectures.Sum(l => l.Duration) / 60) @Localizer["MinuteUnit"]</span>
                                    </button>

                                    <div class="accordion-content hidden">
                                        <div class="divide-y divide-gray-100 dark:divide-gray-700/60">
                                            @foreach (var lecture in section.Lectures)
                                            {
                                                <div class="flex items-center justify-between px-4 md:px-5 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition cursor-pointer">
                                                    <div class="flex items-center gap-3 min-w-0">
                                                        @if (lecture.ContentType == "Video")
                                                        {
                                                            <span class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
                                                                <i class="fas fa-play text-[10px]"></i>
                                                            </span>
                                                        }
                                                        else if (lecture.ContentType == "Article")
                                                        {
                                                            <span class="w-7 h-7 rounded-lg bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 flex items-center justify-center flex-shrink-0">
                                                                <i class="fas fa-file-alt text-[10px]"></i>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="w-7 h-7 rounded-lg bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0">
                                                                <i class="fas fa-question text-[10px]"></i>
                                                            </span>
                                                        }
                                                        <span class="text-sm text-gray-700 dark:text-gray-300 truncate">@lecture.Title</span>
                                                    </div>
                                                    <span class="text-xs text-gray-400 dark:text-gray-500 flex-shrink-0">@TimeSpan.FromSeconds(lecture.Duration).ToString(@"mm\:ss")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="px-5 md:px-6 py-4 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 text-center">
                            <p class="text-sm text-gray-600 dark:text-gray-300">@Model.Sections.Count @Localizer["SectionUnit"] • @Model.TotalLectures @Localizer["LectureUnit"] • @(Model.Duration / 3600) @Localizer["TotalContentHours"]</p>
                        </div>
                    </div>
                </div>

                <div id="ratings" class="ml-panel">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden cd-card">
                        <div class="border-b border-gray-200 dark:border-gray-700 px-5 md:px-6 py-4">
                            <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white">@Localizer["StudentReviews"]</h2>
                        </div>

                        <div class="p-6">
                            <div class="flex flex-col md:flex-row items-center gap-8 mb-8">
                                <div class="text-center">
                                    <div class="text-5xl font-bold text-gray-800 dark:text-white mb-1">@Model.AverageRating.ToString("0.0")</div>
                                    <div class="flex justify-center mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(Model.AverageRating))
                                            {
                                                <i class="fas fa-star text-yellow-400"></i>
                                            }
                                            else if (i == Math.Ceiling(Model.AverageRating) && Model.AverageRating % 1 >= 0.5)
                                            {
                                                <i class="fas fa-star-half-alt text-yellow-400"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-yellow-400"></i>
                                            }
                                        }
                                    </div>
                                    <p class="text-gray-500 dark:text-gray-400">@Model.TotalRatings @Localizer["RatingLabel"]</p>
                                </div>

                                <div class="flex-1 w-full space-y-3">
                                    @for (int rating = 5; rating >= 1; rating--)
                                    {
                                        var count = (Model.RatingDistribution != null && Model.RatingDistribution.ContainsKey(rating)) ? Model.RatingDistribution[rating] : 0;
                                        var percentage = Model.TotalRatings > 0 ? (count * 100.0) / Model.TotalRatings : 0.0;
                                        var percentCss = percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center gap-1.5 min-w-[80px] sm:min-w-[90px] shrink-0 text-sm font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                                <span>@rating</span>
                                                <span class="text-xs text-gray-500 dark:text-gray-400">@Localizer["StarsLabel"]</span>
                                                <i class="fas fa-star text-yellow-400 text-xs"></i>
                                            </div>
                                            <div class="flex-1 h-2.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                                <div class="h-full bg-yellow-400 rounded-full transition-all duration-500" style="width: @(percentCss)%;"></div>
                                            </div>
                                            <span class="w-12 text-end text-xs sm:text-sm font-semibold text-gray-500 dark:text-gray-400 shrink-0">@percentage.ToString("0")%</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mt-6 text-center">
                                <button id="showCommentsBtn" class="px-6 py-2 border border-blue-600 text-blue-600 dark:text-blue-400 rounded-lg hover:bg-blue-50 dark:hover:bg-gray-700 transition">
                                    @Localizer["ShowComments"]
                                </button>
                            </div>

                            <div id="commentsSection" class="hidden space-y-6 mt-6">
                            </div>
                        </div>
                    </div>
                </div>
                <div id="faq" class="ml-panel">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden cd-card">
                        <div class="border-b border-gray-200 dark:border-gray-700 px-5 md:px-6 py-4">
                            <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white">@Localizer["FAQTab"]</h2>
                        </div>

                        <div class="p-6">
                            <div class="space-y-4">
                                <div class="accordion-item border-b border-gray-200 dark:border-gray-700 pb-4">
                                    <button class="accordion-button flex justify-between items-center w-full text-start">
                                        <span class="font-medium text-gray-800 dark:text-white">@Localizer["FAQ1Q"]</span>
                                        <i class="fas fa-chevron-down text-xs transform transition-transform duration-300"></i>
                                    </button>
                                    <div class="accordion-content hidden mt-2">
                                        <p class="text-gray-600 dark:text-gray-300">@Localizer["FAQ1A"]</p>
                                    </div>
                                </div>

                                <div class="accordion-item border-b border-gray-200 dark:border-gray-700 pb-4">
                                    <button class="accordion-button flex justify-between items-center w-full text-start">
                                        <span class="font-medium text-gray-800 dark:text-white">@Localizer["FAQ2Q"]</span>
                                        <i class="fas fa-chevron-down text-xs transform transition-transform duration-300"></i>
                                    </button>
                                    <div class="accordion-content hidden mt-2">
                                        <p class="text-gray-600 dark:text-gray-300">@Localizer["FAQ2A"]</p>
                                    </div>
                                </div>

                                <div class="accordion-item border-b border-gray-200 dark:border-gray-700 pb-4">
                                    <button class="accordion-button flex justify-between items-center w-full text-start">
                                        <span class="font-medium text-gray-800 dark:text-white">@Localizer["FAQ3Q"]</span>
                                        <i class="fas fa-chevron-down text-xs transform transition-transform duration-300"></i>
                                    </button>
                                    <div class="accordion-content hidden mt-2">
                                        <p class="text-gray-600 dark:text-gray-300">@Localizer["FAQ3A"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Instructor info -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md border border-gray-100 dark:border-gray-700 overflow-hidden mb-8 mt-8 md:mt-16">
                    <div class="border-b border-gray-200 dark:border-gray-700 px-5 py-4">
                        <h2 class="text-lg md:text-xl font-bold text-gray-800 dark:text-white">@Localizer["AboutInstructor"]</h2>
                    </div>

                    <div class="p-5 md:p-6">
                        <div class="flex items-center gap-4 md:gap-6">
                            <div class="flex-shrink-0">
                                @if (string.IsNullOrEmpty(Model.ProfileImageUrl))
                                {
                                    <div class="w-16 h-16 md:w-24 md:h-24 rounded-2xl md:rounded-full bg-blue-100 dark:bg-gray-700 border-2 md:border-4 border-blue-100 dark:border-gray-700 flex items-center justify-center">
                                        <i class="fas fa-user text-blue-500 dark:text-gray-400 text-2xl md:text-5xl"></i>
                                    </div>
                                }
                                else
                                {
                                    <img src="@Model.ProfileImageUrl" alt='@Localizer["InstructorAlt"]' class="w-16 h-16 md:w-24 md:h-24 rounded-2xl md:rounded-full object-cover border-2 md:border-4 border-blue-100 dark:border-gray-700 shadow-sm">
                                }
                            </div>

                            <div class="min-w-0">
                                <h3 class="text-lg md:text-2xl font-bold text-gray-800 dark:text-white truncate">@Model.InstructorName</h3>
                                <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 truncate">@Model.Title</p>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-2.5 md:gap-3 mt-4 mb-4">
                            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full">
                                <i class="fas fa-user-graduate text-blue-500 shrink-0"></i>
                                <span>5,320 @Localizer["StudentLabel"]</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full">
                                <i class="fas fa-play-circle text-blue-500 shrink-0"></i>
                                <span>@ViewBag.Count @Localizer["CourseUnit"]</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 px-3.5 py-1.5 rounded-full">
                                <i class="fas fa-star text-blue-500 shrink-0"></i>
                                <span>4.9 @Localizer["RatingItemLabel"]</span>
                            </div>
                        </div>

                        <p class="text-sm md:text-base text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">
                            @Model.InstructorAbout
                        </p>

                        <div class="flex flex-wrap gap-2 mb-5">
                            @foreach (var subject in Model.InstructorSubjects)
                            {
                                <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full text-xs md:text-sm">@subject</span>
                            }
                        </div>
                        <a asp-area="Learner"
                           asp-controller="Profile"
                           asp-action="InstructorProfile"
                           asp-route-id="@Model.InstructorId"
                           class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold text-sm md:text-base hover:underline">
                            <span>@Localizer["ViewAllCourses"]</span>
                            <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-xs"></i>
                        </a>

                    </div>
                </div>
                @if (ViewBag.InstructorCourses != null && ((List<EduLab_MVC.Models.DTOs.Course.CourseDTO>)ViewBag.InstructorCourses).Any())
                {
                    <section class="mt-8 pt-4">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="fas fa-user-tie text-blue-500"></i>
                                @Localizer["OtherCoursesFrom"] @Model.InstructorName
                            </h2>
                            <a asp-area="Learner"
                               asp-controller="Profile"
                               asp-action="InstructorProfile"
                               asp-route-id="@Model.InstructorId" class="text-blue-500 hover:text-blue-700 dark:hover:text-blue-400 flex items-center gap-2">
                                @Localizer["ViewAllCourses"]
                                <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-sm"></i>
                            </a>
                        </div>


                        <div class="relative">
                            <div class="swiper-container grid-mode py-2">
                                <div class="swiper-wrapper">
                                    @foreach (EduLab_MVC.Models.DTOs.Course.CourseDTO course in ViewBag.InstructorCourses)
                                    {
                                        @await Html.PartialAsync("_CourseCard", course)
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>

        <!-- Right Section (Course Purchase) - appears first on mobile -->
        <div class="lg:col-span-1 order-1 lg:order-2">
            <div class="lg:sticky lg:top-24 space-y-6">
                <!-- Video Preview -->
                @if (freeSection != null && freeSectionVideos.Any())
                {
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md border border-gray-200 dark:border-gray-700 overflow-hidden transition duration-300 hover:shadow-2xl cursor-pointer" id="previewVideoContainer" onclick="openFreePreviewModal()">

                        <!-- Video thumbnail -->
                        <div class="relative aspect-video bg-black">
                            <img src="@Model.ThumbnailUrl"
                                 alt="Preview Thumbnail"
                                 class="absolute inset-0 w-full h-full object-cover" />

                            <!-- Play button -->
                            <div class="absolute inset-0 flex items-center justify-center">
                                <button id="playPreviewBtn"
                                        class="bg-blue-600 hover:bg-blue-700 text-white rounded-full w-16 h-16 flex items-center justify-center shadow-lg transition-all duration-300 hover:scale-110 focus:ring-4 focus:ring-blue-300 pointer-events-none">
                                    <i class="fas fa-play text-2xl pl-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                }
                else
                {
                    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-xl">
                        <div class="relative pt-[56.25%] bg-black rounded-t-xl">
                            <img src="@Model.ThumbnailUrl"
                                 alt="Thumbnail"
                                 class="absolute top-0 left-0 w-full h-full object-cover rounded-t-xl" />
                        </div>
                    </div>
                }

                <!-- Course Purchase Card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-xl">
                    <div class="p-6">
                        <!-- Price Section -->
                        <div class="flex items-center justify-between gap-3 mb-4">
                            <div class="flex items-baseline gap-2.5 flex-wrap">
                                @{
                                    var finalPrice = Math.Max(0, Model.Price - (Model.Price * (Model.Discount ?? 0) / 100));
                                }
                                @if (finalPrice <= 0)
                                {
                                    <span class="text-2xl font-bold text-green-600 dark:text-green-400 inline-flex items-center gap-2">
                                        <i class="fas fa-gift text-xl"></i> @Localizer["Free"]
                                    </span>
                                }
                                else
                                {
                                    <span class="text-2xl font-bold text-gray-800 dark:text-white">@finalPrice.ToString("0") @Localizer["CurrencyEGP"]</span>
                                }
                                @if (Model.Discount > 0 && finalPrice > 0)
                                {
                                    <span class="text-sm text-gray-500 dark:text-gray-400 line-through">@Model.Price.ToString("0") @Localizer["CurrencyEGP"]</span>
                                }
                            </div>
                            @if (Model.Discount > 0 && finalPrice > 0)
                            {
                                <span class="bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-300 text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">@Localizer["SavePercentLabel"] @Model.Discount%</span>
                            }
                        </div>

                        @* <!-- Discount Timer -->
                        <div class="bg-yellow-50 dark:bg-yellow-900/10 border border-yellow-200 dark:border-yellow-800 rounded-lg p-3 mb-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center text-yellow-700 dark:text-yellow-300 text-sm">
                                    <i class="fas fa-clock ms-2"></i>
                                    <span>العرض ينتهي خلال:</span>
                                </div>
                                <div class="font-mono font-bold text-yellow-700 dark:text-yellow-300">48:00:00</div>
                            </div>
                            <div class="w-full bg-yellow-200 dark:bg-yellow-800 rounded-full h-1.5 mt-2">
                                <div class="bg-yellow-500 h-1.5 rounded-full" style="width: 75%"></div>
                            </div>
                        </div> *@

                        <!-- Action Buttons -->
                        <div class="space-y-3 mb-6">
                            @if (ViewBag.IsUserEnrolled == true)
                            {
                                <a href="@Url.Action("Learn", "Course", new { area = "Learner", id = Model.Id })"
                                   class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 transition transform hover:-translate-y-0.5">
                                    <i class="fas fa-play-circle"></i>
                                    @Localizer["StartLearningNow"]
                                </a>
                            }
                            else if (ViewBag.IsCourseInCart == true)
                            {
                                <button onclick="toggleCart(@Model.Id, this)"
                                        class="w-full bg-orange-500 text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 transition transform hover:-translate-y-0.5 add-to-cart-btn active">
                                    <span class="btn-text">
                                        <i class="fas fa-shopping-cart"></i>
                                        @Localizer["AddedToCartLabel"]
                                    </span>
                                    <span class="loading-spinner hidden">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>

                                <a href="@Url.Action("Index", "Cart", new { area = "Learner" })"
                                   class="w-full bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 transition transform hover:-translate-y-0.5 shadow-md shadow-blue-500/20 go-to-cart-btn">
                                    <i class="fas fa-credit-card"></i>
                                    @Localizer["GoToCartBtn"]
                                </a>
                            }
                            else
                            {
                                <button onclick="toggleCart(@Model.Id, this)"
                                        class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 transition transform hover:-translate-y-0.5 add-to-cart-btn">
                                    <span class="btn-text">
                                        <i class="fas fa-shopping-cart"></i>
                                        @Localizer["AddToCartBtn"]
                                    </span>
                                    <span class="loading-spinner hidden">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            }
                            @if (isLoggedIn)
                            {
                                <button onclick="toggleWishlist(@Model.Id, this)"
                                        class="wishlist-btns w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 hover:bg-gray-50 dark:hover:bg-gray-600 @(isCourseInWishlist ? "active" : "")">
                                    <span class="btn-text flex items-center gap-2">
                                        @if (isCourseInWishlist)
                                        {
                                            <i class="fas fa-heart text-red-500"></i>
                                            <span>@Localizer["RemoveFromWishlistBtn"]</span>
                                        }
                                        else
                                        {
                                            <i class="far fa-heart"></i>
                                            <span>@Localizer["SaveWishlistBtn"]</span>
                                        }
                                    </span>
                                    <span class="loading-spinner hidden">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                </button>
                            }
                            @if (isLoggedIn)
                            {
                                <button type="button" data-report-type="@SD.ReportTypeCourse" data-report-target="@Model.Id"
                                        data-report-label="@Model.Title"
                                        class="report-course-btn w-full bg-transparent border border-gray-200 dark:border-gray-700 text-gray-400 hover:text-rose-500 hover:border-rose-300 dark:hover:border-rose-500/50 py-2.5 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition-all">
                                    <i class="fas fa-flag"></i> @Localizer["ReportThisCourse"]
                                </button>
                            }
                        </div>

                        <!-- Money Back Guarantee -->
                        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 text-sm text-green-700 dark:text-green-300 mb-6 shadow-sm">
                            <div class="flex items-center gap-3 mb-2">
                                <i class="fas fa-shield-alt text-xl text-green-600 dark:text-green-400"></i>
                                <span class="font-bold">@Localizer["MoneyBackGuarantee"]</span>
                            </div>
                            <p class="leading-relaxed mb-3">
                                @Localizer["MoneyBackGuaranteeDesc"]
                            </p>
                            <a href="@Url.Action("Transactions", "Payment", new { area = "Learner" })" class="text-blue-600 dark:text-blue-400 font-bold hover:underline flex items-center gap-1">
                                @Localizer["ManageRefundRequests"]
                                <i class="fas fa-external-link-alt text-xs"></i>
                            </a>
                        </div>
                        <div class="grid grid-cols-3 gap-3 mb-6 text-center">
                            <div class="bg-gray-50 dark:bg-gray-700 p-2.5 rounded-xl">
                                <div class="text-lg font-bold text-gray-800 dark:text-white">@Model.AverageRating.ToString("0.0")</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400 flex items-center justify-center gap-1.5 mt-0.5">
                                    <i class="fas fa-star text-yellow-400 text-xs"></i>
                                    <span>@Localizer["RatingLabel"]</span>
                                </div>
                            </div>
                            <div class="bg-gray-50 dark:bg-gray-700 p-2.5 rounded-xl">
                                <div class="text-lg font-bold text-gray-800 dark:text-white">@Model.EnrollmentCount.ToString("N0")</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400 flex items-center justify-center gap-1.5 mt-0.5">
                                    <i class="fas fa-users text-blue-500 text-xs"></i>
                                    <span>@Localizer["StudentsLabel"]</span>
                                </div>
                            </div>
                            <div class="bg-gray-50 dark:bg-gray-700 p-2.5 rounded-xl">
                                <div class="text-lg font-bold text-gray-800 dark:text-white">@(Model.Duration / 3600)</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400 flex items-center justify-center gap-1.5 mt-0.5">
                                    <i class="fas fa-clock text-blue-500 text-xs"></i>
                                    <span>@Localizer["HoursLabel"]</span>
                                </div>
                            </div>
                        </div>
                        <!-- Course Features -->
                        <div class="space-y-3 mb-2">
                            <div class="flex items-center gap-3">
                                <div class="text-blue-500 dark:text-blue-400 shrink-0">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <span class="text-sm text-gray-700 dark:text-gray-300">@(Model.Duration / 3600) @Localizer["VideoOnDemandHours"]</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="text-blue-500 dark:text-blue-400 shrink-0">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <span class="text-sm text-gray-700 dark:text-gray-300">@Localizer["TVPhoneAccess"]</span>
                            </div>
                            @if (Model.HasCertificate)
                            {
                                <div class="flex items-center gap-3">
                                    <div class="text-blue-500 dark:text-blue-400 shrink-0">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <span class="text-sm text-gray-700 dark:text-gray-300">@Localizer["CertifiedCompletionCertificate"]</span>
                                </div>
                            }
                            <div class="flex items-center gap-3">
                                <div class="text-blue-500 dark:text-blue-400 shrink-0">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <span class="text-sm text-gray-700 dark:text-gray-300">@Localizer["LifetimeAccess"]</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="text-blue-500 dark:text-blue-400 shrink-0">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <span class="text-sm text-gray-700 dark:text-gray-300">@Localizer["PracticalExercises"]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Course Share -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-gray-200 dark:border-gray-700 p-5 transition-all duration-300 hover:shadow-lg">
                    <h3 class="font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2.5">
                        <i class="fas fa-share-alt text-blue-500"></i>
                        <span>@Localizer["ShareThisCourse"]</span>
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-blue-600 text-white rounded-full hover:bg-blue-700 transition transform hover:-translate-y-0.5" aria-label="Share on Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-blue-400 text-white rounded-full hover:bg-blue-500 transition transform hover:-translate-y-0.5" aria-label="Share on Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-red-600 text-white rounded-full hover:bg-red-700 transition transform hover:-translate-y-0.5" aria-label="Share on YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-gray-700 text-white rounded-full hover:bg-gray-800 transition transform hover:-translate-y-0.5" aria-label="Share on WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition transform hover:-translate-y-0.5" aria-label="Share on LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="#" class="w-10 h-10 flex items-center justify-center bg-gray-800 text-white rounded-full hover:bg-gray-900 transition transform hover:-translate-y-0.5" aria-label="Copy link">
                            <i class="fas fa-link"></i>
                        </a>
                    </div>
                </div>
                <!-- Similar Courses -->
                @if (ViewBag.SimilarCourses != null && ((List<EduLab_MVC.Models.DTOs.Course.CourseDTO>)ViewBag.SimilarCourses).Any())
                {
                    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-xl">
                        <div class="border-b border-gray-200 dark:border-gray-700 px-5 py-4 bg-gray-50 dark:bg-gray-700">
                            <h3 class="font-semibold text-lg text-gray-800 dark:text-white flex items-center gap-2.5">
                                <i class="fas fa-layer-group text-blue-500"></i>
                                <span>@Localizer["RelatedCourses"]</span>
                            </h3>
                        </div>

                        <div class="divide-y divide-gray-200 dark:divide-gray-700">
                            @foreach (var course in ViewBag.SimilarCourses)
                            {
                                <a href="@Url.Action("Details", "Course", new { area = "Learner", id = course.Id })" class="block p-4 hover:bg-gray-50 dark:hover:bg-gray-700 transition duration-200 group">
                                    <div class="flex items-start gap-3">
                                        <div class="relative">
                                            <img src="@course.ThumbnailUrl"
                                                 alt="@course.Title"
                                                 class="w-16 h-16 rounded-lg object-cover border border-gray-200 dark:border-gray-600 flex-shrink-0 group-hover:opacity-80 transition">
                                            <div class="absolute inset-0 bg-black/30 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                                                <i class="fas fa-eye text-white text-lg"></i>
                                            </div>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h4 class="text-sm font-semibold text-gray-800 dark:text-white mb-1 truncate">@course.Title</h4>
                                            <div class="flex items-center text-xs text-gray-500 dark:text-gray-400 mb-1 gap-1.5">
                                                <span class="truncate">@course.InstructorName</span>
                                                <i class="fas fa-circle text-[4px] opacity-60"></i>
                                                <span>@(course.Duration / 3600) @Localizer["HourUnit"]</span>
                                            </div>
                                            @{
                                                string discountClass = "";
                                                if (course.Discount <= 20)
                                                {
                                                    discountClass = "bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200";
                                                }
                                                else if (course.Discount <= 50)
                                                {
                                                    discountClass = "bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200";
                                                }
                                                else
                                                {
                                                    discountClass = "bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200";
                                                }
                                            }
                                            <div class="flex items-center gap-2 flex-wrap mt-1">
                                                @{
                                                    var similarFinalPrice = course.Price - (course.Price * (course.Discount ?? 0) / 100);
                                                }
                                                @if (similarFinalPrice <= 0)
                                                {
                                                    <span class="text-sm font-bold text-green-600 dark:text-green-400 inline-flex items-center gap-1">
                                                        <i class="fas fa-gift text-xs"></i> @Localizer["Free"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-sm font-bold text-blue-600 dark:text-blue-400">
                                                        @similarFinalPrice.ToString("0") @Localizer["CurrencyEGP"]
                                                    </span>
                                                }

                                                @if (course.Discount > 0 && similarFinalPrice > 0)
                                                {
                                                    <span class="text-xs text-gray-500 dark:text-gray-400 line-through">
                                                        @course.Price.ToString("0") @Localizer["CurrencyEGP"]
                                                    </span>
                                                    <span class="text-xs px-2 py-0.5 rounded-full font-medium @discountClass">
                                                        @Localizer["DiscountPercent"] @course.Discount%
                                                    </span>
                                                }
                                            </div>

                                        </div>
                                    </div>
                                </a>
                            }
                        </div>

                        <div class="px-5 py-3 bg-gray-50 dark:bg-gray-700 text-center border-t border-gray-200 dark:border-gray-600">
                            <a asp-action="Index" asp-controller="Course" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center justify-center gap-2 transition-transform rtl:hover:-translate-x-1 ltr:hover:translate-x-1">
                                <span>@Localizer["ViewAllCourses"]</span>
                                <i class="fas fa-arrow-@(isArabic ? "left" : "right") text-xs"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

