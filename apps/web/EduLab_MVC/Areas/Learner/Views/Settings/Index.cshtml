<!-- ========== JavaScript ========== -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
<script>
    function changeLanguage(culture) {
        const returnUrl = window.location.pathname + window.location.search;
        window.location.href = '@Url.Action("SetLanguage", "Home", new { area = "Learner" })?culture=' + culture + '&returnUrl=' + encodeURIComponent(returnUrl);
    }

$(document).ready(function() {
    // TempData Notifications
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        setTimeout(() => showToast('@Html.Raw(TempData["SuccessMessage"])', 'success'), 100);
        </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        setTimeout(() => showToast('@Html.Raw(TempData["ErrorMessage"])', 'error'), 100);
        </text>
    }

    // Tab Switching (My Learning Style)
    const defaultTab = '@Html.Raw(ViewBag.ActiveTab ?? "profile")';
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab') || defaultTab;

    const mlTabContainer = document.getElementById('mlTabs');
    const mlTabs = document.querySelectorAll('#mlTabs .ml-tab');
    const mlPanels = document.querySelectorAll('.ml-panel');
    const mlIndicator = document.getElementById('tabIndicator');
    let activeTab = 'profile';

    function updateIndicator(el) {
        if (!mlTabContainer || !mlIndicator) return;
        const containerRect = mlTabContainer.getBoundingClientRect();
        const elRect = el.getBoundingClientRect();
        if (document.documentElement.dir === 'rtl') {
            mlIndicator.style.right = (containerRect.right - elRect.right) + 'px';
            mlIndicator.style.left = 'auto';
        } else {
            mlIndicator.style.left = (elRect.left - containerRect.left) + 'px';
            mlIndicator.style.right = 'auto';
        }
        mlIndicator.style.width = elRect.width + 'px';
    }

    function activateTab(tabId, animate) {
        const tab = document.querySelector(`#mlTabs .ml-tab[data-tab="${tabId}"]`);
        const panel = document.getElementById('panel-' + tabId);
        if (!tab || !panel) return;

        if (tabId === activeTab) {
            updateIndicator(tab);
            return;
        }

        updateIndicator(tab);
        mlTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const current = document.getElementById('panel-' + activeTab);
        if (animate && current) {
            current.classList.add('animating', 'ml-panel-out');
            current.addEventListener('animationend', function handler() {
                current.classList.remove('active', 'animating', 'ml-panel-out');
                current.removeEventListener('animationend', handler);

                panel.classList.add('active', 'animating', 'ml-panel-in');
                panel.addEventListener('animationend', function h2() {
                    panel.classList.remove('animating', 'ml-panel-in');
                    panel.removeEventListener('animationend', h2);
                });
                activeTab = tabId;
            });
        } else {
            mlPanels.forEach(p => p.classList.remove('active'));
            panel.classList.add('active');
            activeTab = tabId;
        }
    }

    if (initialTab) {
        activateTab(initialTab, false);
    }

    window.addEventListener('resize', () => {
        const curr = document.querySelector('#mlTabs .ml-tab.active');
        if (curr) updateIndicator(curr);
    });

    $('.ml-tab').click(function() {
        const tabId = $(this).data('tab');
        
        const url = new URL(window.location);
        url.searchParams.set('tab', tabId);
        window.history.pushState({}, '', url);

        activateTab(tabId, true);
        
        if(window.innerWidth < 768) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
    // Password Toggle
    $('.pwd-toggle-btn').click(function() {
        const input = $(this).siblings('input');
        const icon = $(this).find('i');
        if(input.attr('type') === 'password') {
            input.attr('type', 'text');
            icon.removeClass('fa-eye-slash').addClass('fa-eye');
        } else {
            input.attr('type', 'password');
            icon.removeClass('fa-eye').addClass('fa-eye-slash');
        }
    });

    // Password Strength Meter
    $('#newPass').on('input', function() {
        const val = $(this).val();
        let strength = 0;
        if(val.length >= 8) strength += 25;
        if(/[A-Z]/.test(val)) strength += 25;
        if(/[0-9]/.test(val)) strength += 25;
        if(/[^A-Za-z0-9]/.test(val)) strength += 25;
        
        const bar = $('.strength-bar');
        bar.removeClass('weak fair good strong');
        
        if(strength < 50) { bar.addClass('weak'); $('#strengthText').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["WeakPassword"].Value))').css('color','#ef4444'); }
        else if(strength < 75) { bar.addClass('fair'); $('#strengthText').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["FairPassword"].Value))').css('color','#f59e0b'); }
        else if(strength < 100) { bar.addClass('good'); $('#strengthText').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["GoodPassword"].Value))').css('color','#84cc16'); }
        else { bar.addClass('strong'); $('#strengthText').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["StrongPassword"].Value))').css('color','#10b981'); }
    });

    // Password Match Check
    $('#confirmPass').on('input', function() {
        const match = $(this).val() === $('#newPass').val();
        if($(this).val().length === 0) { $('#matchMsg').text(''); }
        else if(match) { $('#matchMsg').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["PasswordsMatch"].Value))').css('color','#10b981'); }
        else { $('#matchMsg').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["PasswordsDontMatch"].Value))').css('color','#ef4444'); }
    });

 // Two Factor Auth Logic
let twoFactorEnabled = @Json.Serialize(isTwoFactorEnabled);
const $toggle = $('#twoFactorToggle');
const $enabled = $('#twoFactorEnabledMsg');
const $disabled = $('#twoFactorDisabledMsg');

// Modal Elements
const $modal = $('#twoFactorModal');
const $modalQr = $('#modalQrCodeImg');
const $modalSecret = $('#modalSecretKey');
const $modalCode = $('#modalVerificationCode');
const $modalRecovery = $('#modalRecoveryArea');
const $otpInputs = $('.otp-input');
const $otpError = $('#otpErrorMsg');

function clearOTP() {
    $otpInputs.val('').removeClass('error animate-shake');
    $otpError.addClass('hidden').text('');
}

$otpInputs.on('input', function(e) {
    this.value = this.value.replace(/[^0-9]/g, '');
    if(this.value !== '') {
        $otpInputs.removeClass('error');
        $otpError.addClass('hidden');
        const next = $(this).next('.otp-input');
        if(next.length) next.focus();
    }
});

$otpInputs.on('keydown', function(e) {
    if(e.key === 'Backspace' && this.value === '') {
        const prev = $(this).prev('.otp-input');
        if(prev.length) {
            prev.focus();
            prev.val('');
        }
    } else if (e.key === 'Enter') {
        $modalEnable.click();
    }
});

$otpInputs.on('paste', function(e) {
    e.preventDefault();
    const pastedData = (e.originalEvent.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
    if(!pastedData) return;
    $otpInputs.val('');
    for(let i = 0; i < pastedData.length; i++) {
        $otpInputs.eq(i).val(pastedData[i]);
    }
    if(pastedData.length === 6) {
        $otpInputs.last().focus();
        $modalEnable.click();
    } else {
        $otpInputs.eq(pastedData.length).focus();
    }
});
const $modalEnable = $('#modalEnableBtn');
const $modalCancel = $('#modalCancelBtn');
const $modalClose = $('#modalCloseBtn');

// Update UI based on 2FA status
function update2FAUI() {
    if(twoFactorEnabled) {
        $enabled.removeClass('hidden');
        $disabled.addClass('hidden');
    } else {
        $enabled.addClass('hidden');
        $disabled.removeClass('hidden');
    }
}

// Open Modal with 2FA Setup Data
function open2FAModal() {
    $modalEnable.prop('disabled', true).addClass('btn-loading');
    clearOTP();
    $modalRecovery.html('');
    setTimeout(() => $otpInputs.first().focus(), 100);
    
    $.get('@Url.Action("GetTwoFactorSetup", "Settings", new { area = "Learner" })', function(res) {
        if(res.qrCodeUrl) $modalQr.attr('src', res.qrCodeUrl);
        if(res.secret) $modalSecret.text(res.secret);
        if(res.recoveryCodes) {
            $modalRecovery.html(`
                <div class="modal-recovery">
                    <strong>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["RecoveryCodesLabel"].Value))</strong>
                    <div class="modal-recovery-codes">
                        ${res.recoveryCodes.map(c => `<span>${c}</span>`).join('')}
                    </div>
                </div>
            `);
        }
        $modalEnable.prop('disabled', false).removeClass('btn-loading');
        $modal.addClass('active');
    }).fail(() => { 
        showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["SettingsLoadError"].Value))', 'error'); 
        $toggle.prop('checked', false); 
        update2FAUI();
    });
}

// Close Modal
function close2FAModal(resetToggle = false) {
    $modal.removeClass('active');
    if(resetToggle) {
        $toggle.prop('checked', false);
        update2FAUI();
    }
}

// Copy Secret Key
window.copySecretKey = function() {
    const secret = $modalSecret.text();
    navigator.clipboard?.writeText(secret).then(() => {
        $modalSecret.addClass('copied').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CopiedSecret"].Value))');
        $('#copyHint').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["CopiedLabel"].Value))').css('color', '#10b981');
        setTimeout(() => {
            $modalSecret.removeClass('copied').text(secret);
            $('#copyHint').text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ClickToCopy"].Value)) 📋').css('color', '');
        }, 2000);
    });
}

// Custom Confirm Modal Logic
window.showConfirmModal = function(title, message, isDanger, callback) {
    const $modal = $('#confirmModal');
    $('#confirmModalTitle').text(title);
    $('#confirmModalMessage').text(message);
    
    if (isDanger) {
        $('#confirmModalIcon').html('<i class="fas fa-exclamation-triangle"></i>').removeClass('bg-blue-100 text-blue-500').addClass('bg-red-100 dark:bg-red-900/30 text-red-500');
        $('#confirmModalConfirm').removeClass('bg-blue-600 hover:bg-blue-700 shadow-blue-500/30').addClass('bg-red-500 hover:bg-red-600 shadow-red-500/30');
    } else {
        $('#confirmModalIcon').html('<i class="fas fa-question-circle"></i>').removeClass('bg-red-100 text-red-500').addClass('bg-blue-100 dark:bg-blue-900/30 text-blue-500');
        $('#confirmModalConfirm').removeClass('bg-red-500 hover:bg-red-600 shadow-red-500/30').addClass('bg-blue-600 hover:bg-blue-700 shadow-blue-500/30');
    }

    $modal.addClass('active');

    $('#confirmModalConfirm').off('click').on('click', function() {
        $modal.removeClass('active');
        if(callback) callback();
    });

    $('#confirmModalCancel').off('click').on('click', function() {
        $modal.removeClass('active');
    });
};

// Toggle Change Handler
$toggle.on('click', function(e) {
    e.preventDefault();
    if (this.checked && !twoFactorEnabled) {
        // Open modal for setup
        open2FAModal();
    } else if (!this.checked && twoFactorEnabled) {
        // Confirm disable
        showConfirmModal('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Disable2FAConfirm"].Value))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Disable2FAConfirmMsg"].Value))', true, function() {
            const token = $('input[name="__RequestVerificationToken"]').first().val();
            const form = $('<form method="post" action="@Url.Action("DisableTwoFactor", "Settings", new { area = "Learner" })"></form>');
            form.append($('<input type="hidden" name="__RequestVerificationToken" />').val(token));
            $('body').append(form);
            form.submit();
        });
    }
});

// Modal Event Handlers
$modalCancel.add($modalClose).click(() => close2FAModal(true));
$modal.click(function(e) {
    if(e.target === this) close2FAModal(true);
});

// Enable 2FA from Modal
$modalEnable.click(function() {
    let code = '';
    $otpInputs.each(function() { code += $(this).val(); });
    
    if(code.length !== 6) { 
        $otpInputs.addClass('error animate-shake');
        $otpError.text('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["OTPRequired"].Value))').removeClass('hidden');
        setTimeout(() => $otpInputs.removeClass('animate-shake'), 400);
        return; 
    }
    
    $otpInputs.removeClass('error');
    $otpError.addClass('hidden');
    $modalCode.val(code);

    $(this).addClass('btn-loading').prop('disabled', true);
    
    const token = $('input[name="__RequestVerificationToken"]').first().val();
    const form = $('<form method="post" action="@Url.Action("EnableTwoFactor", "Settings", new { area = "Learner" })"></form>');
