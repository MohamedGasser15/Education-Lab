    // Theme Switcher
    window.setTheme = function(mode) {
        if(mode === 'dark') {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        } else if(mode === 'light') {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            localStorage.removeItem('theme');
            if(window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }
        showToast(`@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["ThemeAppliedPrefix"].Value)) ${mode === 'light' ? '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["LightMode"].Value))' : mode === 'dark' ? '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["DarkMode"].Value))' : '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["AutoMode"].Value))'}`, 'success');
    };

    // Load saved theme
    (function initTheme() {
        const saved = localStorage.getItem('theme');
        if(saved === 'dark') setTheme('dark');
        else if(saved === 'light') setTheme('light');
    })();

    // Toast Notification System
    window.showToast = function(message, type = 'success') {
        const colors = {
            success: { bg: '#10b981', icon: 'fa-check-circle' },
            error: { bg: '#ef4444', icon: 'fa-exclamation-circle' },
            warning: { bg: '#f59e0b', icon: 'fa-exclamation-triangle' }
        };
        const cfg = colors[type] || colors.success;
        
        const toast = $(`
            <div class="fixed top-5 left-1/2 -translate-x-1/2 text-white px-5 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-3 animate-fade-in" 
                 style="background: ${cfg.bg}">
                <i class="fas ${cfg.icon}"></i>
                <span>${message}</span>
                <button onclick="$(this).closest('div').fadeOut(200, function(){$(this).remove();})" class="ml-2 hover:opacity-80">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `);
        $('body').append(toast);
        setTimeout(() => toast.fadeOut(300, function(){ $(this).remove(); }), 3500);
    };

