@model IEnumerable<EduLab_MVC.Models.DTOs.Payment.PaymentDto>
@{
    ViewData["Title"] = Localizer["TransactionsTitle"].Value;
}

<!-- ========== BACKGROUND STYLES - مطابق للـ Settings Page ========== -->
<style>
    /* === Page Wrapper with Animated Background === */
    .transactions-page-wrapper {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        background: 
            radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 80% 70%, rgba(6, 182, 212, 0.06) 0%, transparent 50%),
            linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
        transition: background 0.5s ease;
    }
    
    .dark .transactions-page-wrapper {
        background: 
            radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.15) 0%, transparent 50%),
            radial-gradient(circle at 80% 70%, rgba(6, 182, 212, 0.10) 0%, transparent 50%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
    }

    /* === Animated Dots Pattern === */
    .transactions-page-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: 
            radial-gradient(rgba(59, 130, 246, 0.12) 1.5px, transparent 1.5px),
            radial-gradient(rgba(6, 182, 212, 0.08) 1.5px, transparent 1.5px);
        background-size: 40px 40px;
        background-position: 0 0, 20px 20px;
        animation: moveDots 25s linear infinite;
        pointer-events: none;
        z-index: 0;
        opacity: 0.7;
    }
    
    .dark .transactions-page-wrapper::before {
        background-image: 
            radial-gradient(rgba(255, 255, 255, 0.06) 1.5px, transparent 1.5px),
            radial-gradient(rgba(99, 102, 241, 0.04) 1.5px, transparent 1.5px);
        opacity: 0.35;
    }
    
    @@keyframes moveDots {
        0% { background-position: 0 0, 20px 20px; }
        100% { background-position: 40px 40px, 60px 60px; }
    }

    /* === Floating Gradient Orbs === */
    .orb-glow {
        position: absolute;
        width: 700px;
        height: 700px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(60px);
        opacity: 0.5;
        animation: floatGlow 20s ease-in-out infinite;
    }
    
    .orb-glow.primary {
        top: -250px;
        left: -150px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.4) 0%, transparent 70%);
    }
    
    .orb-glow.secondary {
        bottom: -200px;
        right: -100px;
        background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, transparent 70%);
        animation-delay: -10s;
        animation-duration: 25s;
    }

    /* === Content Layer === */
    .transactions-content-layer {
        position: relative;
        z-index: 10;
    }

    /* === Glass Cards === */
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 1.5rem;
        box-shadow: 
            0 4px 6px -1px rgba(0, 0, 0, 0.05),
            0 2px 4px -2px rgba(0, 0, 0, 0.03);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .dark .glass-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .glass-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .stat-card {
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-icon {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
    }
</style>

<div class="transactions-page-wrapper pt-10 pb-20 px-4">
    <!-- Floating Orbs -->
    <div class="orb-glow primary"></div>
    <div class="orb-glow secondary"></div>

    <div class="transactions-content-layer max-w-6xl mx-auto">
        <!-- Page Header -->
        <div class="text-center mb-12">
            <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-full border border-white/40 dark:border-white/10 text-sm font-medium text-gray-700 dark:text-gray-300 mb-4 shadow-sm">
                <i class="fas fa-history text-blue-500"></i>
                @Localizer["TransactionsDashboard"]
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white">
                @Localizer["TransactionsLogPrefix"] <span class="text-transparent bg-clip-text bg-gradient-to-l from-blue-600 to-cyan-500">@Localizer["TransactionsLogHighlight"]</span>
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-3 text-lg">@Localizer["TransactionsSubtitle"]</p>
        </div>

        <!-- Stats Bar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="glass-card stat-card">
                <div class="stat-icon bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400">
                    <i class="fas fa-check-circle"></i>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400">@Localizer["CompletedTransactions"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.Count(p => p.Status == "completed" || p.Status == "Succeeded" || p.Status == "Paid")</p>
            </div>
            
            <div class="glass-card stat-card">
                <div class="stat-icon bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400">
                    <i class="fas fa-undo"></i>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400">@Localizer["RefundedTransactions"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.Count(p => p.Status == "Refunded" || p.Status == "refunded")</p>
            </div>

            <div class="glass-card stat-card">
                <div class="stat-icon bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400">@Localizer["TotalSpent"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.Where(p => p.Status != "Refunded" && p.Status != "refunded").Sum(p => p.Amount).ToString("N0") @Localizer["EGP"]</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="glass-card p-16 text-center border-dashed border-2">
                <div class="w-24 h-24 bg-slate-100 dark:bg-slate-800/50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-receipt text-4xl text-slate-400"></i>
                </div>
                <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">@Localizer["NoTransactions"]</h3>
                <p class="text-slate-500 dark:text-slate-400 mb-8 max-w-sm mx-auto">@Localizer["NoTransactionsDesc"]</p>
                <a href="@Url.Action("Index", "Course", new { area = "Learner" })" class="inline-flex items-center gap-3 px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl transition-all hover:scale-105 shadow-xl shadow-blue-500/25">
                    @Localizer["BrowseCourses"]
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
        }
        else
        {
            <div class="glass-card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-white/40 dark:bg-slate-900/40 border-b border-white/20 dark:border-white/10">
                                <th class="px-6 py-5 text-sm font-bold text-slate-600 dark:text-slate-300">@Localizer["CourseHeader"]</th>
                                <th class="px-6 py-5 text-sm font-bold text-slate-600 dark:text-slate-300">@Localizer["DateHeader"]</th>
                                <th class="px-6 py-5 text-sm font-bold text-slate-600 dark:text-slate-300">@Localizer["AmountHeader"]</th>
                                <th class="px-6 py-5 text-sm font-bold text-slate-600 dark:text-slate-300">@Localizer["StatusHeader"]</th>
                                <th class="px-6 py-5 text-sm font-bold text-slate-600 dark:text-slate-300">@Localizer["ActionHeader"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                            @foreach (var payment in Model)
                            {
                                <tr class="hover:bg-white/30 dark:hover:bg-slate-800/20 transition-colors">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-4">
                                            <div class="w-14 h-14 rounded-xl overflow-hidden flex-shrink-0 border-2 border-white dark:border-slate-700 shadow-sm">
                                                <img src="@(string.IsNullOrEmpty(payment.CourseThumbnail) ? "/images/default-course.jpg" : payment.CourseThumbnail)" 
                                                     alt="@payment.CourseTitle" class="w-full h-full object-cover" />
                                            </div>
                                            <div>
                                                <p class="font-bold text-slate-800 dark:text-white line-clamp-1">@payment.CourseTitle</p>
                                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">#ID: @payment.Id</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="text-sm font-semibold text-slate-700 dark:text-slate-300">@payment.PaidAt.ToString("dd MMM yyyy")</div>
                                        <div class="text-xs text-slate-400 mt-1">@payment.PaidAt.ToString("HH:mm")</div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span class="text-lg font-black text-slate-900 dark:text-white" dir="ltr">@payment.Amount.ToString("N0") @Localizer["EGP"]</span>
                                    </td>
                                    <td class="px-6 py-5">
                                        @switch (payment.Status)
                                        {
                                            case "completed":
                                            case "Succeeded":
                                            case "Paid":
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-bold">
                                                    @Localizer["CompletedStatus"]
                                                </span>
                                                break;
                                            case "refunded":
                                            case "Refunded":
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 text-xs font-bold">
                                                    @Localizer["RefundedStatus"]
                                                </span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold">
                                                    @payment.Status
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="px-6 py-5 text-left">
                                        @if (payment.IsRefundable)
                                        {
                                            <a asp-action="Refund" asp-route-id="@payment.Id"
                                               class="inline-flex items-center gap-2 px-4 py-2.5 bg-orange-50 dark:bg-orange-900/20 text-orange-600 dark:text-orange-400 border border-orange-200 dark:border-orange-700/40 hover:bg-orange-500 hover:text-white hover:border-orange-500 rounded-xl font-bold text-xs transition-all duration-300 shadow-sm hover:shadow-lg hover:-translate-y-0.5">
                                                <i class="fas fa-undo-alt text-sm"></i>
                                                @Localizer["RequestRefund"]
                                            </a>
                                        }
                                        else if (payment.Status == "Refunded" || payment.Status == "refunded")
                                        {
                                            <span class="text-slate-400 dark:text-slate-500 text-xs italic">@Localizer["ProcessedLabel"]</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 dark:text-slate-500 text-xs flex items-center gap-1 opacity-60" title='@Localizer["RefundNotAvailableTooltip"]'>
                                                <i class="fas fa-info-circle"></i>
                                                @Localizer["NotAvailable"]
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

