@model EduLab_MVC.Models.DTOs.Payment.PaymentDto
@{
    ViewData["Title"] = Localizer["RefundRequestTitle"].Value;
    var isRefundable = Model.IsRefundable && Model.Amount > 0 && (Model.Status == "completed" || Model.Status == "Succeeded" || Model.Status == "Paid");
}

<div class="max-w-6xl mx-auto py-8 font-sans px-4" style="min-height: 95vh;">
    <!-- Breadcrumb -->
    <nav class="flex items-center mb-8 text-sm" aria-label="breadcrumb">
        <a href="/" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center transition-colors duration-300">
            <i class="fas fa-home me-2 text-sm"></i> @Localizer["Home"]
        </a>
        <i class="fas fa-chevron-right mx-2 text-gray-400 text-xs rtl:rotate-180 inline-block"></i>
        <a asp-action="Transactions" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center transition-colors duration-300">
            @Localizer["TransactionsTitle"]
        </a>
        <i class="fas fa-chevron-right mx-2 text-gray-400 text-xs rtl:rotate-180 inline-block"></i>
        <span class="text-gray-600 dark:text-gray-300 font-medium">@Localizer["RefundRequestTitle"]</span>
    </nav>

    <div class="mb-8">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-orange-100 dark:bg-orange-900/40 flex items-center justify-center text-orange-600 dark:text-orange-400 shrink-0">
                <i class="fas fa-undo-alt text-2xl"></i>
            </div>
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-white flex items-center">
                    @Localizer["RefundRequestTitle"]
                </h1>
                <p class="text-gray-500 dark:text-gray-400 mt-1">@Localizer["RefundRequestDesc"]</p>
            </div>
        </div>
    </div>

    @if (Model.RefundStatus == "pending")
    {
        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700/40 rounded-2xl p-6 mb-8 flex items-start gap-4">
            <i class="fas fa-clock text-blue-500 text-xl mt-1"></i>
            <div>
                <h3 class="font-bold text-blue-800 dark:text-blue-200 mb-1">@Localizer["UnderReview"]</h3>
                <p class="text-blue-700/80 dark:text-blue-300/80 text-sm leading-relaxed">@Localizer["RefundPolicy"]</p>
            </div>
        </div>
        <div class="text-center">
            <a asp-action="Transactions" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-500/25 active:scale-95">
                <i class="fas fa-arrow-left"></i>
                @Localizer["TransactionsTitle"]
            </a>
        </div>
    }
    else if (!isRefundable)
    {
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/40 rounded-2xl p-6 mb-8 flex items-start gap-4">
            <i class="fas fa-exclamation-triangle text-amber-500 text-xl mt-1"></i>
            <div>
                <h3 class="font-bold text-amber-800 dark:text-amber-200 mb-1">@(Model.Amount <= 0 ? Localizer["RefundNotAvailableFree"].Value : Localizer["RefundNotAvailableTooltip"].Value)</h3>
                @if (Model.Amount > 0)
                {
                    <p class="text-amber-700/80 dark:text-amber-300/80 text-sm leading-relaxed">@Localizer["RefundPolicy"]</p>
                }
            </div>
        </div>
        <div class="text-center">
            <a asp-action="Transactions" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-500/25 active:scale-95">
                <i class="fas fa-arrow-left"></i>
                @Localizer["TransactionsTitle"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
            <!-- Refund Form Section -->
            <div class="lg:col-span-2">
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 transition-all duration-300 hover:shadow-xl">
                    <!-- Header -->
                    <div class="bg-gradient-to-r from-orange-50 to-amber-50 dark:from-gray-700 dark:to-gray-800 px-6 py-5 border-b border-gray-100 dark:border-gray-700">
                        <h2 class="text-lg font-semibold text-gray-800 dark:text-white flex items-center">
                            <i class="fas fa-file-invoice me-2 text-orange-500"></i>
                            @Localizer["RefundRequestDesc"]
                        </h2>
                    </div>

                    <div class="p-6 space-y-6">
                        <!-- Policy Notice -->
                        <div class="bg-blue-600/5 dark:bg-blue-400/5 border-r-4 border-blue-500 rounded-xl p-5">
                            <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
                                <i class="fas fa-info-circle me-2 text-blue-500"></i>
                                @Localizer["RefundPolicy"]
                            </p>
                            <ul class="mt-3 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                                <li class="flex items-center gap-2">
                                    <i class="fas fa-clock text-blue-400"></i> @Localizer["RefundWithin7Days"]
                                </li>
                                <li class="flex items-center gap-2">
                                    <i class="fas fa-chart-line text-blue-400"></i> @Localizer["RefundMax25Percent"]
                                </li>
                                <li class="flex items-center gap-2">
                                    <i class="fas fa-file-contract text-blue-400"></i> @Localizer["PaymentsSubjectToRefund"]
                                </li>
                            </ul>
                        </div>

                        <!-- Selected Course -->
                        <div class="p-5 bg-gray-50 dark:bg-gray-700/50 rounded-2xl border border-gray-100 dark:border-gray-700">
                            <p class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest mb-3">@Localizer["SelectedCourse"]</p>
                            <div class="flex items-center gap-4">
                                <div class="w-20 h-20 rounded-xl overflow-hidden flex-shrink-0 border-2 border-white dark:border-slate-600 shadow-md">
                                    <img src="@(string.IsNullOrEmpty(Model.CourseThumbnail) ? "/images/default-course.jpg" : Model.CourseThumbnail)"
                                         alt="@Model.CourseTitle" class="w-full h-full object-cover" />
                                </div>
                                <div class="min-w-0">
                                    <p class="font-bold text-gray-800 dark:text-white line-clamp-2">@Model.CourseTitle</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 font-mono">#ID: @Model.Id</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@Model.PaidAt.ToString("dd MMM yyyy") - @Model.PaidAt.ToString("HH:mm")</p>
                                </div>
                            </div>
                        </div>

                        <!-- Amount -->
                        <div class="flex items-center justify-between p-5 bg-gray-50 dark:bg-gray-700/50 rounded-2xl border border-gray-100 dark:border-gray-700">
                            <span class="text-sm font-bold text-gray-600 dark:text-gray-300">@Localizer["RefundAmount"]</span>
                            <span class="text-3xl font-black text-gray-900 dark:text-white" dir="ltr">@Model.Amount.ToString("N0") @Localizer["EGP"]</span>
                        </div>

                        <!-- Reason -->
                        <div class="space-y-3">
                            <label class="text-sm font-bold text-gray-700 dark:text-gray-300 mr-1 flex items-center gap-2">
                                <i class="fas fa-comment-dots text-orange-500"></i>
                                @Localizer["RefundReason"]
                            </label>
                            <textarea id="refundReason" rows="4" class="w-full px-5 py-4 bg-white dark:bg-gray-700 border border-gray-200 dark:border-slate-600 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none transition-all dark:text-white placeholder-gray-400"
                                      placeholder="@Localizer["RefundReasonPlaceholder"]"></textarea>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="px-6 py-6 bg-gray-50/80 dark:bg-gray-900/50 border-t border-gray-100 dark:border-gray-700 flex flex-col-reverse sm:flex-row gap-3">
                        <a asp-action="Transactions" class="flex-1 px-6 py-4 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 font-bold border border-gray-200 dark:border-gray-700 rounded-2xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-all text-center active:scale-95">
                            @Localizer["CancelAction"]
                        </a>
                        <button id="confirmRefundBtn" onclick="submitRefund()" class="flex-1 px-6 py-3.5 bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white font-bold rounded-2xl transition-all shadow-lg shadow-orange-500/30 active:scale-95 inline-flex items-center justify-center gap-3 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:from-orange-500 disabled:hover:to-red-600">
                            <i id="refundIcon" class="fas fa-undo-alt text-sm"></i>
                            <span>@Localizer["ConfirmRefund"]</span>
                            <i id="refundSpinner" class="fas fa-spinner fa-spin hidden"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Sidebar Summary -->
            <div class="lg:col-span-1">
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 sticky top-24 border border-gray-100 dark:border-gray-700 transition-all duration-300 hover:shadow-xl">
                    <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-5 flex items-center">
                        <i class="fas fa-receipt me-2 text-orange-500"></i>
                        @Localizer["RefundRequestTitle"]
                    </h2>
                    <div class="space-y-4">
                        <div class="flex items-start gap-3 pb-4 border-b border-gray-100 dark:border-gray-700">
                            <img src="@(string.IsNullOrEmpty(Model.CourseThumbnail) ? "/images/default-course.jpg" : Model.CourseThumbnail)"
                                 alt="@Model.CourseTitle" class="w-12 h-12 rounded-lg object-cover flex-shrink-0 shadow-sm" />
                            <p class="text-sm font-medium text-gray-800 dark:text-white line-clamp-2">@Model.CourseTitle</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400 text-sm">@Localizer["RefundAmount"]</span>
                            <span class="font-bold text-gray-900 dark:text-white" dir="ltr">@Model.Amount.ToString("N0") @Localizer["EGP"]</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400 text-sm">@Localizer["DateHeader"]</span>
                            <span class="font-medium text-gray-800 dark:text-white text-sm">@Model.PaidAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="border-t border-gray-100 dark:border-gray-700 pt-4">
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-gray-800 dark:text-white">@Localizer["Total"]</span>
                                <span class="font-bold text-orange-500 dark:text-orange-400 text-lg" dir="ltr">@Model.Amount.ToString("N0") @Localizer["EGP"]</span>
                            </div>
                            <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">@Localizer["PaymentsSubjectToRefund"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            padding: 1.5rem;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal-card {
            width: 100%;
            max-width: 26rem;
            animation: modalSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes modalSlideUp {
            from { opacity: 0; transform: translateY(20px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        #confirmRefundBtn.loading .btn-text {
            opacity: 0;
        }

        #confirmRefundBtn .loading-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        #confirmRefundBtn.loading .loading-spinner {
            opacity: 1;
        }
    </style>

    <!-- Result Modal -->
    <div id="refundResultModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="resultTitle">
        <div class="modal-card">
            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-2xl border border-gray-100 dark:border-gray-700 overflow-hidden text-center">
                <div class="pt-10 pb-2 px-8">
                    <div id="resultIcon" class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center text-2xl mb-4"></div>
                    <h3 id="resultTitle" class="text-xl font-bold text-gray-800 dark:text-white"></h3>
                    <p id="resultMessage" class="text-sm text-gray-500 dark:text-gray-400 mt-2 leading-relaxed"></p>
                </div>
                <div class="p-8 pt-6">
                    <button id="resultOkBtn" class="w-full px-6 py-3.5 rounded-2xl font-bold transition-all active:scale-95 shadow-lg"></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const resultModal = document.getElementById('refundResultModal');
        const resultIcon = document.getElementById('resultIcon');
        const resultTitle = document.getElementById('resultTitle');
        const resultMessage = document.getElementById('resultMessage');
        const resultOkBtn = document.getElementById('resultOkBtn');
        let resultOnClose = null;

        function showResultModal(type, title, message, buttonText, onClose) {
            if (type === 'success') {
                resultIcon.className = 'w-16 h-16 mx-auto rounded-2xl flex items-center justify-center text-2xl mb-4 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400';
                resultIcon.innerHTML = '<i class="fas fa-check"></i>';
                resultOkBtn.className = 'w-full px-6 py-3.5 rounded-2xl font-bold transition-all active:scale-95 shadow-lg bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white shadow-emerald-500/30';
            } else {
                resultIcon.className = 'w-16 h-16 mx-auto rounded-2xl flex items-center justify-center text-2xl mb-4 bg-rose-100 dark:bg-rose-900/40 text-rose-500 dark:text-rose-400';
                resultIcon.innerHTML = '<i class="fas fa-times"></i>';
                resultOkBtn.className = 'w-full px-6 py-3.5 rounded-2xl font-bold transition-all active:scale-95 shadow-lg bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white shadow-orange-500/30';
            }

            resultTitle.textContent = title;
            resultMessage.textContent = message;
            resultOkBtn.textContent = buttonText;
            resultOnClose = onClose;

            resultModal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeResultModal() {
            resultModal.classList.remove('show');
            document.body.style.overflow = '';
            if (resultOnClose) {
                const cb = resultOnClose;
                resultOnClose = null;
                cb();
            }
        }

        resultOkBtn.addEventListener('click', closeResultModal);

        async function submitRefund() {
            const btn = document.getElementById('confirmRefundBtn');
            const icon = document.getElementById('refundIcon');
            const spinner = document.getElementById('refundSpinner');
            const reason = document.getElementById('refundReason').value;

            btn.disabled = true;
            icon.classList.add('hidden');
            spinner.classList.remove('hidden');

            const minDelay = new Promise(resolve => setTimeout(resolve, 2000));

            try {
                const responsePromise = fetch('@Url.Action("RequestRefund", "Payment")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        paymentId: @Model.Id,
                        reason: reason
                    })
                });

                const [response] = await Promise.all([responsePromise, minDelay]);
                const result = await response.json();

                if (result.success) {
                    showResultModal(
                        'success',
                        @Html.Raw(Json.Serialize(Localizer["SuccessTitle"].Value)),
                        @Html.Raw(Json.Serialize(Localizer["RefundSuccessMsg"].Value)),
                        @Html.Raw(Json.Serialize(Localizer["ExcellentButton"].Value)),
                        function () { window.location.href = '@Url.Action("Transactions")'; }
                    );
                } else {
                    showResultModal(
                        'error',
                        @Html.Raw(Json.Serialize(Localizer["SorryTitle"].Value)),
                        result.message || @Html.Raw(Json.Serialize(Localizer["RefundErrorMsg"].Value)),
                        @Html.Raw(Json.Serialize(Localizer["GotItButton"].Value))
                    );
                }
            } catch (error) {
                console.error('Error submitting refund:', error);
                showResultModal(
                    'error',
                    @Html.Raw(Json.Serialize(Localizer["TechErrorTitle"].Value)),
                    @Html.Raw(Json.Serialize(Localizer["TechErrorMsg"].Value)),
                    @Html.Raw(Json.Serialize(Localizer["OkayButton"].Value))
                );
            } finally {
                btn.disabled = false;
                icon.classList.remove('hidden');
                spinner.classList.add('hidden');
            }
        }
    </script>
}

@Html.AntiForgeryToken()
