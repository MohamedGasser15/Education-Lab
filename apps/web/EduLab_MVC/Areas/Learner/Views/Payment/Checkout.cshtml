                                {
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-0.5 inline-block">
                                        <i class="fas fa-tag me-1"></i>@Model.AppliedCouponCode (-@CurrencyService.FormatPrice(Model.DiscountAmount))
                                    </span>
                                }
