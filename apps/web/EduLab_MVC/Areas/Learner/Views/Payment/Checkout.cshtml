                            <div class="text-end">
                                @if (Model.TotalPrice <= 0)
                                {
                                    <span class="text-2xl font-black text-green-600 dark:text-green-400">@Localizer["Free"]</span>
                                }
                                else
                                {
                                    <span class="text-2xl font-black text-blue-600 dark:text-blue-400" dir="ltr">@CurrencyService.FormatPrice(Model.TotalPrice)</span>
                                    @if (CurrencyService.GetCurrentCurrencyCode() != "USD")
                                    {
                                        <span class="block text-xs text-gray-400 font-mono mt-0.5" dir="ltr">(≈ $@Model.TotalPrice.ToString("N2") USD)</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="border-t border-gray-200 dark:border-gray-700 pt-4 flex flex-col-reverse sm:flex-row justify-between gap-3">
