@model EduLab_MVC.Models.DTOs.Cart.CartDto
@{
    ViewData["Title"] = Localizer["CheckoutPageTitle"].Value;
    var userData = ViewBag.UserData as EduLab_MVC.Models.DTOs.Profile.ProfileDTO;
}

<div class="max-w-6xl mx-auto py-8 font-sans px-4" style="padding-bottom: 30rem !important;">
    <!-- Breadcrumb -->
    <nav class="flex items-center mb-8 text-sm" aria-label="breadcrumb">
        <a href="/" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center transition-colors duration-300">
            <i class="fas fa-home me-2 text-sm"></i> @Localizer["Home"]
        </a>
        <i class="fas fa-chevron-right mx-2 text-gray-400 text-xs rtl:rotate-180 inline-block"></i>
        <a asp-controller="Cart" asp-action="Index" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center transition-colors duration-300">
            @Localizer["CourseCart"]
        </a>
        <i class="fas fa-chevron-right mx-2 text-gray-400 text-xs rtl:rotate-180 inline-block"></i>
        <span class="text-gray-600 dark:text-gray-300 font-medium">@Localizer["CheckoutBreadcrumb"]</span>
    </nav>

    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-white mb-6 md:mb-8 flex items-center">
        <i class="fas fa-shopping-bag me-3 text-blue-600 dark:text-blue-400"></i>
        @Localizer["CheckoutTitle"]
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
        <!-- Main Form Section -->
        <div class="lg:col-span-2">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 transition-all duration-300 hover:shadow-xl">
                <!-- Stepper -->
                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800 px-4 md:px-6 py-4">
                    <div class="flex justify-between items-center mb-2 relative">
                        <!-- Step 1 -->
                        <div class="flex flex-col items-center z-10">
                            <span id="step1" class="bg-blue-600 text-white rounded-full w-10 h-10 flex items-center justify-center transition-all duration-500 shadow-lg transform scale-110">
                                <i class="fas fa-user text-sm"></i>
                            </span>
                            <span class="font-medium text-blue-600 dark:text-blue-400 mt-2 text-xs md:text-sm">@Localizer["YourData"]</span>
                        </div>

                        <!-- Step 2 -->
                        <div class="flex flex-col items-center z-10">
                            <span id="step2" class="bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full w-10 h-10 flex items-center justify-center transition-all duration-500 shadow-lg">
                                <i class="fas fa-credit-card text-sm"></i>
                            </span>
                            <span class="font-medium text-gray-500 dark:text-gray-400 mt-2 text-xs md:text-sm">@Localizer["Payment"]</span>
                        </div>

                        <!-- Step 3 -->
                        <div class="flex flex-col items-center z-10">
                            <span id="step3" class="bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full w-10 h-10 flex items-center justify-center transition-all duration-500 shadow-lg">
                                <i class="fas fa-check-circle text-sm"></i>
                            </span>
                            <span class="font-medium text-gray-500 dark:text-gray-400 mt-2 text-xs md:text-sm">@Localizer["Confirmation"]</span>
                        </div>

                        <!-- Progress Line -->
                        <div class="absolute top-5 left-0 right-0 h-1 bg-gray-200 dark:bg-gray-600 z-0 mx-12 rounded-full">
                            <div id="progressBar" class="absolute h-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-700 ease-in-out rounded-full" style="width: 33.33%"></div>
                        </div>
                    </div>
                </div>

                <!-- Section 1 - Customer Info -->
                <div id="customerInfoSection" class="p-4 md:p-6 transition-all duration-500">
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                        <i class="fas fa-user-circle me-1 text-blue-600 dark:text-blue-400"></i>
                        <span class="mb-2 ms-1">@Localizer["YourPersonalData"]</span>
                    </h2>
                    <form id="customerInfoForm" class="space-y-4 md:space-y-6">
                        <div>
                            <label for="fullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                                <i class="fas fa-signature me-1 text-blue-600 dark:text-blue-400 text-xs"></i>
                                <span class="ms-1">@Localizer["FullNameLabel"] *</span>
                            </label>
                            <div class="relative">
                                <input type="text" id="fullName" required value="@userData?.FullName"
                                       class="w-full ltr:pl-10 ltr:pr-4 rtl:pr-10 rtl:pl-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition duration-300 text-start"
                                       placeholder="@Localizer["FullNamePlaceholder"]">
                                <i class="fas fa-user absolute ltr:left-3 rtl:right-3 top-3.5 text-gray-400 text-sm"></i>
                            </div>
                            <p class="text-xs text-red-500 mt-1 hidden" id="fullNameError">
                                <i class="fas fa-exclamation-circle me-1"></i> @Localizer["FullNameError"]
                            </p>
                        </div>

                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                                <i class="fas fa-mobile-alt me-1 text-blue-600 dark:text-blue-400 text-xs"></i>
                                <span class="ms-1">@Localizer["MobileLabel"] *</span>
                            </label>
                            <div class="relative">
                                <input type="tel" id="phone" required value="@userData?.PhoneNumber"
                                       class="w-full ltr:pl-10 ltr:pr-4 rtl:pr-10 rtl:pl-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition duration-300"
                                       placeholder="@Localizer["MobilePlaceholder"]" pattern="\+?[0-9]{10,15}">
                                <i class="fas fa-phone absolute ltr:left-3 rtl:right-3 top-3.5 text-gray-400 text-sm"></i>
                            </div>
                            <p class="text-xs text-red-500 mt-1 hidden" id="phoneError">
                                <i class="fas fa-exclamation-circle me-1"></i> @Localizer["PhoneError"]
                            </p>
                        </div>

                        <div>
                            <label for="postalCode" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                                <i class="fas fa-mail-bulk me-1 text-blue-600 dark:text-blue-400 text-xs"></i>
                                <span class="ms-1">@Localizer["PostalCodeLabel"] *</span>
                            </label>
                            <div class="relative">
                                <input type="text" id="postalCode" required value="@userData?.PostalCode"
                                       class="w-full ltr:pl-10 ltr:pr-4 rtl:pr-10 rtl:pl-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition duration-300 text-start"
                                       placeholder="@Localizer["PostalCodePlaceholder"]" pattern="[0-9]{5}" maxlength="5">
                                <i class="fas fa-map-marker-alt absolute ltr:left-3 rtl:right-3 top-3.5 text-gray-400 text-sm"></i>
                            </div>
                            <p class="text-xs text-red-500 mt-1 hidden" id="postalCodeError">
                                <i class="fas fa-exclamation-circle me-1"></i> @Localizer["PostalCodeError"]
                            </p>
                        </div>
                        <div class="flex items-center gap-3 p-4 rounded-xl border transition-colors duration-200
                                    bg-blue-50 dark:bg-blue-900/20 border-blue-100 dark:border-blue-700/30 hover:bg-blue-100 dark:hover:bg-blue-900/30">
                            <!-- custom checkbox -->
                            <label for="saveInfo" class="relative flex items-center cursor-pointer select-none">
                                <input id="saveInfo" name="saveInfo" type="checkbox" checked
                                       class="sr-only" aria-checked="true" />

                                <!-- visual box -->
                                <span class="flex items-center justify-center w-6 h-6 rounded-md border transition-colors duration-200
                                             border-blue-300 dark:border-blue-600 bg-white dark:bg-gray-800
                                             focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                    <!-- check icon -->
                                    <svg class="w-4 h-4 text-white opacity-0 transform scale-75 transition-all duration-150"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6L9 17l-5-5"></path>
                                    </svg>
                                </span>
                            </label>

                            <!-- text -->
                            <div class="flex flex-col">
                                <label for="saveInfo" class="text-sm font-medium text-blue-800 dark:text-blue-200 cursor-pointer">
                                    @Localizer["SaveDataForNext"]
                                </label>
                                <p class="text-xs text-blue-700/80 dark:text-blue-100/70">@Localizer["SaveDataDesc"]</p>
                            </div>
                        </div>

                        <div class="pt-4 flex flex-col-reverse sm:flex-row justify-between gap-3">
                            <a asp-controller="Cart" asp-action="Index" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center justify-center transition duration-300 py-3 px-5 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700">
                                <i class="fas fa-arrow-left me-2 rtl:rotate-180"></i> @Localizer["BackToCart"]
                            </a>
                            <button type="button" id="nextToPaymentBtn" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl transition duration-300 font-medium flex items-center justify-center shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                                @Localizer["NextPayment"] <i class="fas fa-arrow-left ms-2 rtl:rotate-0 ltr:rotate-180"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Section 2 - Payment Method -->
                <div id="paymentMethodSection" class="p-4 md:p-6 hidden transition-all duration-500 opacity-0">
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                        <i class="fas fa-credit-card me-2 text-blue-600 dark:text-blue-400"></i>
                        <span>@Localizer["PaymentMethod"]</span>
                    </h2>
                    <div class="space-y-4">
                        <div id="freeOrderNote" class="hidden bg-green-50 dark:bg-green-900/30 border-2 border-green-500 dark:border-green-700 rounded-xl p-4 flex items-center">
                            <i class="fas fa-gift text-green-600 dark:text-green-400 text-2xl me-3"></i>
                            <div>
                                <h3 class="font-medium text-green-800 dark:text-green-200">@Localizer["FreeCheckoutTitle"]</h3>
                                <p class="text-sm text-green-600 dark:text-green-300">@Localizer["FreeCheckoutDesc"]</p>
                            </div>
                        </div>

                        <!-- Stripe Gateway Security Banner (Mobile Style) -->
                        <div id="stripeSecurityBanner" class="p-3.5 rounded-2xl bg-indigo-50/80 dark:bg-indigo-950/30 border border-indigo-200/60 dark:border-indigo-800/40 flex items-center justify-between shadow-sm">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-xl bg-indigo-600/10 dark:bg-indigo-400/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                    <i class="fas fa-lock text-sm"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-indigo-950 dark:text-indigo-200">@Localizer["SecurePaymentBanner"]</p>
                                    <p class="text-[11px] text-indigo-600/80 dark:text-indigo-400/80 font-medium">256-bit SSL • PCI-DSS Level 1 Compliant</p>
                                </div>
                            </div>
                            <div class="px-2.5 py-1 rounded-lg bg-[#635BFF] text-white font-black text-xs tracking-tight shadow-sm">
                                stripe
                            </div>
                        </div>

                        <!-- 3D Interactive Flippable Credit Card (Mobile Experience) -->
                        <div id="cardPreviewContainer" class="py-2 flex flex-col items-center">
                            <div id="creditCard3D" class="credit-card-scene w-full max-w-[420px] h-[215px] cursor-pointer select-none" onclick="toggleCardFlip()" title="@Localizer["FlipCardHint"]">
                                <div id="creditCardInner" class="credit-card-inner relative w-full h-full">
                                    <!-- Front Face -->
                                    <div id="cardFront" class="credit-card-face credit-card-front absolute inset-0 rounded-[1.4rem] p-5 sm:p-6 text-white flex flex-col justify-between overflow-hidden shadow-2xl transition-all duration-500 card-theme-visa">
                                        <!-- Ambient Orbs & Shimmer -->
                                        <div class="card-orb card-orb-1"></div>
                                        <div class="card-orb card-orb-2"></div>
                                        <div class="card-shimmer"></div>

                                        <!-- Top Row: EMV Gold Chip + Wi-Fi + Dynamic Brand Logo -->
                                        <div class="flex items-center justify-between relative z-10">
                                            <div class="flex items-center gap-3">
                                                <div class="emv-chip">
                                                    <div class="emv-chip-line"></div>
                                                </div>
                                                <i class="fas fa-wifi text-white/70 text-base rotate-90"></i>
                                            </div>
                                            <!-- Dynamic Brand Logo -->
                                            <div id="cardBrandLogo" class="card-brand-logo flex items-center justify-end">
                                                <span class="visa-logo">VISA</span>
                                            </div>
                                        </div>

                                        <!-- Middle Row: 16-digit Card Number -->
                                        <div class="relative z-10 py-1">
                                            <div id="cardDisplayNumber" dir="ltr" class="font-mono text-lg sm:text-2xl font-bold tracking-[0.18em] sm:tracking-[0.22em] text-white drop-shadow-md">
                                                •••• •••• •••• ••••
                                            </div>
                                        </div>

                                        <!-- Bottom Row: Cardholder Name & Expiry Date -->
                                        <div class="flex items-end justify-between relative z-10">
                                            <div class="flex-1 min-w-0 me-4">
                                                <div class="text-[9px] uppercase tracking-widest text-white/60 font-semibold mb-0.5">CARD HOLDER</div>
                                                <div id="cardDisplayName" class="text-xs sm:text-sm font-bold tracking-wider uppercase truncate text-white drop-shadow">
                                                    CARDHOLDER NAME
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <div class="text-[9px] uppercase tracking-widest text-white/60 font-semibold mb-0.5">VALID THRU</div>
                                                <div id="cardDisplayExpiry" dir="ltr" class="text-xs sm:text-sm font-mono font-bold tracking-widest text-white drop-shadow">
                                                    MM / YY
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Back Face -->
                                    <div id="cardBack" class="credit-card-face credit-card-back absolute inset-0 rounded-[1.4rem] text-white flex flex-col justify-between overflow-hidden shadow-2xl transition-all duration-500 card-theme-visa">
                                        <!-- Ambient Shimmer -->
                                        <div class="card-shimmer"></div>

                                        <!-- Magnetic Stripe -->
                                        <div class="w-full h-11 bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 mt-5 shadow-inner"></div>

                                        <!-- Signature Strip & CVC Box -->
                                        <div class="px-5 sm:px-6 relative z-10">
                                            <div class="flex items-center">
                                                <div class="flex-1 h-9 bg-slate-200 dark:bg-slate-300 rounded-l flex items-center px-3 text-slate-700 font-serif italic text-xs tracking-wider border-r border-slate-300 select-none">
                                                    Authorized Signature
                                                </div>
                                                <div id="cardDisplayCvc" dir="ltr" class="w-16 h-9 bg-white text-slate-900 rounded-r flex items-center justify-center font-mono font-black text-sm tracking-widest italic shadow-sm">
                                                    •••
                                                </div>
                                            </div>
                                            <div class="text-[8px] text-white/60 font-mono tracking-widest text-end mt-1 uppercase">SECURITY CODE (CVV)</div>
                                        </div>

                                        <!-- Hologram & Issuer info -->
                                        <div class="px-5 sm:px-6 pb-4 flex items-center justify-between relative z-10">
                                            <div class="flex items-center gap-2">
                                                <div class="w-7 h-5 rounded bg-gradient-to-br from-slate-400 via-slate-200 to-slate-400 border border-white/40 flex items-center justify-center shadow-sm">
                                                    <i class="fas fa-shield-alt text-[9px] text-slate-800/70"></i>
                                                </div>
                                                <p class="text-[7.5px] text-white/50 leading-tight max-w-[200px]">
                                                    Issued by EduLab Global Payments. Secured by 256-bit SSL encryption.
                                                </p>
                                            </div>
                                            <div id="cardBackBrandLogo" class="card-brand-logo flex items-center justify-end opacity-90 scale-75 origin-right">
                                                <span class="visa-logo">VISA</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Flip Hint Button -->
                            <button type="button" onclick="toggleCardFlip()" class="mt-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5 focus:outline-none">
                                <i class="fas fa-sync-alt text-[10px]"></i>
                                <span>@Localizer["FlipCardHint"]</span>
                            </button>
                        </div>

                        <!-- Card Input Form Fields -->
                        <div id="creditCardForm" class="mt-2 bg-gray-50/80 dark:bg-gray-700/50 p-5 rounded-2xl border border-gray-200/80 dark:border-gray-600/80 shadow-sm space-y-4">
                            <!-- Card Number Input -->
                            <div>
                                <label for="cardNumberInput" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1.5 flex items-center">
                                    <i class="fas fa-credit-card me-1.5 text-blue-600 dark:text-blue-400 text-xs"></i>
                                    <span>@Localizer["CardNumber"] *</span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="cardNumberInput" inputmode="numeric" dir="ltr" maxlength="19"
                                           class="w-full ltr:pl-11 ltr:pr-14 rtl:pl-14 rtl:pr-11 py-3.5 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-800 dark:text-white font-mono tracking-wider text-base transition duration-300"
                                           placeholder="4242 •••• •••• 4242">
                                    <i class="fas fa-credit-card absolute ltr:left-3.5 rtl:right-3.5 top-4 text-gray-400 text-sm"></i>
                                    <div id="inputBrandBadge" class="absolute ltr:right-3.5 rtl:left-3.5 top-3 flex items-center pointer-events-none text-xl text-blue-600 dark:text-blue-400">
                                        <i class="fab fa-cc-visa"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-red-500 mt-1 hidden text-start" id="cardNumberError">
                                    <i class="fas fa-exclamation-circle me-1"></i> @Localizer["CardNumberInvalid"]
                                </p>
                            </div>

                            <!-- Expiry & CVV Row -->
                            <div class="grid grid-cols-2 gap-4">
                                <!-- Expiry Date -->
                                <div>
                                    <label for="cardExpiryInput" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1.5 flex items-center">
                                        <i class="fas fa-calendar-alt me-1.5 text-blue-600 dark:text-blue-400 text-xs"></i>
                                        <span>@Localizer["ExpiryDate"] *</span>
                                    </label>
                                    <div class="relative">
                                        <input type="text" id="cardExpiryInput" inputmode="numeric" dir="ltr" maxlength="7"
                                               class="w-full ltr:pl-10 ltr:pr-4 rtl:pl-4 rtl:pr-10 py-3.5 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-800 dark:text-white font-mono tracking-wider text-base transition duration-300"
                                               placeholder="MM / YY">
                                        <i class="fas fa-calendar-alt absolute ltr:left-3.5 rtl:right-3.5 top-4 text-gray-400 text-sm"></i>
                                    </div>
                                    <p class="text-xs text-red-500 mt-1 hidden text-start" id="cardExpiryError">
                                        <i class="fas fa-exclamation-circle me-1"></i> @Localizer["CardExpiryInvalid"]
                                    </p>
                                </div>

                                <!-- CVV / CVC -->
                                <div>
                                    <label for="cardCvcInput" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1.5 flex items-center">
                                        <i class="fas fa-shield-alt me-1.5 text-blue-600 dark:text-blue-400 text-xs"></i>
                                        <span>@Localizer["CVV"] *</span>
                                    </label>
                                    <div class="relative">
                                        <input type="password" id="cardCvcInput" inputmode="numeric" dir="ltr" maxlength="4"
                                               class="w-full ltr:pl-10 ltr:pr-4 rtl:pl-4 rtl:pr-10 py-3.5 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-800 dark:text-white font-mono tracking-widest text-base transition duration-300"
                                               placeholder="•••">
                                        <i class="fas fa-lock absolute ltr:left-3.5 rtl:right-3.5 top-4 text-gray-400 text-sm"></i>
                                    </div>
                                    <p class="text-xs text-red-500 mt-1 hidden text-start" id="cardCvcError">
                                        <i class="fas fa-exclamation-circle me-1"></i> @Localizer["CardCvcInvalid"]
                                    </p>
                                </div>
                            </div>

                            <!-- Cardholder Name -->
                            <div>
                                <label for="cardHolderInput" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1.5 flex items-center">
                                    <i class="fas fa-user me-1.5 text-blue-600 dark:text-blue-400 text-xs"></i>
                                    <span>@Localizer["CardHolderName"] *</span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="cardHolderInput" dir="ltr" autocomplete="cc-name" spellcheck="false"
                                           class="w-full ltr:pl-10 ltr:pr-4 rtl:pl-4 rtl:pr-10 py-3.5 rounded-xl border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-800 dark:text-white uppercase font-medium text-base transition duration-300"
                                           placeholder="@Localizer["CardHolderNamePlaceholder"]">
                                    <i class="fas fa-user-tag absolute ltr:left-3.5 rtl:right-3.5 top-4 text-gray-400 text-sm"></i>
                                </div>
                                <p class="text-xs text-red-500 mt-1 hidden text-start" id="cardHolderError">
                                    <i class="fas fa-exclamation-circle me-1"></i> @Localizer["CardHolderRequired"]
                                </p>
                            </div>

                            <!-- General Card Error Message -->
                            <p class="text-xs text-red-500 mt-2 hidden text-start" id="cardError">
                                <i class="fas fa-exclamation-circle me-1"></i> @Localizer["CardError"]
                            </p>
                        </div>

                        <div class="pt-4 flex flex-col-reverse sm:flex-row justify-between gap-3">
                            <button type="button" id="backToCustomerInfoBtn" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 flex items-center justify-center transition duration-300 py-3 px-5 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium">
                                <i class="fas fa-arrow-left me-2 rtl:rotate-180"></i> @Localizer["YourData"]
                            </button>
                            <button type="button" id="nextToConfirmationBtn" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl transition duration-300 font-medium flex items-center justify-center shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                                @Localizer["NextConfirmation"] <i class="fas fa-arrow-left ms-2 rtl:rotate-0 ltr:rotate-180"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Section 3 - Confirmation -->
                <div id="orderConfirmationSection" class="p-4 md:p-6 hidden transition-all duration-500 opacity-0">
