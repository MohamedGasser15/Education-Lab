                        <i class="fas fa-clipboard-check me-2 text-blue-600 dark:text-blue-400"></i> @Localizer["OrderConfirmation"]
                    </h2>
                    <div class="space-y-4 md:space-y-6">
                        <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 rounded-xl p-4">
                            <div class="flex items-center">
                                <i class="fas fa-check-circle text-green-600 dark:text-green-400 text-xl me-3"></i>
                                <div class="ms-2">
                                    <h3 class="font-medium text-green-800 dark:text-green-200">@Localizer["AllReady"]</h3>
                                    <p class="text-sm text-green-600 dark:text-green-300">@Localizer["ReviewDataBefore"]</p>
                                </div>
                            </div>
                        </div>

                        <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4 bg-gray-50 dark:bg-gray-700/50">
                            <h3 class="font-medium text-gray-800 dark:text-white mb-3 flex items-center">
                                <i class="fas fa-user-tag me-1 text-blue-600 dark:text-blue-400"></i>
                                <span class="mb-1.5 ms-1">@Localizer["YourData"]</span>
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">@Localizer["Name"]</p>
                                    <p id="confirmName" class="font-medium text-gray-800 dark:text-white mt-1">-</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">@Localizer["MobileLabel"]</p>
                                    <p id="confirmPhone" class="font-medium text-gray-800 dark:text-white mt-1 ltr:text-left rtl:text-right" dir="ltr">-</p>
                                </div>
                                <div class="sm:col-span-2">
                                    <p class="text-sm text-gray-600 dark:text-gray-400">@Localizer["PostalCodeLabel"]</p>
                                    <p id="confirmPostalCode" class="font-medium text-gray-800 dark:text-white mt-1 ltr:text-left rtl:text-right" dir="ltr">-</p>
                                </div>
                            </div>
                        </div>

                        <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4 bg-gray-50 dark:bg-gray-700/50">
                            <h3 class="font-medium text-gray-800 dark:text-white mb-3 flex items-center">
                                <i class="fas fa-credit-card me-1 text-blue-600 dark:text-blue-400"></i>
                                <span class="mb-1.5 ms-1">@Localizer["PaymentMethod"]</span>
                            </h3>
                            <div id="confirmPaymentMethod" class="flex items-center">
                                <div id="confirmBrandIcon" class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl me-3">
                                    <i class="fab fa-cc-visa"></i>
                                </div>
                                <div class="ms-2">
                                    <p class="font-medium text-gray-800 dark:text-white">@Localizer["CreditOrDebitCard"]</p>
                                    <p id="confirmCardInfo" class="text-sm text-gray-600 dark:text-gray-400 font-mono" dir="ltr">VISA (•••• 4242)</p>
                                </div>
                            </div>
                            <div id="confirmFreePaymentMethod" class="hidden flex items-center">
                                <i class="fas fa-gift text-green-600 dark:text-green-400 text-xl me-3"></i>
                                <div class="ms-2">
                                    <p class="font-medium text-gray-800 dark:text-white">@Localizer["Free"]</p>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">@Localizer["FreeCheckoutDesc"]</p>
                                </div>
                            </div>
                        </div>

                        <!-- Final Amount Summary Card -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4 bg-gray-50 dark:bg-gray-700/50 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block">@Localizer["TotalAmount"]</span>
