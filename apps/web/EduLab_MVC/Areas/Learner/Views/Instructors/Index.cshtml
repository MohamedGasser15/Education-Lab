@model List<EduLab_MVC.Models.DTOs.Instructor.InstructorDTO>
@using EduLab_MVC.Models.DTOs.Instructor
@using EduLab_MVC.Common
@{
    ViewData["Title"] = "المدربون - EduLab";
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var role = Context.Request.Cookies["UserRole"];
    var showInstructorsSection = role != SD.Instructor && role != SD.Admin;
    var allSubjects = Model
        .SelectMany(i => i.InstructorSubjects)
        .Select(s => s.Trim())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

<style>
    /* ========== BASE ANIMATIONS ========== */
    @@keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
    }

    /* ========== HERO ========== */
    .hero-gradient-bg {
        background: radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(6, 182, 212, 0.1) 0%, transparent 50%), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }

    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.2rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #1e3a8a;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 40px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .dark .section-badge {
        color: #f1f5f9;
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
    }

    @@keyframes move-dots {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 40px 40px;
        }
    }

    .animated-dots-grid {
        background-image: radial-gradient(rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px);
        background-size: 40px 40px;
        animation: move-dots 4s linear infinite;
    }

    /* ========== INSTRUCTOR CARDS (Modern) ========== */
    .instructor-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #e5e7eb;
    }

    .dark .instructor-card {
        border-color: #1e293b;
    }

    .instructor-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.12);
        border-color: #bfdbfe;
    }

    .dark .instructor-card:hover {
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5);
        border-color: #1e3a5f;
    }

    .instructor-avatar {
        transition: transform 0.4s ease;
    }

    .instructor-card:hover .instructor-avatar {
        transform: scale(1.05);
    }

    .stat-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px 4px;
        transition: all 0.3s ease;
    }

    .dark .stat-item {
        background: #0f172a;
    }

    .instructor-card:hover .stat-item {
        background: #eff6ff;
    }

    .dark .instructor-card:hover .stat-item {
        background: #1e293b;
    }

    .subject-chip {
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .dark .subject-chip {
        background: #1e3a5f;
        color: #93c5fd;
    }

    .social-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f4f6;
        color: #9ca3af;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .dark .social-btn {
        background: #1f2937;
        color: #94a3b8;
    }

    .social-btn:hover {
        background: #2563eb;
        color: #fff;
        transform: translateY(-2px);
    }

    /* Filter chips */
    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid #e2e8f0;
        color: #64748b;
        transition: all 0.25s;
        cursor: pointer;
        background: transparent;
        white-space: nowrap;
    }

    .dark .filter-chip {
        color: #94a3b8;
        border-color: #334155;
    }

    .filter-chip.active {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .search-wrap:focus-within {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }

    /* Pagination */
    .page-btn {
        min-width: 2.75rem;
        height: 2.75rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #eef2f7;
        color: #64748b;
        font-weight: 700;
        transition: all 0.3s;
        cursor: pointer;
    }

    .dark .page-btn {
        background: #1e293b;
        border-color: #334155;
        color: #94a3b8;
    }

    .page-btn.active {
        background: #2563eb;
        color: white;
        border-color: #2563eb;
    }

    .page-btn:hover:not(.disabled):not(.active) {
        background: #f1f5f9;
    }

    .page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    @@media (max-width: 767px) {
        .hero-gradient-bg .container {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }

        .hero-gradient-bg h1 {
            font-size: 1.9rem !important;
            line-height: 1.25 !important;
        }

        .hero-gradient-bg p {
            font-size: 1rem !important;
        }

        section.py-20 {
            padding-top: 3.5rem;
            padding-bottom: 3.5rem;
        }
    }
</style>

<!-- Hero Section -->
<section class="relative min-h-[45vh] flex items-center justify-center overflow-hidden hero-gradient-bg">
    <div class="absolute inset-0 opacity-20 animated-dots-grid"></div>
    <div class="container mx-auto px-4 relative z-20 py-24 text-center animate-fade-in-up">
        <span class="section-badge mb-6" style="color: white !important;">
            <i class="fas fa-chalkboard-teacher ml-2" style="color: white !important;"></i> @(isArabic ? "نخبة المدربين" : "Our Instructors")
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6">
            @(isArabic ? "تعلم من " : "Learn from ") <span class="text-transparent bg-clip-text bg-gradient-to-l from-blue-400 via-cyan-400 to-blue-400">@(isArabic ? "أفضل الخبراء" : "Top Experts")</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
            @(isArabic ? "نجمع لك صفوة المتخصصين والخبراء لمساعدتك في رحلة بناء مستقبلك المهني والتقني" : "Meet the elite specialists and experts guiding you on your professional journey")
        </p>
    </div>

    <!-- Wave Decoration -->
    <div class="absolute bottom-[-1px] left-0 right-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none" class="block w-full">
            <path d="M0 120L60 105C120 90 240 60 360 52.5C480 45 600 60 720 67.5C840 75 960 75 1080 67.5C1200 60 1320 45 1380 37.5L1440 30V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white" class="dark:fill-gray-900" />
        </svg>
    </div>
</section>
<!-- Content Section -->
<section class="py-20 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">


        <!-- Search & Filter Area -->
        <div class="flex flex-col lg:flex-row justify-between items-center mb-10 gap-6">
            <div class="relative w-full lg:w-96">
                <div class="search-wrap flex items-center gap-3 w-full px-4 bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-2xl transition-all">
                    <i class="fas fa-search text-gray-400"></i>
                    <input type="text" id="instructorSearch" placeholder="@(isArabic ? "ابحث عن مدرب..." : "Search for an instructor...")" class="w-full py-3.5 bg-transparent border-none outline-none text-gray-800 dark:text-white text-sm font-medium">
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2.5 justify-center" id="filterChips">
                <button class="filter-chip active" data-filter="all">
                    <i class="fas fa-layer-group text-xs"></i> @(isArabic ? "الكل" : "All")
                </button>
                @foreach (var subject in allSubjects.Take(8))
                {
                    <button class="filter-chip" data-filter="@subject">
                        <i class="fas fa-tag text-xs"></i> @subject
                    </button>
                }
            </div>
        </div>

        <!-- Instructors Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="instructorsGrid">
            @foreach (var instructor in Model)
            {
                <div class="instructor-card group bg-white dark:bg-gray-800 rounded-3xl p-6 text-center flex flex-col"
                     data-name="@instructor.FullName"
                     data-subjects="@(string.Join(",", instructor.InstructorSubjects.Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s))))">
                    <div class="relative w-24 h-24 mx-auto mb-5">
                        <div class="absolute inset-0 bg-blue-600 rounded-full blur-2xl opacity-20 group-hover:opacity-40 transition-opacity"></div>
                        @if (!string.IsNullOrEmpty(instructor.ProfileImageUrl))
                        {
                            <img src="@instructor.ProfileImageUrl" alt="@instructor.FullName" class="instructor-avatar relative w-full h-full rounded-full object-cover border-4 border-white dark:border-gray-700 shadow-xl">
                        }
                        else
                        {
                            <img src="@Url.Content("~/img/User Logo.png")" alt="@instructor.FullName" class="instructor-avatar relative w-full h-full rounded-full object-cover border-4 border-white dark:border-gray-700 shadow-xl bg-white dark:bg-gray-700">
                        }
                        <div class="absolute -bottom-1 -right-1 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white text-xs border-2 border-white dark:border-gray-800 shadow-md">
                            <i class="fas fa-check"></i>
                        </div>
                    </div>

                    <h3 class="text-lg font-black text-gray-900 dark:text-white mb-1 truncate">@instructor.FullName</h3>
                    <p class="text-blue-600 dark:text-blue-400 font-bold text-xs mb-3 truncate">@instructor.Title</p>
                    @if (!string.IsNullOrEmpty(instructor.Location))
                    {
                        <p class="text-[11px] text-gray-400 mb-3 flex items-center justify-center gap-1">
                            <i class="fas fa-map-marker-alt text-[10px]"></i> @instructor.Location
                        </p>
                    }

                    @if (instructor.InstructorSubjects.Any())
                    {
                        <div class="flex flex-wrap gap-1.5 justify-center mb-4">
                            @foreach (var subject in instructor.InstructorSubjects.Take(3))
                            {
                                <span class="subject-chip">@subject</span>
                            }
                        </div>
                    }

                    <div class="grid grid-cols-3 gap-2 py-4 border-y border-gray-100 dark:border-white/5 mb-4">
                        <div class="stat-item">
                            <span class="block text-gray-900 dark:text-white font-black text-base tabular-nums">@(instructor.TotalStudents.ToString("N0"))</span>
                            <span class="text-[9px] text-gray-500 uppercase font-bold">@(isArabic ? "طالب" : "Students")</span>
                        </div>
                        <div class="stat-item">
                            <span class="block text-gray-900 dark:text-white font-black text-base tabular-nums">@(instructor.Rating > 0 ? instructor.Rating.ToString("0.0") : "—")</span>
                            <span class="text-[9px] text-gray-500 uppercase font-bold">@(isArabic ? "تقييم" : "Rating")</span>
                        </div>
                        <div class="stat-item">
                            <span class="block text-gray-900 dark:text-white font-black text-base tabular-nums">@instructor.TotalCourses</span>
                            <span class="text-[9px] text-gray-500 uppercase font-bold">@(isArabic ? "دورة" : "Courses")</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-center gap-2 mb-5 mt-auto">
                        @if (!string.IsNullOrEmpty(instructor.LinkedInUrl))
                        {
                            <a href="@instructor.LinkedInUrl" target="_blank" rel="noopener" class="social-btn"><i class="fab fa-linkedin-in text-sm"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(instructor.GitHubUrl))
                        {
                            <a href="@instructor.GitHubUrl" target="_blank" rel="noopener" class="social-btn"><i class="fab fa-github text-sm"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(instructor.TwitterUrl))
                        {
                            <a href="@instructor.TwitterUrl" target="_blank" rel="noopener" class="social-btn"><i class="fab fa-twitter text-sm"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(instructor.FacebookUrl))
                        {
                            <a href="@instructor.FacebookUrl" target="_blank" rel="noopener" class="social-btn"><i class="fab fa-facebook-f text-sm"></i></a>
                        }
                    </div>

                    <a asp-area="Learner" asp-controller="Profile" asp-action="InstructorProfile" asp-route-id="@instructor.Id"
                       class="block w-full py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold text-sm rounded-2xl hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-all shadow-lg">
                        @(isArabic ? "عرض الملف الكامل" : "View Profile")
                    </a>
                </div>
            }
        </div>

        <!-- Empty State -->
        <div id="noResults" class="hidden text-center py-20">
            <div class="w-24 h-24 mx-auto rounded-3xl bg-gray-100 dark:bg-white/5 flex items-center justify-center mb-5">
                <i class="fas fa-user-slash text-4xl text-gray-300 dark:text-gray-600"></i>
            </div>
            <h3 class="text-xl font-black text-gray-900 dark:text-white mb-2">@(isArabic ? "لا توجد نتائج" : "No results found")</h3>
            <p class="text-gray-500 dark:text-gray-400">@(isArabic ? "جرّب البحث بكلمة مختلفة" : "Try a different search term")</p>
        </div>

        <!-- Pagination -->
        @if (Model.Count > 8)
        {
            <div class="flex justify-center mt-14">
                <nav class="flex items-center gap-2 flex-wrap justify-center" id="paginationNav"></nav>
            </div>
        }
    </div>
</section>
        @if (showInstructorsSection)
        {
<!-- Become Instructor Section -->
<section class="py-20 bg-gray-50 dark:bg-gray-800/30">
    <div class="container mx-auto px-4">
        <div class="relative overflow-hidden rounded-[3rem] bg-gray-900 p-8 md:p-16 text-center">
            <div class="absolute inset-0 opacity-20 animated-dots-grid"></div>
            <div class="relative z-10">
                <div class="w-20 h-20 bg-blue-600/20 rounded-3xl flex items-center justify-center mx-auto mb-8">
                    <i class="fas fa-graduation-cap text-blue-500 text-3xl"></i>
                </div>
                <h2 class="text-2xl md:text-3xl font-black text-white mb-4">@(isArabic ? "هل ترغب في الانضمام لفريقنا؟" : "Want to join our team?")</h2>
                <p class="text-gray-400 text-base md:text-lg mb-10 max-w-xl mx-auto">@(isArabic ? "شارك خبرتك مع آلاف الطلاب حول العالم وابدأ رحلتك التدريبية معنا اليوم." : "Share your expertise with thousands of students and start your teaching journey today.")</p>
                <a asp-area="Learner" asp-controller="InstructorApplication" asp-action="Apply" class="px-10 py-4 bg-blue-600 text-white font-bold rounded-2xl hover:bg-blue-500 transition-all shadow-xl shadow-blue-600/30">
                    @(isArabic ? "قدم طلب الانضمام الآن" : "Apply Now")
                </a>
            </div>
        </div>
    </div>
</section>
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const cards = Array.from(document.querySelectorAll('#instructorsGrid .instructor-card'));
        const searchInput = document.getElementById('instructorSearch');
        const chips = document.querySelectorAll('#filterChips .filter-chip');
        const noResults = document.getElementById('noResults');
        const paginationNav = document.getElementById('paginationNav');
        const perPage = 8;

        let activeFilter = 'all';
        let currentPage = 1;

        function filteredList() {
            const q = searchInput.value.trim().toLowerCase();
            return cards.filter(card => {
                const cardSubjects = card.dataset.subjects.split(',').map(s => s.trim()).filter(Boolean);
                const matchesFilter = activeFilter === 'all' || cardSubjects.includes(activeFilter);
                const matchesSearch = !q || card.dataset.name.toLowerCase().includes(q) || card.dataset.subjects.toLowerCase().includes(q);
                return matchesFilter && matchesSearch;
            });
        }

        function render() {
            const list = filteredList();
            const totalPages = Math.max(1, Math.ceil(list.length / perPage));
            if (currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * perPage;
            const visible = list.slice(start, start + perPage);

            cards.forEach(c => c.style.display = 'none');
            visible.forEach(c => c.style.display = '');

            noResults.classList.toggle('hidden', visible.length > 0);

            if (paginationNav) {
                paginationNav.innerHTML = '';
                if (list.length > perPage) {
                    const prev = document.createElement('button');
                    prev.className = 'page-btn' + (currentPage === 1 ? ' disabled' : '');
                    prev.innerHTML = '<i class="fas fa-chevron-right text-xs"></i>';
                    prev.onclick = () => { if (currentPage > 1) { currentPage--; render(); } };
                    paginationNav.appendChild(prev);

                    for (let i = 1; i <= totalPages; i++) {
                        const btn = document.createElement('button');
                        btn.className = 'page-btn' + (i === currentPage ? ' active' : '');
                        btn.textContent = i;
                        btn.onclick = () => { currentPage = i; render(); };
                        paginationNav.appendChild(btn);
                    }

                    const next = document.createElement('button');
                    next.className = 'page-btn' + (currentPage === totalPages ? ' disabled' : '');
                    next.innerHTML = '<i class="fas fa-chevron-left text-xs"></i>';
                    next.onclick = () => { if (currentPage < totalPages) { currentPage++; render(); } };
                    paginationNav.appendChild(next);
                }
            }
        }

        searchInput.addEventListener('input', () => { currentPage = 1; render(); });

        chips.forEach(chip => {
            chip.addEventListener('click', function() {
                chips.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                activeFilter = this.dataset.filter.trim();
                currentPage = 1;
                render();
            });
        });

        render();
    });
</script>
